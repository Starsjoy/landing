---
import Layout from '../../layouts/Layout.astro';
import NavbarEn from '../../components/NavbarEn.astro';
import FooterEn from '../../components/FooterEn.astro';
import Reviews from '../../components/Reviews.astro';
import { hreflangsFor } from '../../lib/i18n';

const title = "Buy Telegram Stars in Uzbekistan — Pay in Som with Uzcard | StarsJoy";
const description = "Telegram Stars price in Uzbekistan: 240 UZS per star, flat rate. 50 Stars = 12,000 UZS, 1,000 Stars = 240,000 UZS. Pay with Uzcard, Humo or Click in Uzbek som — no Visa card and no TON wallet needed.";

// Flat rate — every pack uses the same 240 UZS/star, no volume discount.
const RATE = 240;
const packs = [50, 100, 250, 500, 1000, 2500, 5000];
const fmt = (n: number) => n.toLocaleString('en-US');

const faqs = [
  {
    q: "How much does 1 Telegram Star cost in Uzbekistan?",
    a: "Through StarsJoy the rate is a flat 240 UZS per star for every pack size — there is no volume discount and no hidden fee. So 50 Stars cost 12,000 UZS, 100 Stars cost 24,000 UZS and 1,000 Stars cost 240,000 UZS."
  },
  {
    q: "Can I buy Telegram Stars without a Visa card or a TON wallet?",
    a: "Yes. Telegram's own in-app purchase requires an international card, and Fragment requires TON cryptocurrency and a crypto wallet. StarsJoy needs neither: you pay in Uzbek som from an Uzcard or Humo card through Click, Payme, Uzum or your bank's own app."
  },
  {
    q: "How long does it take to receive the Stars?",
    a: "Usually about 10 seconds after your payment is confirmed. The Stars are delivered through Telegram's official Fragment infrastructure and land directly in your account balance, which you can check under Settings → My Stars."
  },
  {
    q: "Do you need my Telegram password?",
    a: "No. Only your Telegram username. Stars are sent through Telegram's official gift mechanism, which never requires access to your account. Any service that asks for your password or SMS login code is trying to steal your account."
  },
  {
    q: "What can I actually spend Telegram Stars on?",
    a: "Paid posts in channels, paid reactions, tipping content creators, unlocking features inside bots and Mini Apps, buying Telegram Gifts, and Telegram Ads. Stars are Telegram's internal currency and work anywhere inside the app that accepts them."
  },
  {
    q: "Can I buy an amount that is not in the table?",
    a: "Yes. Enter any amount between 50 and 100,000 in the bot and the price is calculated at the same 240 UZS per star rate."
  },
  {
    q: "Can I convert Telegram Stars back into money?",
    a: "Not as a regular user. Only channel owners, bot developers and creators who earn Stars can withdraw them, and Telegram routes that through Fragment in TON with a 21-day holding period. Stars you buy are for spending inside Telegram, not for cashing out."
  },
  {
    q: "Do Telegram Stars expire?",
    a: "No. Stars sitting in your balance do not expire and do not lose value over time. They stay in your account until you spend them."
  },
  {
    q: "What if the Stars never arrive?",
    a: "You get a 100% refund. Send your payment receipt to support through the bot. StarsJoy has completed more than 8,000 orders and publishes dated customer reviews openly."
  },
  {
    q: "I am a foreigner in Uzbekistan — can I use this?",
    a: "Yes, provided you hold an Uzcard or Humo card issued in Uzbekistan and have a Telegram account. No registration, residence permit or document is required."
  }
];
---

<Layout
  title={title}
  description={description}
  canonical="https://starsjoy.uz/en/stars"
  keywords="buy telegram stars uzbekistan, telegram stars price uzbekistan, telegram stars to uzs, telegram stars uzcard, telegram stars without visa, telegram stars in som"
  lang="en"
  hreflangs={hreflangsFor('/stars')}
>
  <NavbarEn />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Telegram Stars",
    "description": description,
    "brand": { "@type": "Brand", "name": "StarsJoy" },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "UZS",
      "lowPrice": String(50 * RATE),
      "highPrice": String(5000 * RATE),
      "availability": "https://schema.org/InStock",
      "offerCount": String(packs.length),
      "offers": packs.map((n) => ({
        "@type": "Offer",
        "name": `${fmt(n)} Telegram Stars`,
        "price": String(n * RATE),
        "priceCurrency": "UZS",
        "availability": "https://schema.org/InStock"
      }))
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "en-US",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://starsjoy.uz/en" },
      { "@type": "ListItem", "position": 2, "name": "Buy Telegram Stars", "item": "https://starsjoy.uz/en/stars" }
    ]
  })} />

  <section class="stars-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/en">Home</a>
        <span>/</span>
        <span>Telegram Stars</span>
      </nav>
      <div class="stars-hero-inner fade-in">
        <div class="stars-hero-content">
          <h1 class="stars-title">Buy Telegram Stars in Uzbekistan</h1>
          <p class="stars-desc">
            A flat 240 UZS per star, paid in Uzbek som with an Uzcard or Humo card. No international card, no TON wallet, no crypto exchange — Stars land in your Telegram balance in about 10 seconds.
          </p>
          <div class="stars-features">
            <div class="stars-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l2.5 5 5.5.8-4 3.9 1 5.4L10 14.4l-4.9 2.7 1-5.4-4-3.9 5.5-.8L10 2z" fill="#FBBF24" stroke="#D97706" stroke-width="1"/></svg>
              <span>Delivered in ~10 seconds</span>
            </div>
            <div class="stars-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="9" rx="2" stroke="#7C3AED" stroke-width="1.5"/><path d="M7.5 9V7a2.5 2.5 0 1 1 5 0v2" stroke="#7C3AED" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>100% refund guarantee</span>
            </div>
            <div class="stars-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="#10B981" stroke-width="1.5"/><path d="M10 7v6M7 10h6" stroke="#10B981" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Flat rate, no hidden fees</span>
            </div>
          </div>
          <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">
            &#9889; Buy Telegram Stars
          </a>
        </div>
        <div class="stars-hero-visual">
          <div class="stars-icon-big">
            <svg width="80" height="80" viewBox="0 0 52 52" fill="none">
              <defs>
                <linearGradient id="stG" x1="6" y1="6" x2="46" y2="46">
                  <stop offset="0%" stop-color="#FFD60A"/>
                  <stop offset="50%" stop-color="#FFAE00"/>
                  <stop offset="100%" stop-color="#FF9500"/>
                </linearGradient>
              </defs>
              <path d="M26 4l6.2 12.5L45 18.8l-9.5 9.3 2.2 13.1L26 34.8l-11.7 6.4 2.2-13.1L7 18.8l12.8-2.3L26 4z" fill="url(#stG)"/>
              <path d="M26 4l6.2 12.5L45 18.8l-9.5 9.3 2.2 13.1L26 34.8V4z" fill="#FFE066" opacity="0.35"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="stars-pricing">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Pricing</span>
        <h2 class="section-title">Telegram Stars price in Uzbek som</h2>
        <p class="section-subtitle">One flat rate for every pack — {RATE} UZS per star, no volume tiers</p>
      </div>
      <div class="pricing-table-wrap fade-in">
        <table class="pricing-table">
          <thead>
            <tr><th>Stars</th><th>Price</th></tr>
          </thead>
          <tbody>
            {packs.map((n) => (
              <tr class={n === 1000 ? 'pricing-highlight' : undefined}>
                <td>
                  {fmt(n)} ⭐
                  {n === 1000 && <span class="pricing-badge">Most popular</span>}
                </td>
                <td>{fmt(n * RATE)} UZS</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pricing-note fade-in">
        Need a different amount? Enter any number from 50 to 100,000 in the bot — the price is
        calculated at the same {RATE} UZS per star. Prices are set in som, so there is no exchange-rate
        surprise between the moment you order and the moment you pay.
      </p>
      <div class="pricing-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#9889; Buy Telegram Stars</a>
      </div>
    </div>
  </section>

  <!-- What Stars are for -->
  <section class="stars-why">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Telegram Stars</span>
        <h2 class="section-title">What are Telegram Stars for?</h2>
        <p class="section-subtitle">Stars are Telegram's internal currency — here is where they are actually spent</p>
      </div>
      <div class="why-grid">
        <div class="why-card fade-in">
          <div class="why-icon wi-content">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="4" y="4" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/><path d="M10 12h8M10 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>Paid posts</h3>
          <p>Unlock paid posts and premium content inside channels that charge in Stars</p>
        </div>
        <div class="why-card fade-in">
          <div class="why-icon wi-bot">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="3" width="18" height="22" rx="4" stroke="currentColor" stroke-width="2"/><circle cx="14" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M14 9V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="11" y1="20" x2="17" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>Bots and Mini Apps</h3>
          <p>Pay for paid features and digital goods inside bots and Telegram Mini Apps</p>
        </div>
        <div class="why-card fade-in">
          <div class="why-icon wi-support">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4l3 6 6.6 1-4.8 4.6 1.1 6.6L14 19l-5.9 3.2 1.1-6.6L4.4 11l6.6-1L14 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </div>
          <h3>Tips and paid reactions</h3>
          <p>Support creators directly with paid reactions or tips on their posts</p>
        </div>
        <div class="why-card fade-in">
          <div class="why-icon wi-gift">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="13" width="18" height="11" rx="3" stroke="currentColor" stroke-width="2"/><rect x="7" y="8" width="14" height="6" rx="2" stroke="currentColor" stroke-width="2"/><rect x="12.5" y="8" width="3" height="16" rx="1" fill="currentColor" opacity="0.2"/></svg>
          </div>
          <h3>Telegram Gifts</h3>
          <p>Buy and send Telegram Gifts, including collectible ones, paid for in Stars</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How to buy -->
  <section class="stars-how">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">How it works</span>
        <h2 class="section-title">How to buy Telegram Stars</h2>
        <p class="section-subtitle">Three steps — Stars in your balance in about 10 seconds</p>
      </div>
      <div class="how-steps">
        <div class="how-step fade-in">
          <div class="how-step-num">1</div>
          <h3>Open the bot</h3>
          <p>Open <strong>@starsjoybot</strong> in Telegram and choose "Stars"</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">2</div>
          <h3>Choose the amount</h3>
          <p>Pick a pack or type any amount, then enter the username the Stars are for</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">3</div>
          <h3>Pay and receive</h3>
          <p>Transfer the exact amount from Click, Payme or your bank app — Stars arrive in about 10 seconds</p>
        </div>
      </div>
      <div class="how-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#9889; Start now</a>
        <p class="how-guide-note"><a href="/en/how-to-buy">See every step with screenshots &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="stars-faq">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-subtitle">Telegram Stars in Uzbekistan — the questions people actually ask</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item fade-in">
            <button class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Reviews lang="en" />

  <!-- CTA -->
  <section class="stars-cta">
    <div class="container">
      <div class="stars-cta-box fade-in">
        <h2>Ready to buy Telegram Stars?</h2>
        <p>240 UZS per star, paid in som with Uzcard or Humo</p>
        <a href="https://telegram.me/starsjoybot" class="btn-white" target="_blank">&#9889; Buy Telegram Stars</a>
      </div>
    </div>
  </section>

  <FooterEn />
</Layout>

<!-- FAQ Script -->
<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const isActive = item.classList.contains('active');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('active');
        (i.querySelector('.faq-answer') as HTMLElement).style.maxHeight = '';
      });
      if (!isActive) {
        item.classList.add('active');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });
</script>

<style>
  /* ===== HERO ===== */
  .stars-hero {
    padding: 120px 24px 80px;
    background: linear-gradient(180deg, #FFFBEB 0%, #FFFFFF 100%);
    position: relative;
    overflow: hidden;
  }
  .stars-hero::before {
    content: '';
    position: absolute;
    top: -150px; right: -150px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(255, 174, 0, 0.08), transparent 70%);
    pointer-events: none;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 32px;
  }
  .breadcrumb a { color: var(--primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .stars-hero-inner {
    display: flex;
    align-items: center;
    gap: 60px;
  }
  .stars-hero-content { flex: 1; }
  .stars-hero-visual {
    flex: 0 0 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stars-title {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--text);
  }
  .stars-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 540px;
  }

  .stars-features {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .stars-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
  }

  .stars-icon-big {
    width: 160px;
    height: 160px;
    background: linear-gradient(135deg, #FFF8E1, #FFE082);
    border-radius: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 48px rgba(255, 174, 0, 0.2);
  }

  /* ===== PRICING ===== */
  .stars-pricing { padding: 60px 24px; }
  .pricing-table-wrap {
    max-width: 520px;
    margin: 0 auto 24px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
  }
  .pricing-table { width: 100%; border-collapse: collapse; background: #fff; }
  .pricing-table thead th {
    background: var(--gradient);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    text-align: left;
    padding: 16px 28px;
    letter-spacing: 0.3px;
  }
  .pricing-table thead th:last-child { text-align: right; }
  .pricing-table tbody tr { transition: background 0.2s; }
  .pricing-table tbody tr:hover { background: var(--bg-alt); }
  .pricing-table tbody tr:last-child td { border-bottom: none; }
  .pricing-table td {
    padding: 16px 28px;
    color: var(--text);
    font-size: 1rem;
    border-bottom: 1px solid var(--border-light);
  }
  .pricing-table td:first-child { font-weight: 600; }
  .pricing-table td:last-child { font-weight: 800; color: var(--primary); text-align: right; }
  .pricing-table tr.pricing-highlight td { background: rgba(124, 58, 237, 0.05); }
  .pricing-badge {
    display: inline-block;
    margin-left: 8px;
    padding: 3px 10px;
    background: var(--gradient);
    color: #fff;
    border-radius: 50px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    vertical-align: middle;
  }
  .pricing-note {
    text-align: center;
    max-width: 480px;
    margin: 0 auto 24px;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .pricing-cta { text-align: center; }

  /* ===== WHY ===== */
  .stars-why { background: var(--bg-alt); }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .why-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 24px;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .why-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--text);
  }
  .why-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .why-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wi-content { background: rgba(255, 174, 0, 0.1); color: #D97706; }
  .wi-bot { background: rgba(124, 58, 237, 0.08); color: #7C3AED; }
  .wi-support { background: rgba(37, 99, 235, 0.08); color: #2563EB; }
  .wi-gift { background: rgba(16, 185, 129, 0.08); color: #10B981; }

  /* ===== HOW ===== */
  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 40px;
  }
  .how-step {
    text-align: center;
    padding: 32px 24px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .how-step h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--text);
  }
  .how-step p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .how-step-num {
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
    background: var(--gradient);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    color: #fff;
  }
  .how-cta { text-align: center; }

  /* ===== FAQ ===== */
  .stars-faq { background: var(--bg-alt); }
  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item.active {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08);
  }
  .faq-question {
    width: 100%;
    padding: 20px 24px;
    background: none;
    border: none;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-family: inherit;
  }
  .faq-question:hover { color: var(--primary); }
  .faq-toggle {
    width: 28px; height: 28px; min-width: 28px;
    border-radius: 8px;
    background: rgba(124, 58, 237, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--primary);
    transition: transform 0.3s;
  }
  .faq-item.active .faq-toggle { transform: rotate(45deg); }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-answer-inner {
    padding: 0 24px 20px;
    color: var(--text-muted);
    font-size: 0.95rem;
