const faqs = [
  {
    q: "Is Telegram Business a separate paid subscription?",
    a: "No. Telegram Business is a set of features inside Telegram Premium, not a product you buy separately. One active Premium subscription unlocks both the consumer features and the business ones."
  },
  {
    q: "So do I need to pay twice?",
    a: "No. There is one price. If you already have Premium, the business features are already available to you — turn them on under Settings → Telegram Business."
  },
  {
    q: "Do my customers need Premium to message my business profile?",
    a: "No. Everything customer-facing works outward: they see your opening hours, your address on the map, your greeting message and your quick replies without any subscription of their own."
  },
  {
    q: "Can I run this on a personal account or do I need a separate one?",
    a: "Either works. Business features apply to whichever account holds the subscription. Many small businesses in Uzbekistan run them on a dedicated account so that personal chats stay separate, but that is organisation, not a requirement."
  },
  {
    q: "What happens to business features if Premium expires?",
    a: "They switch off — greeting messages, away messages, quick replies and opening hours stop working. Nothing is deleted; the settings return the moment you renew."
  },
  {
    q: "Is this the same as a Telegram bot?",
    a: "No. A bot is a separate automated account you build. Business features run on your own account, with your own name and chats — no development needed. You can link a bot to a business account, but that is optional."
  }
];
