---
import Layout from '../../layouts/Layout.astro';
import NavbarEn from '../../components/NavbarEn.astro';
import FooterEn from '../../components/FooterEn.astro';
import Reviews from '../../components/Reviews.astro';
import { getApprovedReviews, aggregateOf } from '../../lib/reviews';
import { hreflangsFor } from '../../lib/i18n';

const title = "Buy Telegram Premium in Uzbekistan — Pay with Uzcard or Humo | StarsJoy";
const description = "Telegram Premium price in Uzbekistan: 3 months 172,000 UZS, 6 months 232,000 UZS, 12 months 422,000 UZS. Pay in Uzbek som with Uzcard, Humo or Click — no Visa or Mastercard needed. Delivered in about 10 seconds.";

const faqs = [
  {
    q: "Can I buy Telegram Premium in Uzbekistan without a Visa or Mastercard?",
    a: "Yes. This is the main reason StarsJoy exists. Telegram's official checkout (App Store, Google Play, or @PremiumBot) requires an international card, which most Uzbek bank cards are not. StarsJoy accepts Uzcard and Humo directly, in Uzbek som, with no currency conversion and no foreign card of any kind."
  },
  {
    q: "How much does Telegram Premium cost in Uzbekistan?",
    a: "Through StarsJoy: 3 months — 172,000 UZS, 6 months — 232,000 UZS, 12 months — 422,000 UZS. The longer the term, the lower the effective monthly price: the 12-month plan works out to roughly 35,200 UZS per month versus about 57,300 UZS on the 3-month plan."
  },
  {
    q: "Is there a 1-month Telegram Premium plan?",
    a: "Not through StarsJoy. Telegram's Gift Premium mechanism, which is what resellers use, has a minimum term of 3 months. A 1-month subscription does exist in Telegram itself, but only the account owner can enable it from inside the app using an international card."
  },
  {
    q: "How long does delivery take?",
    a: "Usually about 10 seconds after your payment is confirmed. Under heavy load it can take a few minutes, but the order is never lost. You will receive a 'Premium gift' notification from Telegram itself."
  },
  {
    q: "Do you need my Telegram password or login code?",
    a: "No, and you should never give those to anyone. StarsJoy only needs your Telegram username. The subscription is attached through Telegram's official Gift Premium mechanism, which does not require access to your account. If any service asks for your password or SMS code, that is a scam."
  },
  {
    q: "Can I gift Telegram Premium to someone else?",
    a: "Yes. In the bot, choose 'Gift' and enter the recipient's Telegram username. The price is the same as the corresponding Premium plan and the recipient pays nothing — they simply receive a notification from Telegram."
  },
  {
    q: "What happens if Premium never arrives?",
    a: "You get a 100% refund. Contact support through the bot with your payment receipt and the issue is resolved quickly. StarsJoy has completed more than 8,000 orders and publishes dated customer reviews openly."
  },
  {
    q: "Is StarsJoy an official Telegram partner?",
    a: "No. StarsJoy is an independent reseller. As stated in clause 2.3 of its public offer, the service is delivered through Telegram's official API and the Fragment infrastructure — the subscription is attached to your real Telegram account through the official route, not through any workaround."
  },
  {
    q: "Can I get Telegram Premium for free?",
    a: "No. Telegram Premium is a paid subscription and any site promising it for free is a scam. StarsJoy does have one honest way to reduce the cost: a 5% referral bonus when someone buys through your personal link, plus the lower effective monthly rate on longer plans."
  },
  {
    q: "I am a foreigner living in or visiting Uzbekistan. Can I use this?",
    a: "Yes, as long as you have an Uzcard or Humo card issued in Uzbekistan and a Telegram account. No local registration, residence permit or document is required — you only need the card and your Telegram username."
  }
];

// Monthly price is derived from the published plan prices (rounded)
const plans = [
  { months: 3,  price: 172000, best: false },
  { months: 6,  price: 232000, best: false },
  { months: 12, price: 422000, best: true  },
];
const fmt = (n: number) => n.toLocaleString('en-US');
const perMonth = (p: { months: number; price: number }) =>
  fmt(Math.round(p.price / p.months / 100) * 100);
const monthlySaving = fmt(Math.round((172000 / 3 - 422000 / 12) / 1000) * 1000);

const reviews = await getApprovedReviews('premium');
const agg = aggregateOf(reviews);

const productSchema: any = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Telegram Premium subscription",
  "description": description,
  "brand": { "@type": "Brand", "name": "StarsJoy" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "UZS",
    "lowPrice": "172000",
    "highPrice": "422000",
    "availability": "https://schema.org/InStock",
    "offerCount": "3"
  }
};
// aggregateRating/review ONLY when real approved reviews exist (Google's rule)
if (agg.reviewCount > 0) {
  productSchema.aggregateRating = {
    "@type": "AggregateRating",
    "ratingValue": String(agg.ratingValue),
    "reviewCount": String(agg.reviewCount),
    "bestRating": "5"
  };
  productSchema.review = reviews.slice(0, 10).map((r) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.author_name },
    "reviewRating": { "@type": "Rating", "ratingValue": String(r.rating), "bestRating": "5" },
    "reviewBody": r.body,
    "datePublished": r.created_at ? new Date(r.created_at).toISOString().slice(0, 10) : ""
  }));
}
---

<Layout
  title={title}
  description={description}
  canonical="https://starsjoy.uz/en/premium"
  keywords="buy telegram premium uzbekistan, telegram premium price uzbekistan, telegram premium uzcard, telegram premium humo, telegram premium without visa, telegram premium in som"
  lang="en"
  hreflangs={hreflangsFor('/premium')}
>
  <NavbarEn />

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "en-US",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://starsjoy.uz/en" },
      { "@type": "ListItem", "position": 2, "name": "Buy Telegram Premium", "item": "https://starsjoy.uz/en/premium" }
    ]
  })} />

  <!-- Hero -->
  <section class="prem-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/en">Home</a>
        <span>/</span>
        <span>Telegram Premium</span>
      </nav>
      <div class="prem-hero-inner fade-in">
        <div class="prem-hero-content">
          <h1 class="prem-title">Buy Telegram Premium in Uzbekistan</h1>
          <p class="prem-desc">
            Pay in Uzbek som with an Uzcard or Humo card — no Visa, no Mastercard, no currency conversion. Your subscription is activated in about 10 seconds through Telegram's official Gift Premium mechanism.
          </p>
          <div class="prem-features">
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L5 10l5 10 5-10L10 3z" stroke="#7C3AED" stroke-width="1.5" stroke-linejoin="round" fill="#7C3AED" opacity="0.15"/></svg>
              <span>Active in ~10 seconds</span>
            </div>
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="9" rx="2" stroke="#7C3AED" stroke-width="1.5"/><path d="M7.5 9V7a2.5 2.5 0 1 1 5 0v2" stroke="#7C3AED" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Uzcard / Humo / Click</span>
            </div>
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="#10B981" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>100% refund guarantee</span>
            </div>
          </div>
          <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">
            &#9889; Buy Telegram Premium
          </a>
        </div>
        <div class="prem-hero-visual">
          <div class="prem-icon-big">
            <svg width="80" height="80" viewBox="0 0 52 52" fill="none">
              <defs>
                <linearGradient id="prG" x1="8" y1="6" x2="44" y2="46">
                  <stop offset="0%" stop-color="#6B93FF"/>
                  <stop offset="50%" stop-color="#976FFF"/>
                  <stop offset="100%" stop-color="#E46ACE"/>
                </linearGradient>
              </defs>
              <path d="M26 5L9 21l17 26 17-26L26 5z" fill="url(#prG)"/>
              <path d="M26 5l17 16L26 47V5z" fill="#A78BFA" opacity="0.3"/>
              <path d="M15 21l11-11 11 11" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="prem-pricing">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Pricing</span>
        <h2 class="section-title">Telegram Premium price in Uzbekistan</h2>
        <p class="section-subtitle">All prices in Uzbek som (UZS). The longer the plan, the lower the monthly cost</p>
      </div>
      <div class="pricing-table-wrap fade-in">
        <table class="pricing-table">
          <thead>
            <tr><th>Plan</th><th>Per month</th><th>Total price</th></tr>
          </thead>
          <tbody>
            {plans.map((p) => (
              <tr class={p.best ? 'pricing-highlight' : undefined}>
                <td>
                  {p.months} months
                  {p.best && <span class="pricing-badge">Best value</span>}
                </td>
                <td class="pricing-permonth">~{perMonth(p)} UZS</td>
                <td>{fmt(p.price)} UZS</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pricing-note fade-in">
        The price includes every payment method (Uzcard, Humo, Click) — there are no hidden fees and no
        currency conversion. On the 12-month plan a month costs roughly {monthlySaving} UZS less than on
        the 3-month plan. There is no 1-month plan: Telegram's Gift Premium mechanism starts at 3 months.
      </p>
      <div class="pricing-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#9889; Buy Telegram Premium</a>
      </div>
    </div>
  </section>

  <!-- Payment -->
  <section class="prem-pay">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Payment</span>
        <h2 class="section-title">Why you cannot just buy it inside Telegram</h2>
        <p class="section-subtitle">The specific problem StarsJoy solves for people in Uzbekistan</p>
      </div>
      <div class="pay-grid">
        <div class="pay-card fade-in">
          <h3>The official route needs a foreign card</h3>
          <p>
            Buying Premium through the App Store, Google Play or Telegram's own
            <strong>@PremiumBot</strong> requires an international card. Uzcard and Humo — the two
            card systems almost everyone in Uzbekistan actually holds — are not accepted, and
            @PremiumBot frequently fails from Uzbekistan altogether.
          </p>
        </div>
        <div class="pay-card fade-in">
          <h3>Pay from any app you already use</h3>
          <p>
            You can send the transfer from Click, Payme, Uzum or your own bank's app — it makes no
            difference. What matters is that the money reaches the card shown in the order window,
            for <strong>exactly the amount shown</strong>.
          </p>
        </div>
        <div class="pay-card fade-in">
          <h3>No registration, no password</h3>
          <p>
            There is no account to create, no document to upload and no password to hand over. A
            Telegram account and a local card are enough. The whole process usually takes 2–3 minutes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="prem-benefits">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Features</span>
        <h2 class="section-title">What Telegram Premium gives you</h2>
        <p class="section-subtitle">Everything the subscription unlocks</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-file">
