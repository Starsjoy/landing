---
import Layout from '../../layouts/Layout.astro';
import NavbarEn from '../../components/NavbarEn.astro';
import FooterEn from '../../components/FooterEn.astro';
import Reviews from '../../components/Reviews.astro';
import { hreflangsFor } from '../../lib/i18n';

const title = "Telegram Gifts — Send Premium or a Gift in Uzbekistan | StarsJoy";
const description = "Send Telegram Gifts and gift Telegram Premium from Uzbekistan. The recipient pays nothing and you only need their username. Paid in Uzbek som with Uzcard or Humo, delivered in about 10 seconds.";

const plans = [
  { months: 3,  price: 172000, best: false },
  { months: 6,  price: 232000, best: false },
  { months: 12, price: 422000, best: true  },
];
const fmt = (n: number) => n.toLocaleString('en-US');

const faqs = [
  {
    q: "What do I need to send a Telegram Gift?",
    a: "The recipient's Telegram username, and nothing else. No phone number, no password, no login code. Telegram delivers the gift through its own official mechanism and notifies the recipient directly."
  },
  {
    q: "Does the recipient pay anything?",
    a: "No. A gift costs the recipient nothing — they confirm nothing, enter no card and hand over no account details. They simply receive a notification from Telegram."
  },
  {
    q: "What is the difference between a Telegram Gift and gifting Premium?",
    a: "Gifting Premium sends someone a subscription — 3, 6 or 12 months of the full Premium feature set. A Telegram Gift is a collectible item bought with Stars that appears on the recipient's profile; they can keep it on display or convert it back into Stars."
  },
  {
    q: "What if the recipient already has Premium?",
    a: "The gifted time is added to their existing subscription rather than replacing it. Nothing is wasted."
  },
  {
    q: "Can I gift Premium for 1 month?",
    a: "No. Telegram's Gift Premium mechanism starts at 3 months, so 172,000 UZS is the smallest Premium gift. The 1-month subscription exists inside Telegram but only the account owner can enable it with an international card."
  },
  {
    q: "What if I type the username wrong?",
    a: "The gift goes to whatever username you entered, and if that account exists it cannot be reversed. Copy and paste rather than typing from memory, and open the profile to check it is the right person before paying."
  },
  {
    q: "Can I add a message to the gift?",
    a: "Yes, you can attach a short message. Telegram shows the recipient who the sender is — gifting is not anonymous by design."
  },
  {
    q: "What if the gift is not delivered?",
    a: "You get a 100% refund. Contact support through the bot with your payment receipt."
  }
];
---

<Layout
  title={title}
  description={description}
  canonical="https://starsjoy.uz/en/gifts"
  keywords="telegram gifts uzbekistan, gift telegram premium, send telegram gift, telegram gift with uzcard, telegram collectible gifts"
  lang="en"
  hreflangs={hreflangsFor('/gifts')}
>
  <NavbarEn />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Telegram Gifts and gifted Telegram Premium",
    "description": description,
    "brand": { "@type": "Brand", "name": "StarsJoy" },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "UZS",
      "lowPrice": "172000",
      "highPrice": "422000",
      "availability": "https://schema.org/InStock",
      "offerCount": "3"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "en-US",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://starsjoy.uz/en" },
      { "@type": "ListItem", "position": 2, "name": "Telegram Gifts", "item": "https://starsjoy.uz/en/gifts" }
    ]
  })} />

  <section class="gift-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/en">Home</a>
        <span>/</span>
        <span>Telegram Gifts</span>
      </nav>
      <div class="gift-hero-inner fade-in">
        <div class="gift-hero-content">
          <h1 class="gift-title">Send a Telegram Gift from Uzbekistan</h1>
          <p class="gift-desc">
            Gift Telegram Premium or send a collectible Telegram Gift. You need their username — nothing else — and the recipient pays nothing. Paid in Uzbek som with Uzcard or Humo, delivered in about 10 seconds.
          </p>
          <div class="gift-features">
            <div class="gift-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="9" width="14" height="8" rx="2" stroke="#C850C0" stroke-width="1.5"/><rect x="4.5" y="5.5" width="11" height="4" rx="1.5" stroke="#C850C0" stroke-width="1.5"/><rect x="8.5" y="5.5" width="3" height="11.5" fill="#C850C0" opacity="0.25"/></svg>
              <span>Recipient pays nothing</span>
            </div>
            <div class="gift-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L5 10l5 10 5-10L10 3z" stroke="#7C3AED" stroke-width="1.5" stroke-linejoin="round" fill="#7C3AED" opacity="0.15"/></svg>
              <span>Delivered in ~10 seconds</span>
            </div>
            <div class="gift-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="#10B981" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>Username only — no password</span>
            </div>
          </div>
          <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">
            &#127873; Send a gift
          </a>
        </div>
        <div class="gift-hero-visual">
          <div class="gift-icon-big">
            <svg width="80" height="80" viewBox="0 0 52 52" fill="none">
              <defs>
                <linearGradient id="gfG" x1="6" y1="10" x2="46" y2="48">
                  <stop offset="0%" stop-color="#FF6B9D"/>
                  <stop offset="50%" stop-color="#C850C0"/>
                  <stop offset="100%" stop-color="#8B5CF6"/>
                </linearGradient>
              </defs>
              <rect x="8" y="22" width="36" height="24" rx="4" fill="url(#gfG)"/>
              <rect x="11" y="14" width="30" height="9" rx="3" fill="url(#gfG)" opacity="0.75"/>
              <rect x="22" y="14" width="8" height="32" rx="2" fill="#fff" opacity="0.28"/>
              <path d="M26 14c-3-7-13-7-13 0s13 8 13 8 13-1 13-8-10-7-13 0z" fill="#fff" opacity="0.18"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two kinds of gift -->
  <section class="gift-why">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Two options</span>
        <h2 class="section-title">Gifted Premium, or a collectible gift</h2>
        <p class="section-subtitle">They are different things — worth knowing which one you mean</p>
      </div>
      <div class="why-grid">
        <div class="why-card fade-in">
          <div class="why-icon wi-unique">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4L6 14l8 12 8-12-8-10z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </div>
          <h3>Gifted Telegram Premium</h3>
          <p>A full subscription for 3, 6 or 12 months. They get 4 GB uploads, no channel ads, custom emoji and everything else Premium unlocks — and pay nothing for it.</p>
        </div>
        <div class="why-card fade-in">
          <div class="why-icon wi-instant">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="13" width="18" height="11" rx="3" stroke="currentColor" stroke-width="2"/><rect x="7" y="8" width="14" height="6" rx="2" stroke="currentColor" stroke-width="2"/><rect x="12.5" y="8" width="3" height="16" rx="1" fill="currentColor" opacity="0.2"/></svg>
          </div>
          <h3>A Telegram Gift</h3>
          <p>A collectible item bought with Stars that appears on their profile. Limited-edition gifts have a fixed supply and can be upgraded into NFT collectibles; the recipient can also convert one back into Stars.</p>
        </div>
        <div class="why-card fade-in">
          <div class="why-icon wi-personal">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4l3 6 6.6 1-4.8 4.6 1.1 6.6L14 19l-5.9 3.2 1.1-6.6L4.4 11l6.6-1L14 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </div>
          <h3>Not sure which?</h3>
          <p>For a birthday or a thank-you that lasts, gift Premium. For something small and visible on their profile, send a Telegram Gift. Premium is the safer choice if you do not know their taste.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="gift-pricing">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Pricing</span>
        <h2 class="section-title">Gifted Premium — price in Uzbek som</h2>
        <p class="section-subtitle">Same price as buying it for yourself. There is no 1-month option</p>
      </div>
      <div class="pricing-table-wrap fade-in">
        <table class="pricing-table">
          <thead>
            <tr><th>Term</th><th>Per month</th><th>Total price</th></tr>
          </thead>
          <tbody>
            {plans.map((p) => (
              <tr class={p.best ? 'pricing-highlight' : undefined}>
                <td>
                  {p.months} months
                  {p.best && <span class="pricing-badge">Best value</span>}
                </td>
                <td class="pricing-permonth">~{fmt(Math.round(p.price / p.months / 100) * 100)} UZS</td>
                <td>{fmt(p.price)} UZS</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pricing-note fade-in">
        Telegram Gifts bought with Stars are priced separately, at the flat rate of 240 UZS per star —
        see the <a href="/en/stars">Telegram Stars page</a>. A gifted subscription and a collectible gift
        can both be sent from the same bot.
      </p>
      <div class="pricing-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#127873; Send a gift</a>
      </div>
    </div>
  </section>

  <!-- How -->
  <section class="gift-how">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">How it works</span>
        <h2 class="section-title">How to send a gift</h2>
        <p class="section-subtitle">Three steps — and the recipient does nothing at all</p>
      </div>
      <div class="how-steps">
        <div class="how-step fade-in">
          <div class="how-step-num">1</div>
          <h3>Get their username</h3>
          <p>Copy the <strong>@name</strong> from their profile. Do not type it from memory — a wrong username cannot be reversed</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">2</div>
          <h3>Choose the gift</h3>
          <p>Open <strong>@starsjoybot</strong>, pick Premium or Gift, enter their username and choose a term</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">3</div>
          <h3>Pay and send</h3>
          <p>Transfer the exact amount from Click, Payme or your bank app — Telegram notifies them in about 10 seconds</p>
        </div>
      </div>
      <div class="how-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#127873; Start now</a>
        <p class="how-guide-note"><a href="/en/how-to-buy">See every step with screenshots &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="gift-faq">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-subtitle">Sending Telegram gifts from Uzbekistan</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item fade-in">
            <button class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Reviews lang="en" />

  <!-- CTA -->
  <section class="gift-cta">
    <div class="container">
      <div class="gift-cta-box fade-in">
        <h2>Send someone a gift today</h2>
        <p>You need their username. They need nothing at all.</p>
        <a href="https://telegram.me/starsjoybot" class="btn-white" target="_blank">&#127873; Send a gift</a>
      </div>
    </div>
  </section>

  <FooterEn />
</Layout>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const isActive = item.classList.contains('active');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('active');
        (i.querySelector('.faq-answer') as HTMLElement).style.maxHeight = '';
      });
      if (!isActive) {
        item.classList.add('active');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });
</script>

<style>
  .gift-hero {
    padding: 120px 24px 80px;
    background: linear-gradient(180deg, #FFF0F6 0%, #FFFFFF 100%);
    position: relative;
    overflow: hidden;
  }
  .gift-hero::before {
    content: '';
    position: absolute;
    top: -150px; right: -150px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(200, 80, 192, 0.08), transparent 70%);
    pointer-events: none;
  }
  .breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--text-muted); margin-bottom: 32px;
  }
  .breadcrumb a { color: var(--primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .gift-hero-inner { display: flex; align-items: center; gap: 60px; }
  .gift-hero-content { flex: 1; }
  .gift-hero-visual { flex: 0 0 280px; display: flex; align-items: center; justify-content: center; }

  .gift-title { font-size: 3rem; font-weight: 900; line-height: 1.15; margin-bottom: 20px; color: var(--text); }
  .gift-desc { font-size: 1.15rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 28px; max-width: 540px; }

  .gift-features { display: flex; gap: 24px; margin-bottom: 32px; flex-wrap: wrap; }
  .gift-feature { display: flex; align-items: center; gap: 8px; font-size: 0.92rem; font-weight: 500; color: var(--text); }

  .gift-icon-big {
    width: 160px; height: 160px;
    background: linear-gradient(135deg, #FCE4EC, #F8BBD0);
    border-radius: 36px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 16px 48px rgba(200, 80, 192, 0.2);
  }

  .gift-why { background: var(--bg-alt); }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .why-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    padding: 32px 24px; text-align: center; box-shadow: var(--shadow-sm);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .why-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .why-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; color: var(--text); }
  .why-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }
  .why-icon {
    width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
  }
  .wi-unique { background: rgba(200, 80, 192, 0.08); color: #C850C0; }
  .wi-instant { background: rgba(255, 174, 0, 0.1); color: #D97706; }
  .wi-personal { background: rgba(37, 99, 235, 0.08); color: #2563EB; }

  .how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-bottom: 40px; }
  .how-step {
    text-align: center; padding: 32px 24px; background: #fff;
    border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm);
  }
  .how-step h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; color: var(--text); }
  .how-step p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }
  .how-step-num {
    width: 48px; height: 48px; margin: 0 auto 16px; background: var(--gradient);
    border-radius: 14px; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.2rem; color: #fff;
  }
  .how-cta { text-align: center; }

  .gift-faq { background: var(--bg-alt); }
  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-sm);
    overflow: hidden; box-shadow: var(--shadow-sm); transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item.active { border-color: rgba(124, 58, 237, 0.3); box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08); }
  .faq-question {
    width: 100%; padding: 20px 24px; background: none; border: none; color: var(--text);
    font-size: 1rem; font-weight: 600; text-align: left; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 16px; font-family: inherit;
  }
  .faq-question:hover { color: var(--primary); }
  .faq-toggle {
    width: 28px; height: 28px; min-width: 28px; border-radius: 8px;
    background: rgba(124, 58, 237, 0.06); display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; color: var(--primary); transition: transform 0.3s;
  }
  .faq-item.active .faq-toggle { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-answer-inner { padding: 0 24px 20px; color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; }

  .gift-cta-box {
    background: linear-gradient(135deg, #C850C0, #7C3AED);
    border-radius: 24px; padding: 60px 40px; text-align: center; color: #fff;
  }
  .gift-cta-box h2 { font-size: 2rem; font-weight: 800; margin-bottom: 12px; }
  .gift-cta-box p { font-size: 1.1rem; opacity: 0.9; margin-bottom: 28px; }
  .btn-white {
    display: inline-flex; align-items: center; gap: 8px; padding: 16px 36px;
    background: #fff; color: #5B21B6; border-radius: 50px; font-size: 1.05rem;
    font-weight: 700; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2); }

  @media (max-width: 1024px) {
    .gift-hero-inner { flex-direction: column; text-align: center; }
    .gift-hero-visual { flex: none; }
    .gift-desc { margin: 0 auto 28px; }
    .gift-features { justify-content: center; }
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .gift-hero { padding: 100px 16px 40px; }
    .gift-hero-inner { gap: 28px; text-align: left; }
    .gift-title { font-size: 1.75rem; line-height: 1.2; }
    .gift-desc { font-size: 0.95rem; margin: 0 0 20px; line-height: 1.6; }
    .gift-features { flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
    .gift-feature { font-size: 0.85rem; }
    .breadcrumb { margin-bottom: 20px; font-size: 0.8rem; }
    .gift-hero-visual { display: none; }
    .gift-hero-inner :global(.btn-primary) { width: 100%; justify-content: center; padding: 14px 24px; font-size: 0.95rem; }

    .why-grid { grid-template-columns: 1fr; gap: 12px; }
    .why-card {
      padding: 20px;
      display: flex;
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 16px;
    }
    .why-card:hover { transform: none; }
    .why-icon { width: 48px; height: 48px; min-width: 48px; margin: 0; border-radius: 14px; }
    .why-card h3 { font-size: 0.95rem; margin-bottom: 2px; }
    .why-card p { font-size: 0.82rem; line-height: 1.5; }

    .how-steps { grid-template-columns: 1fr; gap: 12px; }
    .how-step {
      padding: 20px;
      display: flex;
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 16px;
    }
    .how-step-num { width: 36px; height: 36px; min-width: 36px; margin: 0; font-size: 0.95rem; border-radius: 10px; }
    .how-step h3 { font-size: 0.95rem; margin-bottom: 2px; }
    .how-step p { font-size: 0.82rem; line-height: 1.5; }

    .gift-cta-box { padding: 40px 20px; }
    .gift-cta-box h2 { font-size: 1.4rem; }
    .gift-cta-box p { font-size: 0.95rem; }
  }

  .how-guide-note {
    margin-top: 14px;
    font-size: 0.9rem;
  }
  .how-guide-note a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }
  .how-guide-note a:hover { text-decoration: underline; }

  .pricing-table-wrap {
    max-width: 520px;
    margin: 0 auto 24px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
  }
  .pricing-table { width: 100%; border-collapse: collapse; background: #fff; }
  .pricing-table thead th {
    background: var(--gradient);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    text-align: left;
    padding: 16px 28px;
    letter-spacing: 0.3px;
  }
  .pricing-table thead th:last-child { text-align: right; }
  .pricing-table tbody tr { transition: background 0.2s; }
  .pricing-table tbody tr:hover { background: var(--bg-alt); }
  .pricing-table tbody tr:last-child td { border-bottom: none; }
  .pricing-table td {
    padding: 16px 28px;
    color: var(--text);
    font-size: 1rem;
    border-bottom: 1px solid var(--border-light);
  }
  .pricing-table td:first-child { font-weight: 600; }
  .pricing-table td:last-child { font-weight: 800; color: var(--primary); text-align: right; }
