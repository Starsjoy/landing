const title = "Telegram Stars va Premium statistikasi 2026 (raqamlarda)";
const description = "Telegram statistikasi 2026: 1 milliard+ foydalanuvchi, 15 million Premium obunachi, $870 mln yarim yillik daromad. Stars narxi va Gifts bozori — manba bilan.";
const publishDate = "2026-08-23";
const canonical = "https://starsjoy.uz/blog/telegram-stars-premium-statistika-2026";
const faqs = [
  ["Telegram 2026-yilda nechta foydalanuvchiga ega?", "Pavel Durov 2025-yil mart oyida X (Twitter) orqali 1 milliarddan ortiq oylik faol foydalanuvchini rasman e'lon qildi — bu hozirgacha so'nggi tasdiqlangan rasmiy raqam."],
  ["Telegram Premium necha million obunachiga ega?", "2025-yil may holatiga 15 milliondan ortiq (Durov e'loni) — bu jami foydalanuvchining taxminan 1,5%i. 2023-yil dekabrida bu ko'rsatkich atigi 4 million edi."],
  ["Telegram foyda ko'radimi yoki zararga ishlaydimi?", "2024-yil kompaniya birinchi marta foyda ko'rdi ($547 mln). 2025-yil birinchi yarim yilligida daromad 65% o'sib $870 mln'ga yetdi, lekin TON tokeni qadrsizlanishi sabab shu davrda $220 mln+ zarar ham qayd etildi — daromad o'sishi hali barqaror foydaga aylanmagan."],
  ["Telegram Stars'ni O'zbekistonda arzonroq qanday sotib olish mumkin?", "App Store yoki Google Play orqali xarid xalqaro karta va dollar hisobini talab qiladi. StarsJoy orqali Uzcard yoki Humo bilan to'g'ridan-to'g'ri so'mda, 240 so'm/star bir xil tarifda va taxminan 10 soniyada yetkaziladi."],
];
---

