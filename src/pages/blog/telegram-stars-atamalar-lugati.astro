---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = "Telegram Stars atamalari lug'ati: 18 ta muhim so'z (2026) | StarsJoy";
const description = "Stars, Fragment, Collectible, TON, withdraw va refund kabi atamalar oddiy tilda tushuntirilgan — Stars haqidagi har qanday qo'llanmani tushunish uchun to'liq lug'at.";
const publishDate = "2026-09-06";
const canonical = "https://starsjoy.uz/blog/telegram-stars-atamalar-lugati";

const terms = [
  {
    group: "Asosiy tushunchalar: Stars, Premium, TON, Fragment",
    items: [
      { q: "Telegram Stars nima?", a: "Telegram Stars — Telegram ilovasi ichida ishlaydigan raqamli valyuta. U orqali sovg'a sotib olish, kanal va botlarga to'lov qilish, pullik kontentni ochish va Premium obunani rasmiylashtirish mumkin. Stars App Store, Google Play yoki mahalliy reseller bot (masalan @starsjoybot) orqali to'ldiriladi." },
      { q: "Telegram Premium nima?", a: "Telegram Premium — ilovaning kengaytirilgan funksiyalarini ochadigan oylik yoki yillik obuna: 4 GB fayl yuklash, tezroq yuklab olish, premium emoji, animatsiyali profil rasmi va reklamasiz kanal ko'rish. Stars — valyuta, Premium esa shu valyuta yoki to'g'ridan-to'g'ri pul bilan sotib olinadigan xizmat." },
      { q: "TON (Toncoin) nima?", a: "TON — Telegram ekotizimi bilan bog'liq mustaqil blockchain tarmog'ining kriptovalyutasi. Stars — Telegram ichidagi yopiq valyuta bo'lib, uni to'g'ridan-to'g'ri pulga almashtirib bo'lmaydi; faqat Fragment orqali TON'ga aylantirilgandan keyingina tashqi kripto-birjalarda sotish mumkin." },
      { q: "Fragment nima?", a: "Fragment (fragment.com) — Telegram'ning rasmiy platformasi, u yerda Stars'ni TON'ga aylantirish, shuningdek noyob username va telefon raqamlarini auksionda sotib olish mumkin. Fragment — Stars bilan TON o'rtasidagi ko'prik vazifasini bajaradi." },
    ],
  },
  {
    group: "Sovg'a va NFT atamalari",
    items: [
      { q: "Gift (sovg'a) nima?", a: "Gift — boshqa foydalanuvchiga Stars evaziga yuboriladigan raqamli sovg'a (masalan, Teddy Bear yoki Diamond). Oddiy sovg'a shaxsiy profilda ko'rinadi, lekin uni qayta sotib bo'lmaydi — buning uchun u avval Collectible'ga aylantirilishi kerak." },
      { q: "Collectible (NFT gift) nima?", a: "Collectible — oddiy sovg'ani Stars to'lab noyob raqamli versiyaga (blockchain'dagi NFT'ga) aylantirilgan shakli. Har birida o'ziga xos tartib raqami va Model/Backdrop/Symbol xususiyatlari bor, shuning uchun uni Marketplace'da yoki Fragment orqali qayta sotish mumkin." },
      { q: "Model, Backdrop, Symbol nima?", a: "Bular — har bir Collectible sovg'ada tasodifiy tayinlanadigan uchta vizual xususiyat (trait). Qanchalik kam uchraydigan kombinatsiya bo'lsa, sovg'a bozorda shuncha qimmatroq baholanadi — bu narx shakllanishining asosiy mexanizmi." },
      { q: "Marketplace nima?", a: "Marketplace — Telegram ilovasi ichidagi rasmiy savdo maydoni, u yerda Collectible sovg'alarni Stars evaziga sotish yoki sotib olish mumkin. 2025-yil may oyidan beri ishlaydi va har safar Fragment'ga chiqmasdan tezroq savdo qilish imkonini beradi." },
      { q: "Upgrade (yangilash) nima?", a: "Upgrade — oddiy sovg'ani Collectible holatiga o'tkazish jarayoni, odatda ma'lum miqdordagi Stars evaziga amalga oshiriladi. Faqat upgrade qilingandan keyin sovg'ani Marketplace'da sotish yoki Fragment orqali blockchain'ga eksport qilish mumkin bo'ladi." },
    ],
  },
  {
    group: "Bot, to'lov va xarid atamalari",
    items: [
      { q: "Provider / reseller bot nima?", a: "Provider (yetkazib beruvchi) — Stars yoki Premium'ni foydalanuvchiga yetkazib beradigan xizmat, odatda mahalliy to'lov (Uzcard, Humo, Click, Payme) qabul qiladigan bot. StarsJoy ham shunday reseller — u rasmiy Telegram sherigi emas, balki mustaqil xizmat ko'rsatuvchi." },
      { q: "Mini App nima?", a: "Mini App — Telegram ichida ochiladigan to'liq huquqli web-ilova, alohida dastur o'rnatmasdan ishlaydi. @starsjoybot kabi ko'plab botlar aslida chatga emas, shu Mini App'ga kirish uchun kalit vazifasini bajaradi." },
      { q: "Invoice nima?", a: "Invoice — botda ko'rsatiladigan to'lov so'rovi: summasi, mahsuloti va to'lov usuli ko'rsatilgan oyna. Foydalanuvchi shu oynadagi ma'lumot asosida to'lovni tasdiqlaydi." },
      { q: "Paid post / paid media nima?", a: "Paid media — kanal egasi tomonidan qo'yilgan, ko'rish uchun Stars to'lash talab qilinadigan post (rasm yoki video). Bu funksiyani 1000 dan ortiq obunachisi bo'lgan kanallar yoqishi mumkin." },
    ],
  },
  {
    group: "Pul aylanmasi va muammolar bilan bog'liq atamalar",
    items: [
      { q: "Balance (hisob) nima?", a: "Balance — sizning joriy Stars miqdoringiz, Sozlamalar &gt; Sizning Stars'laringiz bo'limida ko'rinadi. Balansdagi Stars sarflanmaguncha yo'qolmaydi va amal muddati cheklanmagan." },
      { q: "Withdraw / kartaga chiqarish nima?", a: "Withdraw — kontent yaratuvchi yoki kanal egasi ishlab topgan Stars'ni Fragment orqali TON'ga, keyin tashqi xizmat orqali so'mga aylantirish jarayoni. Minimal chegara 1000 Stars, yangi tushgan Stars esa faqat 21 kundan keyin yechib olish uchun yaroqli bo'ladi." },
      { q: "Refund (qaytarish) nima?", a: "Refund — sarflangan Stars'ni qaytarib olish. Telegram'ning rasmiy qoidasiga ko'ra Stars xaridi yakuniy va qaytarilmaydi; faqat bot xizmat ko'rsatmagan holatlarda /paysupport orqali murojaat qilish mumkin." },
      { q: "Chargeback nima?", a: "Chargeback — foydalanuvchi bank orqali to'lovni bekor qildirishga urinishi. Telegram bunday holatda hisobni vaqtincha yoki butunlay bloklash huquqini o'zida saqlaydi, shuning uchun bu tavsiya etilmaydigan yo'l." },
      { q: "/paysupport nima?", a: "/paysupport — bot ichidagi to'lov bo'yicha nizolarni Telegram'ga yetkazish uchun maxsus buyruq. Foydalanuvchi shikoyat yuborishda tranzaksiya ID'sini ko'rsatishi kerak, lekin natija kafolatlanmaydi." },
    ],
  },
];

const faqEntities = terms.flatMap((g) => g.items).map((t) => ({
  "@type": "Question",
  "name": t.q,
  "acceptedAnswer": { "@type": "Answer", "text": t.a.replace(/&gt;/g, '>') }
}));
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords="telegram stars atamalari, stars lug'ati, fragment nima, collectible nima, ton nima, stars atamalari lug'ati, telegram stars glossary"
  ogType="article"
  hreflangs={[
    { lang: "uz", href: "https://starsjoy.uz/blog/telegram-stars-atamalar-lugati" },
    { lang: "ru", href: "https://starsjoy.uz/ru/blog/telegram-stars-atamalar-lugati" },
    { lang: "en", href: "https://starsjoy.uz/en/blog/telegram-stars-glossary" }
  ]}
>
  <Navbar />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Telegram Stars atamalari lug'ati: 18 ta muhim so'z (2026)",
    "description": description,
    "datePublished": publishDate,
    "dateModified": publishDate,
    "inLanguage": "uz-UZ",
    "articleSection": "Stars",
    "author": { "@type": "Organization", "name": "StarsJoy", "url": "https://starsjoy.uz" },
    "publisher": {
      "@type": "Organization",
      "name": "StarsJoy",
      "url": "https://starsjoy.uz",
      "logo": { "@type": "ImageObject", "url": "https://starsjoy.uz/logo.png" }
    },
    "mainEntityOfPage": canonical,
    "image": { "@type": "ImageObject", "url": "https://starsjoy.uz/logo.png", "width": 512, "height": 512 }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Bosh sahifa", "item": "https://starsjoy.uz" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://starsjoy.uz/blog" },
      { "@type": "ListItem", "position": 3, "name": "Stars atamalari lug'ati", "item": canonical }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqEntities
  })} />

  <article class="blog-post">
    <header class="post-hero">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/">Bosh sahifa</a>
          <span>/</span>
          <a href="/blog">Blog</a>
          <span>/</span>
          <span>Stars atamalari lug'ati</span>
        </nav>
        <div class="post-tag">Stars</div>
        <h1 class="post-title">Telegram Stars atamalari lug'ati: 18 ta muhim so'z (2026)</h1>
        <div class="post-meta">
          <span class="post-date">{publishDate}</span>
          <span class="post-author">StarsJoy</span>
        </div>
      </div>
    </header>

    <div class="post-body">
      <div class="container">
        <div class="post-content">

          <section>
            <p class="post-lead"><strong>Qisqa javob:</strong> Telegram Stars — bu ilovaning ichki virtual valyutasi, u orqali sovg'a, obuna va kontentga to'lov qilinadi. Fragment, Collectible, TON, withdraw kabi atamalar ko'pincha boshqa qo'llanmalarda tushuntirishsiz ishlatiladi — quyida ularning barchasi oddiy tilda, mavzu bo'yicha guruhlab tushuntirilgan.</p>
          </section>

          <section>
            <p>Bu — Stars ekotizimidagi eng ko'p uchraydigan 18 ta atamaning to'liq lug'ati. Har bir atama alohida savol sifatida berilgan — kerakli so'zni tez topish uchun Ctrl+F (yoki mobilda "sahifada qidirish") dan foydalaning.</p>
          </section>

          {terms.map((group) => (
            <section>
              <h2>{group.group}</h2>
              {group.items.map((t) => (
                <Fragment>
                  <h3>{t.q}</h3>
                  <p set:html={t.a} />
                </Fragment>
              ))}
            </section>
          ))}

          <section>
            <div class="post-cta-box">
              <a href="https://telegram.me/starsjoybot" target="_blank" class="post-cta-btn">Stars sotib olish &rarr;</a>
              <span class="post-cta-sub">telegram.me/starsjoybot</span>
            </div>
          </section>

          <section>
            <h2>Xulosa</h2>
            <p>Bu lug'at Stars ekotizimidagi eng muhim atamalarni bir joyga jamladi. Agar biror qo'llanmani o'qiyotganda tushunarsiz so'zga duch kelsangiz — shu sahifaga qaytib, tegishli bo'limni qidiring.</p>
            <p>Amaliy mavzular bo'yicha to'liq qo'llanmalar: <a href="/blog/telegram-stars-fragment-alternativa">Fragment ishlamasa nima qilish</a>, <a href="/blog/telegram-gift-collectible-upgrade">sovg'ani Collectible'ga aylantirish</a>, <a href="/blog/telegram-sovga-sotish-fragment">Marketplace'da sovg'a sotish</a>, <a href="/blog/telegram-ton-va-stars-farqi">TON va Stars farqi</a>, <a href="/blog/telegram-stars-kartaga-chiqarish">Stars'ni kartaga chiqarish</a> va <a href="/blog/telegram-stars-refund-qaytarish">refund siyosati</a>.</p>
            <p>Stars sotib olishni boshlash uchun <a href="/stars">Stars narxlari sahifasi</a>ga o'ting yoki to'g'ridan-to'g'ri <a href="https://telegram.me/starsjoybot" target="_blank" rel="noopener">@starsjoybot</a> orqali xarid qiling.</p>
          </section>

        </div>
      </div>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .post-hero { padding: 120px 24px 48px; background: #F8F6FF; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .post-tag { display: inline-block; padding: 4px 12px; background: rgba(124, 58, 237, 0.08); border-radius: 50px; color: var(--primary); font-size: 0.78rem; font-weight: 600; margin-bottom: 16px; }
  .post-title { font-size: 2.2rem; font-weight: 900; color: var(--text); margin-bottom: 16px; line-height: 1.2; max-width: 800px; }
  .post-meta { display: flex; align-items: center; gap: 16px; font-size: 0.9rem; color: var(--text-muted); }
  .post-body { padding: 60px 24px; }
  .post-content { max-width: 760px; margin: 0 auto; }
  .post-content section { padding: 0; margin: 0; }
  .post-lead { font-size: 1.08rem !important; color: var(--text) !important; background: #F8F6FF; border-left: 3px solid var(--primary); border-radius: 8px; padding: 18px 20px; line-height: 1.75 !important; }
  .post-content h2 { font-size: 1.4rem; font-weight: 800; color: var(--text); margin: 32px 0 8px; line-height: 1.3; }
  .post-content h3 { font-size: 1.05rem; font-weight: 700; color: var(--primary); margin: 18px 0 4px; }
  .post-content p { font-size: 1rem; color: var(--text-muted); line-height: 1.75; margin-bottom: 10px; }
  .post-content a { color: var(--primary); text-decoration: none; }
  .post-content a:hover { text-decoration: underline; }
  .post-content a.post-cta-btn { text-decoration: none; }
  .post-content ul, .post-content ol { padding-left: 24px; margin-bottom: 14px; }
  .post-content li { font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 6px; }
  .post-cta-box { margin: 16px 0; padding: 0; background: none; border: none; }
  .post-cta-btn { display: inline-block; padding: 8px 20px; background: rgba(124, 58, 237, 0.06); color: var(--primary); font-weight: 600; font-size: 0.9rem; border-radius: 8px; text-decoration: none; border: 1px solid rgba(124, 58, 237, 0.15); transition: background 0.2s, border-color 0.2s; }
  .post-cta-btn:hover { background: rgba(124, 58, 237, 0.1); border-color: rgba(124, 58, 237, 0.3); }
  .post-cta-sub { display: inline; margin-left: 10px; font-size: 0.82rem; color: var(--text-light); }

  @media (max-width: 640px) {
    .post-hero { padding: 100px 16px 36px; }
    .post-title { font-size: 1.5rem; }
    .post-body { padding: 40px 16px; }
    .post-content h2 { font-size: 1.2rem; margin-top: 28px; }
    .post-content h3 { font-size: 1rem; }
    .post-content p { font-size: 0.95rem; }
    .post-content li { font-size: 0.95rem; }
    .breadcrumb { font-size: 0.8rem; }
  }
</style>
