  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Article",headline:"Telegram Ads'ni Stars bilan qanday to'lash mumkin?",description,datePublished:publishDate,dateModified:publishDate,inLanguage:"uz-UZ",articleSection:"Biznes",author:{"@type":"Organization",name:"StarsJoy",url:"https://starsjoy.uz"},publisher:{"@type":"Organization",name:"StarsJoy",logo:{"@type":"ImageObject",url:"https://starsjoy.uz/logo.png"}},mainEntityOfPage:canonical,image:"https://starsjoy.uz/og-image.png"})} />
