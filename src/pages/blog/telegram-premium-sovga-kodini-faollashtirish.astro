  keywords="telegram premium gift code, premium sovg'a kodi, telegram giftcode faollashtirish, telegram premium kod kiritish, t.me giftcode"
  ogType="article"
  hreflangs={[
    { lang: "uz", href: "https://starsjoy.uz/blog/telegram-premium-sovga-kodini-faollashtirish" },
    { lang: "ru", href: "https://starsjoy.uz/ru/blog/telegram-premium-sovga-kodini-faollashtirish" },
    { lang: "en", href: "https://starsjoy.uz/en/blog/activate-telegram-premium-gift-code" }
  ]}
>
  <Navbar />

  <script type="application/ld+json" set:html={JSON.stringify({
