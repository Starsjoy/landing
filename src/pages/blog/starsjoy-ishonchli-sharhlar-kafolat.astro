    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "StarsJoy Telegram'ning rasmiy hamkorimi?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yo'q. StarsJoy — Telegram Stars va Premium sotadigan mustaqil reseller (independent reseller), Telegram bilan rasmiy shartnomasi yo'q. Bu holat barcha mahalliy reseller botlar uchun odatiy — Telegram uchinchi tomon botlar bilan rasmiy hamkorlik shartnomasi imzolamaydi. StarsJoy buni yashirmaydi va saytida ochiq e'lon qiladi." }
      },
      {
        "@type": "Question",
        "name": "StarsJoy'dagi mijozlar sharhlari haqiqiymi?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sharhlar /sharhlar sahifasida sana bilan chop etiladi va moderatsiyadan o'tadi — bu moderatsiya sanasi emas, aynan sharh yozilgan sana. Hozircha 78 ta sharh, o'rtacha ball 4.9/5. Har kim yangi sharh qoldirishi va mavjud sharhlarni ko'rishi mumkin." }
      },
