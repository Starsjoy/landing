    { lang: "ru", href: "https://starsjoy.uz/ru/blog/telegram-premium-rich-text-editor" },
    { lang: "en", href: "https://starsjoy.uz/en/blog/telegram-premium-rich-text-editor" }
  ]}
>
  <Navbar />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Telegram Premium Rich Text Editor: uzun post qanday yoziladi? (2026)",
    "description": description,
    "datePublished": publishDate,
    "dateModified": publishDate,
    "inLanguage": "uz-UZ",
    "articleSection": "Premium",
