---
import Layout from '../../../layouts/Layout.astro';
import NavbarRu from '../../../components/NavbarRu.astro';
import FooterRu from '../../../components/FooterRu.astro';
import VariantPage from '../../../components/VariantPage.astro';
import { hreflangsFor } from '../../../lib/i18n';

const canonical = "https://starsjoy.uz/ru/stars/5000";
const title = "Купить 5000 Telegram Stars — 1 200 000 сум | StarsJoy";
const description = "5000 Telegram Stars — 1 200 000 сум. Оптовый пакет для активных авторов контента и владельцев каналов. Оплата Uzcard/Click, доставка за 10 секунд.";

const faqs = [
  {
    q: "Где можно купить 5000 Telegram Stars оптом дешевле?",
    a: "Через @starsjoybot — введите количество 5000 и оплатите через Uzcard, Humo или Click. Цена 1 200 000 сум, поступление на баланс за 10 секунд."
  },
  {
    q: "Кому подходит пакет 5000 Stars?",
    a: "5000 Stars — оптовое количество для владельцев каналов, активных бизнес-аккаунтов ботов или тех, кто регулярно поддерживает нескольких авторов контента."
  },
  {
    q: "Безопасно ли покупать сразу такое большое количество?",
    a: "Да, процесс не отличается от покупки 100 или 1000 штук — после подтверждения оплаты Stars приходят за 10 секунд, а при проблеме гарантирован полный возврат 100%."
  },
  {
    q: "Есть ли скидка на 5000 Stars?",
    a: "У StarsJoy единый тариф для всех количеств (240 сум/звезда) — цена за звезду не меняется с ростом количества, растёт только итоговая сумма."
  },
  {
    q: "Как оплатить крупную сумму (1 200 000 сум)?",
    a: "Через Uzcard, Humo, Click или Payme. Если на карте есть дневной лимит, попробуйте оплату через приложение Click или Payme."
  },
  {
    q: "Что если нужно больше 5000 Stars?",
    a: "В боте можно указать любое количество — например 10 000, для этого количества у нас тоже есть отдельная страница с той же ценой за звезду."
  }
];

const siblings = [
  { href: "/ru/stars/100", label: "100 ⭐" },
  { href: "/ru/stars/500", label: "500 ⭐" },
  { href: "/ru/stars/1000", label: "1000 ⭐" },
  { href: "/ru/stars/5000", label: "5000 ⭐", active: true },
  { href: "/ru/stars/10000", label: "10 000 ⭐" },
];

const trustItems = [
  { num: "8 000+", title: "Выполненных заказов", text: "Сервис работает больше года, число заказов открыто." },
  { num: "10 сек.", title: "Время доставки", text: "После подтверждения оплаты Stars приходят обычно за 10 секунд." },
  { num: "100%", title: "Возврат средств", text: "Если услуга не оказана — сумма возвращается полностью." },
];

const related = [
  { href: "/blog/telegram-stars-koplab-arzon", label: "Покупка большого количества Stars — для каналов и бизнеса" },
  { href: "/blog/telegram-stars-paketlari-taqqoslash", label: "Сравнение пакетов Stars — какой когда выбрать" },
  { href: "/ru/stars", label: "Все пакеты Stars" },
  { href: "/ru/narxlar", label: "Stars и Premium — все цены" },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords="5000 Telegram Stars, цена 5000 stars, купить 5000 Telegram Stars, Telegram Stars оптом"
  lang="ru"
  hreflangs={hreflangsFor('/stars/5000')}
>
  <NavbarRu />
  <VariantPage
    accent="gold"
    canonical={canonical}
    homeLabel="Главная"
    hubLabel="Telegram Stars"
    hubHref="/ru/stars"
    currentLabel="5000 ⭐"
    eyebrow="Telegram Stars — 5000 штук"
    h1="Купить 5000 Telegram Stars"
    quickAnswer="5000 Telegram Stars — 1 200 000 сум, поступают на баланс через @starsjoybot за 10 секунд."
    heroNote="Оптовый пакет для владельцев каналов и активных авторов контента — по единому тарифу 240 сум/звезда."
    siblingsTitle="Другие количества"
    siblings={siblings}
    priceLabel="Цена"
    priceValue="1 200 000 сум"
    priceSubtext="240 сум/звезда"
    ctaLabel="Купить 5000 Stars"
    ctaHref="https://telegram.me/starsjoybot"
    forWhomTitle="Кому подойдёт?"
    forWhomText="5000 Stars — оптовое количество для владельцев каналов, активных бизнес-аккаунтов или тех, кто регулярно и в большом объёме поддерживает нескольких авторов контента."
    trustItems={trustItems}
    faqTitle="Вопросы о 5000 Stars"
    faqSubtitle="Ответы на самые частые вопросы"
    faqs={faqs}
    relatedTitle="Дополнительно о Stars"
    related={related}
    finalCtaTitle="Готовы купить 5000 Stars?"
    finalCtaText="1 200 000 сум, оплата Uzcard/Click, доставка за 10 секунд"
    finalCtaLabel="Купить сейчас"
    schemaName="Telegram Stars — 5000 штук"
    schemaDescription={description}
    priceAmount="1200000"
    breadcrumbSchema={[
      { name: "Главная", item: "https://starsjoy.uz/ru" },
      { name: "Telegram Stars", item: "https://starsjoy.uz/ru/stars" },
      { name: "5000 штук", item: canonical },
    ]}
  />
  <FooterRu />
</Layout>
