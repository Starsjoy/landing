---
import Layout from '../../../layouts/Layout.astro';
import NavbarRu from '../../../components/NavbarRu.astro';
import FooterRu from '../../../components/FooterRu.astro';
import VariantPage from '../../../components/VariantPage.astro';
import { hreflangsFor } from '../../../lib/i18n';

const canonical = "https://starsjoy.uz/ru/stars/100";
const title = "Купить 100 Telegram Stars — 24 000 сум | StarsJoy";
const description = "100 Telegram Stars — 24 000 сум. Самый маленький пробный пакет для тех, кто впервые покупает Stars. Оплата Uzcard/Click, доставка за 10 секунд.";

const faqs = [
  {
    q: "Где можно купить 100 Telegram Stars?",
    a: "Через @starsjoybot — введите количество 100 и оплатите через Uzcard, Humo или Click. Цена 24 000 сум, поступление на баланс за 10 секунд."
  },
  {
    q: "На что хватит 100 Stars?",
    a: "100 Stars хватит, чтобы открыть один-два платных поста в канале, воспользоваться небольшой платной функцией бота или отправить небольшой донат автору контента. Это самый маленький пакет для пробы."
  },
  {
    q: "Стоит ли начинать со 100 Stars, если покупаю впервые?",
    a: "Да, если хотите впервые проверить, как работает Stars и весь процесс покупки, 100 штук (24 000 сум) — самый доступный и безопасный старт. Понравится — в следующий раз возьмёте пакет побольше."
  },
  {
    q: "Такой маленький пакет тоже доставляется за 10 секунд?",
    a: "Да, скорость доставки не зависит от количества — и 100, и 10 000 звёзд обычно приходят на баланс в течение 10 секунд после подтверждения оплаты."
  },
  {
    q: "Цена 100 Stars выше, чем у больших пакетов?",
    a: "Нет, у StarsJoy единый тариф — 240 сум за звезду для любого количества. Разница только в итоговой сумме, не в цене за штуку."
  },
  {
    q: "Можно подарить 100 Stars?",
    a: "Да, в боте можно отправить 100 Stars любому пользователю Telegram в подарок — удобный небольшой презент."
  }
];

const siblings = [
  { href: "/ru/stars/100", label: "100 ⭐", active: true },
  { href: "/ru/stars/500", label: "500 ⭐" },
  { href: "/ru/stars/1000", label: "1000 ⭐" },
  { href: "/ru/stars/5000", label: "5000 ⭐" },
  { href: "/ru/stars/10000", label: "10 000 ⭐" },
];

const trustItems = [
  { num: "8 000+", title: "Выполненных заказов", text: "Сервис работает больше года, число заказов открыто." },
  { num: "10 сек.", title: "Время доставки", text: "После подтверждения оплаты Stars приходят обычно за 10 секунд." },
  { num: "100%", title: "Возврат средств", text: "Если услуга не оказана — сумма возвращается полностью." },
];

const related = [
  { href: "/blog/telegram-stars-paketlari-taqqoslash", label: "Сравнение пакетов Stars — какой когда выбрать" },
  { href: "/blog/telegram-stars-sotib-olish", label: "Как купить Telegram Stars — полное руководство" },
  { href: "/ru/stars", label: "Все пакеты Stars" },
  { href: "/ru/narxlar", label: "Stars и Premium — все цены" },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords="100 Telegram Stars, цена 100 stars, купить 100 Telegram Stars, Telegram Stars 100 штук"
  lang="ru"
  hreflangs={hreflangsFor('/stars/100')}
>
  <NavbarRu />
  <VariantPage
    accent="gold"
    canonical={canonical}
    homeLabel="Главная"
    hubLabel="Telegram Stars"
    hubHref="/ru/stars"
    currentLabel="100 ⭐"
    eyebrow="Telegram Stars — 100 штук"
    h1="Купить 100 Telegram Stars"
    quickAnswer="100 Telegram Stars — 24 000 сум, поступают на баланс через @starsjoybot за 10 секунд."
    heroNote="Самый маленький и доступный пробный пакет для тех, кто покупает Stars впервые."
    siblingsTitle="Другие количества"
    siblings={siblings}
    priceLabel="Цена"
    priceValue="24 000 сум"
    priceSubtext="240 сум/звезда"
    ctaLabel="Купить 100 Stars"
    ctaHref="https://telegram.me/starsjoybot"
    forWhomTitle="Кому подойдёт?"
    forWhomText="100 Stars подойдут тем, кто хочет впервые попробовать сервис, поддержать автора небольшой суммой или открыть один-два платных поста в канале."
    trustItems={trustItems}
    faqTitle="Вопросы о 100 Stars"
    faqSubtitle="Ответы на самые частые вопросы"
    faqs={faqs}
    relatedTitle="Дополнительно о Stars"
    related={related}
    finalCtaTitle="Готовы купить 100 Stars?"
    finalCtaText="24 000 сум, оплата Uzcard/Click, доставка за 10 секунд"
    finalCtaLabel="Купить сейчас"
    schemaName="Telegram Stars — 100 штук"
    schemaDescription={description}
    priceAmount="24000"
    breadcrumbSchema={[
      { name: "Главная", item: "https://starsjoy.uz/ru" },
      { name: "Telegram Stars", item: "https://starsjoy.uz/ru/stars" },
      { name: "100 штук", item: canonical },
    ]}
  />
  <FooterRu />
</Layout>
