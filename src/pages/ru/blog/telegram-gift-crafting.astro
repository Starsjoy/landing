---
import Layout from '../../../layouts/Layout.astro';
import NavbarRu from '../../../components/NavbarRu.astro';
import FooterRu from '../../../components/FooterRu.astro';

const title = "Telegram Gift Crafting: как объединить подарки в редкий (2026) | StarsJoy Blog";
const description = "Функция Telegram Gift Crafting: объединение до 4 collectible-подарков в новый подарок уровня Rare или Legendary, как работает шанс успеха и риск потери подарков.";
const publishDate = "2026-09-15";
---

<Layout
  title={title}
  description={description}
  canonical="https://starsjoy.uz/ru/blog/telegram-gift-crafting"
  keywords="telegram gift crafting, объединение подарков telegram, telegram legendary gift, создать rare gift telegram, крафтинг collectible telegram"
  ogType="article"
  hreflangs={[
    { lang: "uz", href: "https://starsjoy.uz/blog/telegram-gift-crafting" },
    { lang: "ru", href: "https://starsjoy.uz/ru/blog/telegram-gift-crafting" },
    { lang: "en", href: "https://starsjoy.uz/en/blog/telegram-gift-crafting" }
  ]}
>
  <NavbarRu />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Telegram Gift Crafting: как объединить подарки в редкий (2026)",
    "description": description,
    "datePublished": publishDate,
    "dateModified": publishDate,
    "inLanguage": "ru-RU",
    "articleSection": "Gifts",
    "author": { "@type": "Organization", "name": "StarsJoy", "url": "https://starsjoy.uz" },
    "publisher": {
      "@type": "Organization",
      "name": "StarsJoy",
      "url": "https://starsjoy.uz",
      "logo": { "@type": "ImageObject", "url": "https://starsjoy.uz/logo.png" }
    },
    "mainEntityOfPage": "https://starsjoy.uz/ru/blog/telegram-gift-crafting",
    "image": { "@type": "ImageObject", "url": "https://starsjoy.uz/logo.png", "width": 512, "height": 512 }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://starsjoy.uz/ru" },
      { "@type": "ListItem", "position": 2, "name": "Блог", "item": "https://starsjoy.uz/ru/blog" },
      { "@type": "ListItem", "position": 3, "name": "Gift Crafting", "item": "https://starsjoy.uz/ru/blog/telegram-gift-crafting" }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Как пользоваться Gift Crafting в Telegram",
    "description": "Шаги для объединения collectible-подарков в новый подарок более высокого уровня.",
    "totalTime": "PT2M",
    "step": [
      { "@type": "HowToStep", "name": "Откройте раздел Gifts в профиле", "text": "У вас должно быть минимум 2 collectible-подарка (переведённых в NFT)." },
      { "@type": "HowToStep", "name": "Выберите режим Crafting", "text": "В списке подарков перейдите в раздел крафтинга." },
      { "@type": "HowToStep", "name": "Выберите 2-4 подарка", "text": "Чем больше подарков и выше их уровень, тем выше шанс успеха." },
      { "@type": "HowToStep", "name": "Изучите шанс успеха", "text": "Система покажет процент успеха и возможный уровень результата (Uncommon/Rare/Epic/Legendary)." },
      { "@type": "HowToStep", "name": "Подтвердите крафт", "text": "При успехе вы получаете новый уникальный подарок. При неудаче — все использованные подарки исчезают полностью." }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое Gift Crafting?",
        "acceptedAnswer": { "@type": "Answer", "text": "Функция, выпущенная 8 февраля 2026 года — позволяет объединить до 4 collectible-подарков в новый, уникальный подарок уровня Uncommon, Rare, Epic или Legendary. Каждый уровень получает собственный арт и визуальные эффекты." }
      },
      {
        "@type": "Question",
        "name": "Сколько стоит crafting в Stars?",
        "acceptedAnswer": { "@type": "Answer", "text": "Сам crafting не требует отдельной оплаты Stars — «ценой» служат сами используемые collectible-подарки. Если результат впоследствии нужно оформить как NFT в блокчейне, это может потребовать отдельной оплаты upgrade." }
      },
      {
        "@type": "Question",
        "name": "Как повысить шанс успеха?",
        "acceptedAnswer": { "@type": "Answer", "text": "Двумя способами: (1) чем больше подарков вы добавите (максимум 4) и чем выше их уровень, тем выше шанс; (2) добавление подарков с одинаковыми атрибутами повышает вероятность, что эти атрибуты перейдут в итоговый результат." }
      },
      {
        "@type": "Question",
        "name": "Что происходит при неудачном крафте?",
        "acceptedAnswer": { "@type": "Answer", "text": "Все использованные подарки исчезают полностью, без возврата и компенсации. Telegram официально называет это рискованным механизмом, поэтому рекомендуется использовать в crafting только подарки, потерю которых вы готовы принять." }
      },
      {
        "@type": "Question",
        "name": "Gift Crafting и Gift Upgrade — это одно и то же?",
        "acceptedAnswer": { "@type": "Answer", "text": "Нет, это совершенно разные механизмы. Upgrade — превращение одного обычного подарка в collectible (NFT) за Stars. Crafting — объединение нескольких уже существующих collectible-подарков в новый, ещё более редкий подарок." }
      },
      {
        "@type": "Question",
        "name": "Можно ли продать созданный Legendary-подарок?",
        "acceptedAnswer": { "@type": "Answer", "text": "Да, результат — полноценный collectible-подарок, который можно продать на Gift Marketplace в Telegram или через Fragment. Подарки высокого уровня обычно оцениваются значительно дороже." }
      }
    ]
  })} />

  <article class="blog-post">
    <header class="post-hero">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/ru">Главная</a>
          <span>/</span>
          <a href="/ru/blog">Блог</a>
          <span>/</span>
          <span>Gift Crafting</span>
        </nav>
        <div class="post-tag">Gifts</div>
        <h1 class="post-title">Telegram Gift Crafting: как объединить подарки в редкий (2026)</h1>
        <div class="post-meta">
          <span class="post-date">{publishDate}</span>
          <span class="post-author">StarsJoy</span>
        </div>
      </div>
    </header>

    <div class="post-body">
      <div class="container">
        <div class="post-content">

          <section>
            <p class="post-lead"><strong>Короткий ответ:</strong> 8 февраля 2026 года Telegram выпустил <strong>Gift Crafting</strong> — объединение до 4 collectible-подарков в новый подарок уровня <strong>Uncommon, Rare, Epic или Legendary</strong>. Чем больше подарков и выше их уровень, тем выше шанс успеха — но при неудаче <strong>все использованные подарки исчезают полностью</strong>. Это совершенно другой механизм, чем upgrade (превращение обычного подарка в collectible).</p>
          </section>

          <section>
            <h2>Что такое Gift Crafting?</h2>
            <p>Gift Crafting — функция, выпущенная одновременно с крупнейшим обновлением дизайна Telegram для Android: возможность объединить несколько уже collectible-подарков (переведённых в NFT) и получить из них новый подарок более высокого уровня. Результат — уникальный подарок с собственным артом и визуальными эффектами.</p>
            <p>Если вы ещё не знаете, что такое collectible-подарок, сначала прочитайте статью <a href="/ru/blog/telegram-nft-gifts">что такое Telegram NFT Gifts</a>.</p>
          </section>

          <section>
            <h2>Как это работает — пошагово</h2>
            <ol>
              <li><strong>Откройте раздел Gifts</strong> — у вас должно быть минимум 2 collectible-подарка.</li>
              <li><strong>Перейдите в режим Crafting</strong> — выберите раздел крафтинга в списке подарков.</li>
              <li><strong>Выберите 2-4 подарка</strong> — чем больше добавите, тем выше шанс.</li>
              <li><strong>Изучите шанс успеха</strong> — система покажет процент успеха и возможный уровень результата.</li>
              <li><strong>Подтвердите</strong> — при успехе вы получите новый подарок, при неудаче все подарки будут потеряны.</li>
            </ol>
          </section>

          <section>
            <h2>От чего зависит шанс успеха?</h2>
            <p>Есть два основных фактора. Первый — <strong>количество и уровень</strong>: чем больше подарков вы добавите (максимум 4) и чем выше их уровень, тем выше шанс успеха. Второй — <strong>совпадение атрибутов</strong>: добавление подарков с одинаковыми Model, Backdrop или Symbol повышает вероятность, что эти атрибуты перейдут в итоговый подарок. То есть результат не полностью случаен — выбор подарков частично влияет на итог.</p>
          </section>

          <section>
            <div class="post-cta-box">
              <a href="https://telegram.me/starsjoybot" target="_blank" rel="noopener" class="post-cta-btn">Купить Stars для подарков &rarr;</a>
              <span class="post-cta-sub">telegram.me/starsjoybot</span>
            </div>
          </section>

          <section>
            <h2>Риск: почему это «лотерея»?</h2>
            <p>Crafting — рискованный процесс. При неудачной попытке <strong>все использованные подарки исчезают полностью</strong>, без возврата и частичной компенсации. Поэтому рекомендуется использовать в crafting только недорогие или незначительные для вас подарки — прежде чем рисковать редким или дорогим подарком, хорошо подумайте.</p>
          </section>

          <section>
            <h2>Crafting и Upgrade — в чём разница?</h2>
            <div class="post-table-wrap">
              <table class="post-table">
                <thead><tr><th>Параметр</th><th>Upgrade</th><th>Crafting</th></tr></thead>
                <tbody>
                  <tr><td>Исходный материал</td><td>1 обычный подарок</td><td>2-4 collectible-подарка</td></tr>
                  <tr><td>Стоимость</td><td>Stars (оплата блокчейна)</td><td>Сами используемые подарки</td></tr>
                  <tr><td>Результат</td><td>Collectible (NFT) версия того же подарка</td><td>Совершенно новый подарок более высокого уровня</td></tr>
                  <tr class="highlight-row"><td>Риск неудачи</td><td>Нет — collectible гарантирован</td><td>Есть — все подарки могут быть потеряны</td></tr>
                </tbody>
              </table>
            </div>
            <p>Подробнее о стоимости и механизме upgrade: <a href="/ru/blog/telegram-gift-collectible-upgrade">upgrade подарка Telegram до Collectible</a>.</p>
          </section>

          <section>
            <h2>Можно ли продать созданный подарок?</h2>
            <p>Да — результат является полноценным collectible-подарком, который можно продать на Gift Marketplace в Telegram или через Fragment. Такие уровни обычно оцениваются намного дороже: рекордные цены смотрите в статье <a href="/ru/blog/eng-qimmat-telegram-sovgalari">самые дорогие подарки Telegram</a>. О процессе продажи — <a href="/ru/blog/telegram-sovga-sotish-fragment">продажа подарка через Fragment</a>.</p>
          </section>

          <section>
            <h2>Итог</h2>
            <ul>
              <li>🔨 <strong>Gift Crafting</strong> — функция от 8 февраля 2026 года, объединение до 4 collectible-подарков;</li>
              <li>⭐ Результат — новый подарок уровня <strong>Uncommon, Rare, Epic или Legendary</strong>;</li>
              <li>🎯 Больше подарков высокого уровня + совпадающие атрибуты = выше шанс успеха;</li>
              <li>⚠️ При неудаче <strong>все использованные подарки теряются</strong> — в отличие от upgrade, это настоящий риск;</li>
              <li>💰 Созданный подарок высокого уровня можно продать на Marketplace или Fragment.</li>
            </ul>
            <p>Больше о подарках: <a href="/ru/blog/telegram-gifts-narxi-royxati">цены на Telegram Gifts</a> и <a href="/ru/blog/telegram-gift-collectible-upgrade">upgrade до Collectible</a>, а купить Stars для подарков можно на странице <a href="/ru/gifts">Gifts</a>.</p>
          </section>

        </div>
      </div>
    </div>
  </article>

  <FooterRu />
</Layout>

<style>
  .post-hero { padding: 120px 24px 48px; background: #F8F6FF; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px; flex-wrap: wrap; }
  .breadcrumb a { color: var(--primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .post-tag { display: inline-block; padding: 4px 12px; background: rgba(124, 58, 237, 0.08); border-radius: 50px; color: var(--primary); font-size: 0.78rem; font-weight: 600; margin-bottom: 16px; }
  .post-title { font-size: 2.1rem; font-weight: 900; color: var(--text); margin-bottom: 16px; line-height: 1.25; max-width: 820px; }
  .post-meta { display: flex; align-items: center; gap: 16px; font-size: 0.9rem; color: var(--text-muted); }
  .post-body { padding: 60px 24px; }
  .post-content { max-width: 760px; margin: 0 auto; }
  .post-content section { padding: 0; margin: 0; }
  .post-lead { font-size: 1.08rem !important; color: var(--text) !important; background: #F8F6FF; border-left: 3px solid var(--primary); border-radius: 8px; padding: 18px 20px; line-height: 1.75 !important; }
  .post-content h2 { font-size: 1.4rem; font-weight: 800; color: var(--text); margin: 32px 0 12px; line-height: 1.3; }
  .post-content h3 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin: 18px 0 8px; }
  .post-content p { font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 14px; }
  .post-content a { color: var(--primary); text-decoration: none; }
  .post-content a:hover { text-decoration: underline; }
  .post-content a.post-cta-btn { text-decoration: none; }
  .post-content ul, .post-content ol { padding-left: 24px; margin-bottom: 14px; }
  .post-content li { font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 6px; }
  .post-cta-box { margin: 16px 0; padding: 0; background: none; border: none; }
  .post-cta-btn { display: inline-block; padding: 8px 20px; background: rgba(124, 58, 237, 0.06); color: var(--primary); font-weight: 600; font-size: 0.9rem; border-radius: 8px; text-decoration: none; border: 1px solid rgba(124, 58, 237, 0.15); transition: background 0.2s, border-color 0.2s; }
  .post-cta-btn:hover { background: rgba(124, 58, 237, 0.1); border-color: rgba(124, 58, 237, 0.3); }
  .post-cta-sub { display: inline; margin-left: 10px; font-size: 0.82rem; color: var(--text-light); }
  .post-table-wrap { overflow-x: auto; margin: 20px 0; border-radius: 12px; border: 1px solid rgba(124, 58, 237, 0.12); }
  .post-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .post-table th { background: rgba(124, 58, 237, 0.06); color: var(--text); font-weight: 700; padding: 14px 18px; text-align: left; border-bottom: 1px solid rgba(124, 58, 237, 0.1); }
  .post-table td { padding: 12px 18px; color: var(--text-muted); border-bottom: 1px solid rgba(124, 58, 237, 0.06); }
  .post-table tr:last-child td { border-bottom: none; }
  .post-table .highlight-row { background: rgba(124, 58, 237, 0.04); }
  .post-table .highlight-row td { color: var(--primary); font-weight: 600; }
  .post-faq { margin: 24px 0; }
  .post-faq-item { background: #F8F6FF; border: 1px solid rgba(124, 58, 237, 0.1); border-radius: 12px; padding: 24px; margin-bottom: 12px; }
