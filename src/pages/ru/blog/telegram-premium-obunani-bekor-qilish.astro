    { lang: "uz", href: "https://starsjoy.uz/blog/telegram-premium-obunani-bekor-qilish" },
    { lang: "ru", href: "https://starsjoy.uz/ru/blog/telegram-premium-obunani-bekor-qilish" },
    { lang: "en", href: "https://starsjoy.uz/en/blog/cancel-telegram-premium-auto-renewal" }
  ]}
>
  <NavbarRu />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Как отключить автопродление Telegram Premium? (2026)",
    "description": description,
    "datePublished": publishDate,
    "dateModified": publishDate,
    "inLanguage": "ru-RU",
    "articleSection": "Premium",
