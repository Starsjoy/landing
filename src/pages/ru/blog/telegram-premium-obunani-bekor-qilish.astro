const title = "Как отключить автопродление Telegram Premium? (2026) | StarsJoy";
const description = "Как отключить автопродление Telegram Premium на iOS, Android и через бота — пошагово, что происходит с оставшимися днями после отмены и что делать, если кнопка не появляется.";
const publishDate = "2026-09-06";
const canonical = "https://starsjoy.uz/ru/blog/telegram-premium-obunani-bekor-qilish";
---

<Layout
