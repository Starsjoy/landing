import BlogPost from '../../../layouts/BlogPostEn.astro';
const title = "Как продать подарок Telegram через Marketplace или Fragment";
const description = "Как продать подарок Telegram за Stars или через Fragment: пошаговая инструкция, отличие Marketplace от блокчейна, цена, комиссии и безопасность.";
const publishDate = "2026-08-26";
const faqs = [
  { q: "Можно ли продать подарок Telegram за Stars?", a: "Да. Откройте коллекционный подарок, нажмите Sell и укажите цену в Stars. Объявление появится во встроенном Gift Marketplace. Для обычного подарка без апгрейда кнопка Sell может быть недоступна." },
  { q: "Что нужно для продажи подарка через Fragment?", a: "Подарок должен быть коллекционным и доступным для экспорта. Также нужны облачный пароль Telegram и TON-кошелёк. Путь: Профиль → Gifts → подарок → Transfer → Send via Blockchain." },
  { q: "Можно ли вывести полученные Stars на Uzcard или Humo?", a: "Встроенный Marketplace выплачивает Stars, но Telegram не гарантирует прямой вывод личного баланса на банковскую карту. Продажа NFT на блокчейн-рынке приносит TON, который конвертируется отдельно через легальный сервис с учётом комиссий и рисков." },
