---
import Layout from '../../../layouts/Layout.astro';
import NavbarRu from '../../../components/NavbarRu.astro';
import FooterRu from '../../../components/FooterRu.astro';
import VariantPage from '../../../components/VariantPage.astro';
import { hreflangsFor } from '../../../lib/i18n';

const canonical = "https://starsjoy.uz/ru/premium/6-oy";
