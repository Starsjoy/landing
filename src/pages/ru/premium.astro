---
import Layout from '../../layouts/Layout.astro';
import NavbarRu from '../../components/NavbarRu.astro';
import FooterRu from '../../components/FooterRu.astro';
import Reviews from '../../components/Reviews.astro';
import { getApprovedReviews, aggregateOf } from '../../lib/reviews';

const title = "Купить Telegram Premium — Дёшево в Узбекистане | StarsJoy";
const description = "Telegram Premium цена в Узбекистане: 3 мес — 172 000, 6 мес — 232 000, 12 мес — 422 000 сум. Оплата через Click, Uzcard, Humo. Активация за 10 секунд. StarsJoy.";

const faqs = [
  {
    q: "Что даёт Telegram Premium?",
    a: "Telegram Premium открывает множество возможностей: загрузка файлов до 4 ГБ, быстрая скорость скачивания, отсутствие рекламы, эксклюзивные стикеры и реакции, значок Premium в профиле, перевод сообщений в реальном времени и многое другое."
  },
  {
    q: "Сколько стоит Telegram Premium в Узбекистане?",
    a: "Через StarsJoy вы можете купить Telegram Premium по самой выгодной цене в Узбекистане. Доступны подписки на 3 месяца (172 000 сум), 6 месяцев (232 000 сум) и 12 месяцев (422 000 сум). Чем дольше срок — тем дешевле."
  },
  {
    q: "Можно ли оплатить через Uzcard или Humo?",
    a: "Да! Через StarsJoy вы можете оплатить Telegram Premium картами Uzcard, Humo, через Click или банковскую карту. Процесс оплаты простой и быстрый."
  },
  {
    q: "Как быстро активируется Premium?",
    a: "После подтверждения оплаты Premium подписка активируется в течение 10 секунд."
  },
  {
    q: "Можно ли подарить Premium другому человеку?",
    a: "Конечно! Через StarsJoy вы можете подарить Telegram Premium любому пользователю. Для этого нажмите кнопку «Подарить» в боте и введите username получателя."
  },
  {
    q: "Безопасно ли покупать Premium через StarsJoy?",
    a: "Абсолютно безопасно. StarsJoy — проверенный сервис с тысячами довольных клиентов. Мы гарантируем 100% активацию подписки и предоставляем поддержку 24/7."
  },
  {
    q: "Нужна ли зарубежная карта для покупки Telegram Premium?",
    a: "Нет. Visa или Mastercard не требуются. Оплата проходит полностью в сумах картой Uzcard или Humo — без конвертации валюты. Регистрация и пароль тоже не нужны: достаточно аккаунта Telegram и местной карты."
  },
  {
    q: "Можно ли получить Telegram Premium бесплатно?",
    a: "Telegram Premium — платная подписка, бесплатного способа не существует. Остерегайтесь сайтов, обещающих обратное. Честный способ сэкономить в StarsJoy: по вашей реферальной ссылке вам возвращается 5% от суммы покупки. Кроме того, чем длиннее срок подписки, тем ниже цена за месяц."
  },
  {
    q: "Есть ли подписка на 1 месяц?",
    a: "StarsJoy предлагает тарифы на 3, 6 и 12 месяцев — тарифа на 1 месяц нет. Минимальный срок — 3 месяца (172 000 сум), это примерно 57 300 сум в месяц."
  },
  {
    q: "Что делать, если Premium не пришёл после оплаты?",
    a: "Если услуга не оказана или возникла проблема, оплаченная сумма возвращается в размере 100%. По любым вопросам можно обратиться в поддержку."
  },
  {
    q: "StarsJoy — официальный партнёр Telegram?",
    a: "Нет. StarsJoy — независимый реселлер. Согласно условиям оферты (пункт 2.3), услуга оказывается через официальный API Telegram и инфраструктуру Fragment. Подписка привязывается к вашему настоящему аккаунту официальным путём."
  }
];

// Цена за месяц — рассчитывается из опубликованных тарифов (округлённо)
const plans = [
  { months: 3,  price: 172000, best: false },
  { months: 6,  price: 232000, best: false },
  { months: 12, price: 422000, best: true  },
];
const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const perMonth = (p: { months: number; price: number }) =>
  fmt(Math.round(p.price / p.months / 100) * 100);
// Разница в цене за месяц между тарифами 3 и 12 месяцев
const monthlySaving = fmt(Math.round((172000 / 3 - 422000 / 12) / 1000) * 1000);

// Отзывы клиентов (одобренные, общий пул с UZ) + рейтинг
const reviews = await getApprovedReviews('premium');
const agg = aggregateOf(reviews);

const productSchema: any = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Telegram Premium Подписка",
  "description": description,
  "brand": { "@type": "Brand", "name": "StarsJoy" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "UZS",
    "lowPrice": "172000",
    "highPrice": "422000",
    "availability": "https://schema.org/InStock",
    "offerCount": "3"
  }
};
if (agg.reviewCount > 0) {
  productSchema.aggregateRating = {
    "@type": "AggregateRating",
    "ratingValue": String(agg.ratingValue),
    "reviewCount": String(agg.reviewCount),
    "bestRating": "5"
  };
  productSchema.review = reviews.slice(0, 10).map((r) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.author_name },
    "reviewRating": { "@type": "Rating", "ratingValue": String(r.rating), "bestRating": "5" },
    "reviewBody": r.body,
    "datePublished": r.created_at ? new Date(r.created_at).toISOString().slice(0, 10) : ""
  }));
}
---

<Layout
  title={title}
  description={description}
  canonical="https://starsjoy.uz/ru/premium"
  keywords="купить Telegram Premium, Telegram Premium цена, Telegram Premium Узбекистан, Premium подписка Телеграм, StarsJoy Premium, Telegram Premium дёшево"
  lang="ru"
  hreflangs={[
    { lang: "uz", href: "https://starsjoy.uz/premium" },
    { lang: "ru", href: "https://starsjoy.uz/ru/premium" }
  ]}
>
  <NavbarRu />

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://starsjoy.uz/ru" },
      { "@type": "ListItem", "position": 2, "name": "Купить Telegram Premium", "item": "https://starsjoy.uz/ru/premium" }
    ]
  })} />

  <!-- Hero -->
  <section class="prem-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/ru">Главная</a>
        <span>/</span>
        <span>Telegram Premium</span>
      </nav>
      <div class="prem-hero-inner fade-in">
        <div class="prem-hero-content">
          <h1 class="prem-title">Купить Telegram Premium — По Лучшей Цене</h1>
          <p class="prem-desc">
            Оформите подписку Telegram Premium через Uzcard, Click или Humo. Получите доступ к эксклюзивным функциям: загрузка файлов до 4 ГБ, без рекламы, уникальные стикеры и многое другое. Быстрая активация и 100% гарантия.
          </p>
          <div class="prem-features">
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L5 10l5 10 5-10L10 3z" stroke="#7C3AED" stroke-width="1.5" stroke-linejoin="round" fill="#7C3AED" opacity="0.15"/></svg>
              <span>Активация за 10 секунд</span>
            </div>
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="5" y="9" width="10" height="9" rx="2" stroke="#7C3AED" stroke-width="1.5"/><path d="M7.5 9V7a2.5 2.5 0 1 1 5 0v2" stroke="#7C3AED" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Uzcard / Click / Humo</span>
            </div>
            <div class="prem-feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="#10B981" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>100% гарантия</span>
            </div>
          </div>
          <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">
            &#9889; Купить Premium
          </a>
        </div>
        <div class="prem-hero-visual">
          <div class="prem-icon-big">
            <svg width="80" height="80" viewBox="0 0 52 52" fill="none">
              <defs>
                <linearGradient id="prG" x1="8" y1="6" x2="44" y2="46">
                  <stop offset="0%" stop-color="#6B93FF"/>
                  <stop offset="50%" stop-color="#976FFF"/>
                  <stop offset="100%" stop-color="#E46ACE"/>
                </linearGradient>
              </defs>
              <path d="M26 5L9 21l17 26 17-26L26 5z" fill="url(#prG)"/>
              <path d="M26 5l17 16L26 47V5z" fill="#A78BFA" opacity="0.3"/>
              <path d="M15 21l11-11 11 11" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Цены -->
  <section class="prem-pricing">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Цены</span>
        <h2 class="section-title">Цены на Telegram Premium</h2>
        <p class="section-subtitle">Чем дольше срок подписки, тем выгоднее цена</p>
      </div>
      <div class="pricing-table-wrap fade-in">
        <table class="pricing-table">
          <thead>
            <tr><th>Срок</th><th>В месяц</th><th>Всего</th></tr>
          </thead>
          <tbody>
            {plans.map((p) => (
              <tr class={p.best ? 'pricing-highlight' : undefined}>
                <td>
                  {p.months} мес.
                  {p.best && <span class="pricing-badge">Выгоднее всего</span>}
                </td>
                <td class="pricing-permonth">~{perMonth(p)} сум</td>
                <td>{fmt(p.price)} сум</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pricing-note fade-in">
        В цену включены все способы оплаты (Uzcard, Humo, Click) — без скрытых комиссий.
        На тарифе 12 месяцев один месяц обходится примерно на {monthlySaving} сум дешевле, чем на тарифе 3 месяца.
        Все цены сервиса собраны на <a href="/ru/narxlar">странице цен</a>.
      </p>
      <div class="pricing-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#9889; Купить Premium</a>
      </div>
    </div>
  </section>

  <!-- Способы оплаты -->
  <section class="prem-pay">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Оплата</span>
        <h2 class="section-title">Uzcard, Humo и Click — в сумах</h2>
        <p class="section-subtitle">Зарубежная карта и конвертация валюты не нужны</p>
      </div>
      <div class="pay-grid">
        <div class="pay-card fade-in">
          <h3>Местные карты</h3>
          <p>
            Карты Uzcard и Humo поддерживаются полностью. Официальный способ
            (App Store / Google Play) требует международную карту — Uzcard и Humo
            там не принимаются, а собственный <strong>@PremiumBot</strong> Telegram
            из Узбекистана чаще всего не работает. StarsJoy закрывает именно этот пробел.
          </p>
        </div>
        <div class="pay-card fade-in">
          <h3>Из любого приложения</h3>
          <p>
            Перевод можно сделать из Click, Payme, Uzum или приложения вашего банка —
            разницы нет. Важно одно: деньги должны прийти на карту, указанную в окне
            заказа, и <strong>ровно на указанную сумму</strong>.
          </p>
        </div>
        <div class="pay-card fade-in">
          <h3>Без регистрации</h3>
          <p>
            Пароль, создание аккаунта или документы не требуются. Достаточно вашего
            аккаунта Telegram и местной карты. Весь процесс занимает обычно 2-3 минуты.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Преимущества Premium -->
  <section class="prem-benefits">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Преимущества</span>
        <h2 class="section-title">Что даёт Telegram Premium?</h2>
        <p class="section-subtitle">Все возможности, которые открывает Premium подписка</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-file">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M7 4h10l6 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2"/><path d="M17 4v6h6" stroke="currentColor" stroke-width="2"/></svg>
          </div>
          <h3>Файлы до 4 ГБ</h3>
          <p>Загружайте и отправляйте файлы размером до 4 ГБ</p>
        </div>
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-speed">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M15 5L7 16h6l-2 7 8-11h-6l2-7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </div>
          <h3>Быстрая загрузка</h3>
          <p>Скачивайте файлы на максимальной скорости</p>
        </div>
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-noads">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="2"/><path d="M7 21L21 7" stroke="currentColor" stroke-width="2"/></svg>
          </div>
          <h3>Без рекламы</h3>
          <p>Избавьтесь от всей рекламы в каналах Telegram</p>
        </div>
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-sticker">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="2"/><path d="M10 16c1.5 2 5.5 2 7 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="10.5" cy="12" r="1.5" fill="currentColor"/><circle cx="17.5" cy="12" r="1.5" fill="currentColor"/></svg>
          </div>
          <h3>Эксклюзивные стикеры</h3>
          <p>Уникальные стикеры и реакции только для Premium пользователей</p>
        </div>
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-profile">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="11" r="5" stroke="currentColor" stroke-width="2"/><path d="M6 24c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3>Значок Premium</h3>
          <p>Значок Premium в профиле, анимированный аватар и био</p>
        </div>
        <div class="benefit-card fade-in">
          <div class="benefit-icon bi-translate">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 7h12M10 4v3M7 7c0 4 3 8 7 10M15 7c0 4-3 8-7 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 18l3-6 3 6M17 16h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3>Перевод сообщений</h3>
          <p>Переводите сообщения на любой язык одним нажатием</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Как купить -->
  <section class="prem-how">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Инструкция</span>
        <h2 class="section-title">Как купить Telegram Premium?</h2>
        <p class="section-subtitle">Оформите подписку за 3 простых шага через нашего бота</p>
      </div>
      <div class="how-steps">
        <div class="how-step fade-in">
          <div class="how-step-num">1</div>
          <h3>Откройте бота</h3>
          <p>Перейдите в <strong>@starsjoybot</strong> и выберите «Купить Premium»</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">2</div>
          <h3>Выберите срок</h3>
          <p>Выберите подписку на 3 месяца, 6 месяцев или 12 месяцев</p>
        </div>
        <div class="how-step fade-in">
          <div class="how-step-num">3</div>
          <h3>Оплатите и получите</h3>
          <p>Оплатите через Uzcard, Click или Humo — Premium активируется за 10 секунд</p>
        </div>
      </div>
      <div class="how-cta fade-in">
        <a href="https://telegram.me/starsjoybot" class="btn-primary" target="_blank">&#9889; Начать сейчас</a>
        <p class="how-guide-note"><a href="/ru/qollanma#premium">Посмотреть каждый шаг со скриншотом &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- Гарантии и доверие -->
  <section class="prem-trust">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Гарантии</span>
        <h2 class="section-title">Почему через StarsJoy?</h2>
        <p class="section-subtitle">Что мы делаем для безопасности ваших денег и аккаунта</p>
      </div>
      <div class="trust-grid">
        <div class="trust-item fade-in">
          <span class="trust-num">8 000+</span>
          <h3>Выполненных заказов</h3>
          <p>Сервис работает больше года, число заказов показано открыто.</p>
        </div>
        <div class="trust-item fade-in">
          <span class="trust-num">1-5 мин</span>
          <h3>Срок доставки</h3>
          <p>После подтверждения оплаты подписка обычно приходит за 10 секунд.</p>
        </div>
        <div class="trust-item fade-in">
          <span class="trust-num">100%</span>
          <h3>Возврат средств</h3>
          <p>Если услуга не оказана или возникла проблема, сумма возвращается полностью.</p>
        </div>
        <div class="trust-item fade-in">
          <span class="trust-num">5%</span>
          <h3>Реферальный бонус</h3>
          <p>Если по вашей ссылке кто-то купит, 5% от суммы вернётся вам бонусом.</p>
        </div>
      </div>
      <p class="trust-note fade-in">
        Отзывы проходят модерацию и публикуются с датой — прочитать их полностью можно
        на <a href="/ru/sharhlar">странице отзывов</a>. StarsJoy не является официальным
        партнёром Telegram: согласно пункту 2.3 <a href="/ru/oferta">оферты</a>, сервис
        работает как независимый реселлер через официальный API Telegram и инфраструктуру
        Fragment — подписка привязывается к вашему настоящему аккаунту официальным путём.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="prem-faq">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Вопросы о Telegram Premium</h2>
        <p class="section-subtitle">Ответы на самые частые вопросы о Premium подписке</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item fade-in">
            <button class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Отзывы (компонент) -->
  <Reviews lang="ru" />

  <!-- Связанные материалы -->
  <section class="prem-related">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Подробнее</span>
        <h2 class="section-title">Дополнительные руководства о Premium</h2>
      </div>
      <ul class="related-list fade-in">
