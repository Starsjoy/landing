---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Guarantees from '../components/Guarantees.astro';
import Referral from '../components/Referral.astro';
import Reviews from '../components/Reviews.astro';
import BlogHighlights from '../components/BlogHighlights.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { getApprovedReviews, aggregateOf } from '../lib/reviews';
import { hreflangsFor } from '../lib/i18n';

// Bosh sahifada AggregateRating: /sharhlar da allaqachon bor edi, lekin AI
// modellari va qidiruv tizimlari saytning asosiy entity'sini bosh sahifadan
// oladi. Raqamlar DB'dan olinadi — qo'lda yozilsa eskirib qoladi.
// getApprovedReviews o'zi keshlangan va xatoni yutadi, shuning uchun DB
// tushib qolsa ham sahifa buzilmaydi (agg.reviewCount = 0 bo'ladi).
const agg = aggregateOf(await getApprovedReviews('premium'));
---

<Layout
  title="Telegram Stars, Premium va Gifts - StarsJoy"
  canonical="https://starsjoy.uz"
  hreflangs={hreflangsFor('/')}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "StarsJoy",
    "url": "https://starsjoy.uz",
    "description": "StarsJoy — O'zbekistonda Telegram Stars, Premium va Gifts xizmatlarini taqdim etuvchi platforma. Tez, ishonchli va arzon narxlarda.",
    "publisher": {
      "@type": "Organization",
      "name": "StarsJoy",
      "url": "https://starsjoy.uz",
      "logo": "https://starsjoy.uz/logo.png"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "StarsJoy",
    "url": "https://starsjoy.uz",
    "logo": "https://starsjoy.uz/logo.png",
    "description": "O'zbekistonda Telegram Stars, Premium va Gifts xizmatlarini so'mda sotib olish platformasi. 8,000+ bajarilgan buyurtma.",
    "areaServed": { "@type": "Country", "name": "Uzbekistan" },
    "sameAs": [
      "https://telegram.me/starsjoybot",
      "https://telegram.me/starsjoy"
    ],
    ...(agg.reviewCount > 0 && {
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: String(agg.ratingValue),
        reviewCount: String(agg.reviewCount),
        bestRating: "5",
      },
    }),
  })} />
  <Navbar />
  <Hero />
  <Services />
  <HowItWorks />
  <Guarantees />
  <Reviews lang="uz" />
  <Referral />
  <BlogHighlights lang="uz" />
  <FAQ />
  <CTA />
  <Footer />
</Layout>
