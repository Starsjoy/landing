  },
  {
    q: "Nega 1000 ta Stars eng mashhur paket hisoblanadi?",
    a: "1000 ta — kichik sinov miqdoridan (100-500) ko'ra ancha zaxirali, lekin 5000/10 000 tadek katta bir martalik to'lov talab qilmaydigan o'rtacha nuqta. Ko'p foydalanuvchi kanal to'lovlari, bot xizmatlari va sovg'a qilish uchun aynan shu miqdorni tanlaydi."
  },
  {
    q: "1000 ta Stars qancha vaqtda va qanday yetkaziladi?",
    a: "To'lov tasdiqlangandan so'ng odatda 10 soniya ichida Telegram Stars hisobingizga to'g'ridan-to'g'ri tushadi — @starsjoybot orqali."
  },
  {
    q: "1000 ta Stars'ni do'stimga sovg'a qilsam bo'ladimi?",
    a: "Ha, botda 'Sovg'a qilish' orqali istalgan Telegram foydalanuvchisiga 1000 ta Stars'ni yuborishingiz mumkin — bu Telegram ichidagi mashhur hadyalardan biri."
  },
  {
    q: "1000 ta Stars'ni Uzcard yoki Humo bilan sotib olsam bo'ladimi?",
    a: "Ha, 240 000 so'm to'liq Uzcard, Humo, Click yoki Payme orqali to'lanadi — xorijiy karta va valyuta konvertatsiyasi shart emas."
  },
  {
    q: "1000 ta Stars'ni yechib olish (withdrawal) mumkinmi?",
    a: "Stars'ni pulga aylantirish Telegram'ning o'z tizimi orqali (kontentmeykerlar uchun) amalga oshiriladi va odatda minimal chegara talab qiladi. StarsJoy orqali sotib olingan Stars oddiy foydalanuvchi balansiga tushadi va Telegram ichida sarflash uchun mo'ljallangan."
  }
];

const siblings = [
  { href: "/stars/100", label: "100 ⭐" },
  { href: "/stars/500", label: "500 ⭐" },
  { href: "/stars/1000", label: "1000 ⭐", active: true },
  { href: "/stars/5000", label: "5000 ⭐" },
  { href: "/stars/10000", label: "10 000 ⭐" },
];

const trustItems = [
  { num: "8 000+", title: "Bajarilgan buyurtma", text: "Xizmat 1 yildan ortiq ishlaydi, buyurtmalar soni ochiq." },
  { num: "10 son.", title: "Yetkazish vaqti", text: "To'lov tasdiqlangach Stars odatda 10 soniyada tushadi." },
  { num: "100%", title: "Pul qaytarish", text: "Xizmat ko'rsatilmasa, to'langan summa to'liq qaytariladi." },
];

const related = [
  { href: "/blog/telegram-1000-stars-sotib-olish", label: "1000 Stars haqida to'liq qo'llanma" },
  { href: "/blog/telegram-stars-paketlari-taqqoslash", label: "Stars paketlarini taqqoslash — qaysi biri qachon mos?" },
  { href: "/stars", label: "Barcha Stars paketlari" },
  { href: "/narxlar", label: "Stars va Premium — barcha narxlar" },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords="1000 Telegram Stars, 1000 stars narxi, 1000 ta stars sotib olish, Telegram Stars 1000 dona, eng mashhur stars paket"
  hreflangs={hreflangsFor('/stars/1000')}
>
  <Navbar />
  <VariantPage
    accent="gold"
    canonical={canonical}
    homeLabel="Bosh sahifa"
    hubLabel="Telegram Stars"
    hubHref="/stars"
    currentLabel="1000 ⭐"
    eyebrow="Telegram Stars — 1000 ta"
    h1="1000 ta Telegram Stars sotib olish"
    quickAnswer="1000 ta Telegram Stars narxi — 240 000 so'm, @starsjoybot orqali 10 soniyada hisobingizga tushadi."
    heroNote="StarsJoy'ning eng mashhur paketi — kichik sinov miqdoridan zaxirali, katta optom xariddan tejamkor."
    siblingsTitle="Boshqa miqdorlar"
    siblings={siblings}
    priceLabel="Narx"
    priceValue="240 000 so'm"
    priceSubtext="240 so'm/star — Mashhur"
    ctaLabel="1000 ta Stars sotib olish"
    ctaHref="https://telegram.me/starsjoybot"
    forWhomTitle="Kimga mos?"
    forWhomText="1000 ta Stars — bot xizmatlaridan muntazam foydalanadigan, kanallarni qo'llab-quvvatlaydigan yoki sovg'a sifatida yubormoqchi bo'lgan foydalanuvchilar orasida eng ko'p tanlanadigan miqdor."
    trustItems={trustItems}
    faqTitle="1000 ta Stars haqida savollar"
    faqSubtitle="Eng ko'p so'raladigan savollarga javoblar"
    faqs={faqs}
    relatedTitle="Stars haqida qo'shimcha"
    related={related}
    finalCtaTitle="1000 ta Stars'ga tayyor bo'ling"
    finalCtaText="240 000 so'm, Uzcard/Click orqali, 10 soniyada yetkaziladi"
    finalCtaLabel="Hozir sotib olish"
    schemaName="Telegram Stars — 1000 ta"
    schemaDescription={description}
    priceAmount="240000"
    breadcrumbSchema={[
      { name: "Bosh sahifa", item: "https://starsjoy.uz" },
      { name: "Telegram Stars", item: "https://starsjoy.uz/stars" },
      { name: "1000 ta", item: canonical },
    ]}
  />
  <Footer />
</Layout>
