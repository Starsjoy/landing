    faqTitle="5000 ta Stars haqida savollar"
    faqSubtitle="Eng ko'p so'raladigan savollarga javoblar"
    faqs={faqs}
    relatedTitle="Stars haqida qo'shimcha"
    related={related}
    finalCtaTitle="5000 ta Stars'ga tayyor bo'ling"
    finalCtaText="1 200 000 so'm, Uzcard/Click orqali, 10 soniyada yetkaziladi"
    finalCtaLabel="Hozir sotib olish"
    schemaName="Telegram Stars — 5000 ta"
    schemaDescription={description}
    priceAmount="1200000"
    breadcrumbSchema={[
      { name: "Bosh sahifa", item: "https://starsjoy.uz" },
      { name: "Telegram Stars", item: "https://starsjoy.uz/stars" },
      { name: "5000 ta", item: canonical },
    ]}
  />
  <Footer />
</Layout>
