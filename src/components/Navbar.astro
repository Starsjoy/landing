---
import NavbarBase from './NavbarBase.astro';
import { UZ_TO_EN } from '../lib/i18n';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ruPath = currentPath === '/' ? '/ru' : `/ru${currentPath}`;
const enPath = UZ_TO_EN[currentPath];

const items = [
  { label: 'Asosiy', href: '/', icon: 'home' },
  {
    label: 'Stars', href: '/stars', icon: 'star',
    title: 'Telegram Stars', desc: 'O‘zingizga mos paketni tanlang', allLabel: 'Barcha paketlar',
    children: [
      { label: '100 ⭐', href: '/stars/100' },
      { label: '500 ⭐', href: '/stars/500-ta' },
      { label: '1000 ⭐', href: '/stars/1000' },
      { label: '5000 ⭐', href: '/stars/5000' },
      { label: '10 000 ⭐', href: '/stars/10000' },
    ],
  },
  {
    label: 'Premium', href: '/premium', icon: 'crown',
    title: 'Telegram Premium', desc: 'Obuna muddatini tanlang', allLabel: 'Barcha tariflar',
    children: [
      { label: '3 oylik', href: '/premium/3-oy' },
      { label: '6 oylik', href: '/premium/6-oy' },
      { label: '12 oylik', href: '/premium/12-oy' },
    ],
  },
  { label: 'Gifts', href: '/gifts', icon: 'gift' },
  { label: 'Narxlar', href: '/narxlar', icon: 'tag' },
  { label: 'Qo‘llanma', href: '/qollanma', icon: 'book' },
  { label: 'Kafolatlar', href: '/#guarantees', icon: 'shield' },
  { label: 'Fikrlar', href: '/sharhlar', icon: 'chat' },
  { label: 'Blog', href: '/blog', icon: 'pen' },
];

const langs = [
  { code: 'UZ', label: 'O‘zbekcha', href: currentPath, current: true },
  { code: 'RU', label: 'Русский', href: ruPath },
  ...(enPath ? [{ code: 'EN', label: 'English', href: enPath }] : []),
];
---

<NavbarBase
  homeHref="/"
  items={items}
  langs={langs}
  ctaLabel="Botga o‘tish"
  menuLabel="Menyu"
  closeLabel="Menyuni yopish"
  langLabel="Tilni tanlash"
/>
