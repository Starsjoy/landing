---
import { UZ_TO_EN } from '../lib/i18n';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ruPath = currentPath === '/' ? '/ru' : `/ru${currentPath}`;
const enPath = UZ_TO_EN[currentPath];
---

<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/logo.png" alt="StarsJoy" class="logo-img" />
      <span>StarsJoy</span>
    </a>
    <ul class="nav-links">
      <li><a href="/">Asosiy</a></li>
      <li class="has-dropdown">
        <a href="/stars">Stars <span class="caret">&#9662;</span></a>
        <ul class="dropdown-menu">
          <li><a href="/stars/100">100 ⭐</a></li>
          <li><a href="/stars/500-ta">500 ⭐</a></li>
          <li><a href="/stars/1000">1000 ⭐</a></li>
          <li><a href="/stars/5000">5000 ⭐</a></li>
          <li><a href="/stars/10000">10 000 ⭐</a></li>
          <li class="dropdown-all"><a href="/stars">Barcha paketlar &rarr;</a></li>
        </ul>
      </li>
      <li class="has-dropdown">
        <a href="/premium">Premium <span class="caret">&#9662;</span></a>
        <ul class="dropdown-menu">
          <li><a href="/premium/3-oy">3 oylik</a></li>
          <li><a href="/premium/6-oy">6 oylik</a></li>
          <li><a href="/premium/12-oy">12 oylik</a></li>
          <li class="dropdown-all"><a href="/premium">Barcha tariflar &rarr;</a></li>
        </ul>
      </li>
      <li><a href="/gifts">Gifts</a></li>
      <li><a href="/narxlar">Narxlar</a></li>
      <li><a href="/qollanma">Qo'llanma</a></li>
      <li><a href="/#guarantees">Kafolatlar</a></li>
      <li><a href="/sharhlar">Fikrlar</a></li>
      <li><a href="/blog">Blog</a></li>
      <li class="mobile-menu-cta"><a href="https://telegram.me/starsjoybot" class="nav-cta" target="_blank">Botga o'tish</a></li>
    </ul>
    <div class="nav-right">
      <a href={ruPath} class="lang-switch desktop-lang">🇷🇺</a>
      {enPath && <a href={enPath} class="lang-switch desktop-lang" hreflang="en" aria-label="English">🇬🇧</a>}
      <a href="https://telegram.me/starsjoybot" class="nav-cta" target="_blank">Botga o'tish</a>
    </div>
    <div class="mobile-actions">
      <a href={ruPath} class="lang-switch mobile-lang">🇷🇺</a>
      {enPath && <a href={enPath} class="lang-switch mobile-lang" hreflang="en" aria-label="English">🇬🇧</a>}
      <button class="mobile-toggle" aria-label="Menu">
        <span class="hamburger"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 50);
    navLinks?.classList.remove('show');
    toggle?.classList.remove('active');
  });

  const toggle = document.querySelector('.mobile-toggle');
  const navLinks = document.querySelector('.nav-links');
  toggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('show');
    toggle.classList.toggle('active');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav-links') && !target.closest('.mobile-toggle')) {
      navLinks?.classList.remove('show');
      toggle?.classList.remove('active');
    }
  });

  document.querySelectorAll('.has-dropdown > a .caret').forEach((caret) => {
    caret.addEventListener('click', (e) => {
      if (window.innerWidth > 768) return;
      e.preventDefault();
      e.stopPropagation();
      (caret as HTMLElement).closest('.has-dropdown')?.classList.toggle('open');
    });
  });
</script>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 16px 0;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }
  nav.scrolled {
    padding: 10px 0;
    border-bottom-color: var(--border);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
  }

  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.4rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--text);
  }
  .logo-img {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    object-fit: cover;
  }

  .nav-links {
    display: flex;
    gap: 26px;
    list-style: none;
    white-space: nowrap;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--primary); }

  .has-dropdown { position: relative; }
  .has-dropdown > a { display: flex; align-items: center; gap: 4px; }
  .caret { font-size: 0.65rem; transition: transform 0.2s; }
  .has-dropdown:hover .caret { transform: rotate(180deg); }
  .dropdown-menu {
    list-style: none;
    margin: 0; padding: 8px;
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    min-width: 160px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateX(-50%) translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 10;
  }
  .has-dropdown:hover .dropdown-menu {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-menu li { white-space: nowrap; }
  .dropdown-menu a {
    display: block; padding: 8px 12px; border-radius: 6px;
    font-size: 0.9rem; color: var(--text);
  }
  .dropdown-menu a:hover { background: var(--bg-alt); color: var(--primary); }
  .dropdown-all { border-top: 1px solid var(--border-light); margin-top: 4px; padding-top: 4px; }
  .dropdown-all a { color: var(--primary); font-weight: 600; }

  .lang-switch {
    padding: 0;
    background: none;
    font-size: 1.2rem !important;
    line-height: 1;
    text-decoration: none !important;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-cta {
    padding: 10px 24px;
    background: var(--gradient);
    border: none;
    border-radius: 50px;
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3);
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 12px;
  }

  .mobile-lang {
    display: none;
  }
  .mobile-menu-cta {
    display: none;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 32px;
    height: 32px;
    position: relative;
  }
  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.3s;
    position: absolute;
    left: 5px;
  }
  .hamburger { top: 15px; }
  .hamburger::before { content: ''; top: -7px; }
  .hamburger::after { content: ''; top: 7px; }

  .mobile-toggle.active .hamburger { background: transparent; }
  .mobile-toggle.active .hamburger::before { top: 0; transform: rotate(45deg); }
  .mobile-toggle.active .hamburger::after { top: 0; transform: rotate(-45deg); }

  @media (min-width: 769px) and (max-width: 1120px) {
    .nav-links { gap: 17px; }
    .nav-links a { font-size: 0.87rem; }
    .nav-right { gap: 12px; }
    .nav-cta { padding: 9px 18px; font-size: 0.85rem; }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: flex;
      flex-direction: column;
      white-space: normal;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 0 24px;
      gap: 0;
      border-bottom: 1px solid transparent;
      box-shadow: none;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.35s ease, gap 0.35s ease;
    }
    .nav-links.show {
      max-height: 80vh;
      overflow-y: auto;
      opacity: 1;
      padding: 24px;
      gap: 20px;
      border-bottom-color: var(--border);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
    .nav-right { display: none; }
    .mobile-actions { display: flex; }
    .mobile-lang { display: inline-block; }
    .mobile-menu-cta { display: list-item; list-style: none; }
    .mobile-menu-cta .nav-cta { display: inline-flex; text-align: center; justify-content: center; width: 100%; color: #fff; }
    .mobile-toggle { display: block; }

    .has-dropdown > a { justify-content: space-between; }
    .has-dropdown > a .caret { padding: 6px 10px; margin: -6px -10px; }
    .dropdown-menu {
      position: static; transform: none; opacity: 1; visibility: visible; pointer-events: auto;
      box-shadow: none; border: none; border-left: 2px solid var(--border);
      border-radius: 0; margin: 0 0 0 8px; padding: 0 0 0 12px;
      background: none;
      max-height: 0; overflow: hidden;
      transition: max-height 0.3s ease, margin 0.3s ease;
    }
    .has-dropdown.open > a .caret { transform: rotate(180deg); }
    .has-dropdown.open .dropdown-menu { max-height: 320px; margin: 4px 0 8px 8px; }
    .dropdown-menu a { padding: 8px 4px; font-size: 0.88rem; color: var(--text-muted); }
    .dropdown-all { border-top: none; margin-top: 0; padding-top: 0; }
  }
</style>
