---
import NavbarBase from './NavbarBase.astro';
import { UZ_TO_EN } from '../lib/i18n';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const uzPath = currentPath.replace(/^\/ru/, '') || '/';
const enPath = UZ_TO_EN[uzPath];

const items = [
  { label: 'Главная', href: '/ru', icon: 'home' },
  {
    label: 'Stars', href: '/ru/stars', icon: 'star',
    title: 'Telegram Stars', desc: 'Выберите подходящий пакет', allLabel: 'Все пакеты',
    children: [
      { label: '100 ⭐', href: '/ru/stars/100' },
      { label: '500 ⭐', href: '/ru/stars/500-ta' },
      { label: '1000 ⭐', href: '/ru/stars/1000' },
      { label: '5000 ⭐', href: '/ru/stars/5000' },
      { label: '10 000 ⭐', href: '/ru/stars/10000' },
    ],
  },
  {
    label: 'Premium', href: '/ru/premium', icon: 'crown',
    title: 'Telegram Premium', desc: 'Выберите срок подписки', allLabel: 'Все тарифы',
    children: [
      { label: '3 месяца', href: '/ru/premium/3-oy' },
      { label: '6 месяцев', href: '/ru/premium/6-oy' },
      { label: '12 месяцев', href: '/ru/premium/12-oy' },
    ],
  },
  { label: 'Gifts', href: '/ru/gifts', icon: 'gift' },
  { label: 'Цены', href: '/ru/narxlar', icon: 'tag' },
  { label: 'Инструкция', href: '/ru/qollanma', icon: 'book' },
  { label: 'Гарантии', href: '/ru#guarantees', icon: 'shield' },
  { label: 'Отзывы', href: '/ru/sharhlar', icon: 'chat' },
  { label: 'Блог', href: '/ru/blog', icon: 'pen' },
];

const langs = [
  { code: 'UZ', label: 'O‘zbekcha', href: uzPath },
  { code: 'RU', label: 'Русский', href: currentPath, current: true },
  ...(enPath ? [{ code: 'EN', label: 'English', href: enPath }] : []),
];
---

<NavbarBase
  homeHref="/ru"
  items={items}
  langs={langs}
  ctaLabel="Перейти в бот"
  menuLabel="Меню"
  closeLabel="Закрыть меню"
  langLabel="Выбрать язык"
/>
