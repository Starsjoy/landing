---
/**
 * Umumiy navbar (UZ / RU / EN).
 *
 * Navbar.astro, NavbarRu.astro va NavbarEn.astro faqat matn va havolalarni
 * beradi — dizayn va xatti-harakat shu yerda, bitta joyda.
 *
 * Logo: /logo-mark.svg — faqat belgining o'zi (ortiqcha fon/soya yo'q), hover animatsiyasiz.
 * Desktop: sahifa tepasida to'liq kenglikdagi panel; scroll qilinganda
 * torayib, yumaloq burchakli "suzuvchi" shisha (glass) panelga aylanadi.
 * Stars/Premium uchun kartochkali dropdown, ixcham til tanlagich.
 * Mobil (≤1100px): navbar ostidan tepadan tushadigan suzuvchi glass kartochka.
 * Navbar ko'rinib qoladi, burger ✕ ga aylanadi; akkordeonsiz (paketlar darhol
 * ko'rinadi). Yopish: ✕, fonga bosish, Esc yoki havolani tanlash.
 */
type Child = { label: string; href: string };
type Item = {
  label: string;
  href: string;
  icon: string;
  title?: string;
  desc?: string;
  children?: Child[];
  allLabel?: string;
};
type Lang = { code: string; label: string; href: string; current?: boolean };

interface Props {
  homeHref: string;
  items: Item[];
  langs: Lang[];
  ctaLabel: string;
  menuLabel: string;
  closeLabel: string;
  langLabel: string;
}

const { homeHref, items, langs, ctaLabel, menuLabel, closeLabel, langLabel } = Astro.props;

const BOT_URL = 'https://telegram.me/starsjoybot';

const ICONS: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  crown: '<path d="m3 7 4.5 4L12 4l4.5 7L21 7l-2 12H5z"/>',
  gift: '<path d="M4 11h16v10H4zM2 7h20v4H2zM12 7v14M12 7S10.5 3 8 3a2 2 0 0 0 0 4M12 7s1.5-4 4-4a2 2 0 0 1 0 4"/>',
  tag: '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9zM7.5 7.5h.01"/>',
  book: '<path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H20v15H5.5A1.5 1.5 0 0 0 4 19.5zM4 19.5A1.5 1.5 0 0 0 5.5 21H20v-3"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6zM8.5 12l2.5 2.5 4.5-5"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/>',
  pen: '<path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"/>',
  info: '<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v5M12 8h.01"/>',
  help: '<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17h.01"/>',
};
const TG_PATH = 'M21.4 4.6 2.9 11.8c-1.2.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.5c.2.6.4.8.9.8.4 0 .6-.2.8-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.5-1.8-1.4-1.4ZM8.9 14.4l8.6-5.4c.4-.3.8-.1.5.2l-7 6.4-.3 3.1z';

// Bayroqlar inline SVG — emoji bayroqlar Windows'da ko'rinmaydi
const FLAGS: Record<string, string> = {
  UZ: '<rect width="24" height="16" fill="#fff"/><rect width="24" height="5.2" fill="#0099B5"/><rect y="10.8" width="24" height="5.2" fill="#1EB53A"/><rect y="5.2" width="24" height=".5" fill="#CE1126"/><rect y="10.3" width="24" height=".5" fill="#CE1126"/>',
  RU: '<rect width="24" height="16" fill="#fff"/><rect y="5.33" width="24" height="5.34" fill="#0039A6"/><rect y="10.67" width="24" height="5.33" fill="#D52B1E"/>',
  EN: '<rect width="24" height="16" fill="#012169"/><path d="M0 0l24 16M24 0 0 16" stroke="#fff" stroke-width="3.2"/><path d="M0 0l24 16M24 0 0 16" stroke="#C8102E" stroke-width="1.2"/><path d="M12 0v16M0 8h24" stroke="#fff" stroke-width="5"/><path d="M12 0v16M0 8h24" stroke="#C8102E" stroke-width="3"/>',
};

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === homeHref) return currentPath === homeHref;
  return currentPath === href || currentPath.startsWith(href + '/');
};
const currentLang = langs.find((l) => l.current) ?? langs[0];
const products = items.filter((i) => i.children);
// Mobil menyuda bosh sahifa plitkasi yo'q — unga logotip orqali o'tiladi
const links = items.filter((i) => !i.children && i.href !== homeHref);
---

<header id="navbar">
  <div class="nav-bar">
    <div class="nav-inner">
      <a href={homeHref} class="logo" aria-label="StarsJoy">
        <img src="/logo-mark.svg" alt="" width="36" height="36" class="logo-img" />
        <span>Stars<span class="logo-accent">Joy</span></span>
      </a>

      <nav class="desk-nav" aria-label="Main">
        <ul class="desk-links">
          {items.map((item) => (
            <li class={item.children ? 'has-dd' : undefined}>
              <a
                href={item.href}
                class:list={['desk-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.children && (
                  <svg class="chev" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
              </a>
              {item.children && (
                <div class="dd">
                  <div class="dd-card">
                    <div class="dd-head">
                      <span class={`dd-badge dd-badge--${item.icon}`}>
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={ICONS[item.icon]} />
                      </span>
                      <div>
                        <div class="dd-title">{item.title ?? item.label}</div>
                        {item.desc && <div class="dd-desc">{item.desc}</div>}
                      </div>
                    </div>
                    <div class={`dd-grid ${item.children.length > 3 ? 'dd-grid--2' : ''}`}>
                      {item.children.map((c) => (
                        <a href={c.href} class:list={['dd-tile', { active: currentPath === c.href }]}>
                          <span>{c.label}</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </a>
                      ))}
                    </div>
                    <a href={item.href} class="dd-all">{item.allLabel} <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav-actions">
        {langs.length > 1 && (
          <div class="lang has-dd">
            <button class="lang-btn" type="button" aria-label={langLabel} aria-haspopup="true" aria-expanded="false">
              <svg class="flag" width="20" height="14" viewBox="0 0 24 16" aria-hidden="true" set:html={FLAGS[currentLang.code]} />
              <span>{currentLang.code}</span>
              <svg class="chev" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="dd dd--right">
              <div class="dd-card dd-card--lang">
                {langs.map((l) => (
                  <a href={l.href} hreflang={l.code.toLowerCase()} class:list={['lang-opt', { active: l.current }]} aria-current={l.current ? 'true' : undefined}>
                    <span class="lang-name"><svg class="flag" width="20" height="14" viewBox="0 0 24 16" aria-hidden="true" set:html={FLAGS[l.code]} />{l.label}</span><small>{l.code}</small>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )}
        <a href={BOT_URL} class="nav-cta" target="_blank" rel="noopener" aria-label={ctaLabel}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d={TG_PATH} fill="currentColor" /></svg>
          <span class="nav-cta-text">{ctaLabel}</span>
        </a>
        <button class="burger" type="button" aria-label={menuLabel} data-open-label={menuLabel} data-close-label={closeLabel} aria-controls="nav-sheet" aria-expanded="false">
          <span class="burger-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </div>
  </div>

  <div class="nav-overlay" data-close></div>

  <div id="nav-sheet" class="sheet" role="dialog" aria-modal="true" aria-label={menuLabel} aria-hidden="true" inert>
    <div class="sheet-body">
      {products.map((p) => (
        <section class={`p-card p-card--${p.icon}`}>
          <a href={p.href} class="p-head" aria-label={`${p.title ?? p.label} — ${p.allLabel}`}>
            <span class="p-badge">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={ICONS[p.icon]} />
            </span>
            <span class="p-text">
              <strong>{p.title ?? p.label}</strong>
              {p.desc && <small>{p.desc}</small>}
            </span>
            <span class="p-all" title={p.allLabel}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </a>
          <div class="p-chips">
            {p.children!.map((c) => (
              <a href={c.href} class:list={['p-chip', { active: currentPath === c.href }]}>{c.label}</a>
            ))}
          </div>
        </section>
      ))}

      <div class="q-grid">
        {links.map((l) => (
          <a href={l.href} class:list={['q-tile', `q-tile--${l.icon}`, { active: isActive(l.href) }]}>
            <span class="q-ico">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={ICONS[l.icon]} />
            </span>
            <span class="q-label">{l.label}</span>
          </a>
        ))}
      </div>

      {langs.length > 1 && (
        <div class="m-langs" role="group" aria-label={langLabel}>
          {langs.map((l) => (
            <a href={l.href} hreflang={l.code.toLowerCase()} class:list={['m-lang', { active: l.current }]}>{l.code}</a>
          ))}
        </div>
      )}
    </div>

    <div class="sheet-foot">
      <a href={BOT_URL} class="nav-cta nav-cta--block" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={TG_PATH} fill="currentColor" /></svg>
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('navbar');
  const burger = header?.querySelector<HTMLButtonElement>('.burger');
  const sheet = header?.querySelector<HTMLElement>('.sheet');
  const body = sheet?.querySelector<HTMLElement>('.sheet-body');


  function setOpen(open: boolean) {
    if (!header || !burger || !sheet) return;
    header.classList.toggle('menu-open', open);
    burger.setAttribute('aria-expanded', String(open));
    sheet.setAttribute('aria-hidden', String(!open));
    sheet.toggleAttribute('inert', !open);
    burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? '');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open && body) body.scrollTop = 0;
  }

  burger?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
  header?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (header?.classList.contains('menu-open')) {
      setOpen(false);
      burger?.focus();
    } else if (header?.contains(document.activeElement)) {
      (document.activeElement as HTMLElement).blur();
    }
  });

  // Til dropdown'i: telefonda bosish bilan ochiladi (hover/focus iOS'da ishonchsiz)
  const lang = header?.querySelector<HTMLElement>('.lang');
  const langBtn = lang?.querySelector<HTMLButtonElement>('.lang-btn');
  const setLang = (open: boolean) => {
    lang?.classList.toggle('open', open);
    langBtn?.setAttribute('aria-expanded', String(open));
  };
  langBtn?.addEventListener('click', (e) => { e.stopPropagation(); setLang(!lang?.classList.contains('open')); });
  document.addEventListener('click', (e) => { if (!lang?.contains(e.target as Node)) setLang(false); });

  matchMedia('(min-width: 1101px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

  let queued = false;
  const sync = () => { header?.classList.toggle('scrolled', window.scrollY > 24); queued = false; };
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
  sync();
</script>

<style>
  #navbar {
    --nav-ink: var(--text);
    --nav-muted: var(--text-muted);
    --nav-line: rgba(124, 58, 237, 0.1);
    --nav-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    pointer-events: none;
  }
  #navbar > * { pointer-events: auto; }
  /* StickyBuyBar z-index: 9999 — ochiq menyu undan ham yuqorida bo'lishi kerak */
  #navbar.menu-open { z-index: 10000; }

  /* ===== Bar: tepada to'liq kenglik, scroll'da suzuvchi glass pill ===== */
  .nav-bar {
    width: 100%;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid transparent;
    border-radius: 0;
    transition:
      width 0.5s var(--nav-ease),
      margin 0.5s var(--nav-ease),
      border-radius 0.5s var(--nav-ease),
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  #navbar:is(.scrolled, .menu-open) .nav-bar {
    width: min(1180px, calc(100% - 32px));
    margin-top: 12px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(248, 246, 255, 0.48));
    backdrop-filter: saturate(200%) blur(22px);
    -webkit-backdrop-filter: saturate(200%) blur(22px);
    border-color: rgba(255, 255, 255, 0.75);
    box-shadow:
      0 12px 40px -8px rgba(26, 16, 53, 0.16),
      0 0 0 1px rgba(124, 58, 237, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    transition: height 0.5s var(--nav-ease), padding 0.5s var(--nav-ease);
  }
  #navbar:is(.scrolled, .menu-open) .nav-inner { height: 60px; padding: 0 10px 0 16px; }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--nav-ink);
    text-decoration: none;
  }
  .logo-img {
    display: block;
    width: 36px; height: 36px;
    flex-shrink: 0;
    transition: width 0.4s var(--nav-ease), height 0.4s var(--nav-ease);
  }
  #navbar:is(.scrolled, .menu-open) .logo-img { width: 32px; height: 32px; }
  .logo-accent {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ===== Desktop links ===== */
  .desk-links {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    padding: 4px;
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.045);
    border: 1px solid var(--nav-line);
    transition: background 0.4s, border-color 0.4s;
  }
  #navbar:is(.scrolled, .menu-open) .desk-links { background: rgba(255, 255, 255, 0.45); border-color: rgba(124, 58, 237, 0.08); }
  .desk-links > li { position: relative; }
  .desk-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 13px;
    border-radius: 999px;
    color: var(--nav-muted);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }
  .desk-link:hover,
  .has-dd:hover > .desk-link,
  .has-dd:focus-within > .desk-link { color: var(--nav-ink); background: rgba(255, 255, 255, 0.9); }
  .desk-link.active {
    color: var(--primary);
    background: #fff;
    box-shadow: 0 1px 2px rgba(26, 16, 53, 0.06), 0 2px 10px rgba(124, 58, 237, 0.1);
    font-weight: 600;
  }
  .chev { opacity: 0.6; transition: transform 0.25s var(--nav-ease); }
  .has-dd:hover .chev,
  .has-dd:focus-within .chev { transform: rotate(180deg); }

  /* ===== Dropdown ===== */
  .dd {
    position: absolute;
    top: 100%;
    left: 50%;
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 0.2s, transform 0.25s var(--nav-ease), visibility 0.2s;
    z-index: 10;
  }
  .dd--right { left: auto; right: 0; transform: translateY(8px); }
  .has-dd:hover > .dd,
  .has-dd:focus-within > .dd {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .has-dd:hover > .dd--right,
  .has-dd:focus-within > .dd--right { transform: translateY(0); }

  .dd-card {
    width: 300px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--nav-line);
    border-radius: 20px;
    box-shadow: 0 24px 60px -12px rgba(26, 16, 53, 0.18), 0 2px 6px rgba(26, 16, 53, 0.04);
  }
  .dd-head { display: flex; align-items: center; gap: 12px; padding: 8px 8px 14px; }
  .dd-badge {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    flex-shrink: 0;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, #F59E0B, #F97316);
    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.3);
  }
  .dd-badge svg, .p-badge svg { fill: currentColor; stroke: none; }
  .dd-badge--crown { background: var(--gradient); box-shadow: 0 6px 16px rgba(124, 58, 237, 0.3); }
  .dd-title { font-size: 0.95rem; font-weight: 700; color: var(--nav-ink); line-height: 1.2; }
  .dd-desc { font-size: 0.78rem; color: var(--text-light); margin-top: 3px; line-height: 1.3; }

  .dd-grid { display: grid; gap: 6px; }
  .dd-grid--2 { grid-template-columns: 1fr 1fr; }
  .dd-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 12px;
    border-radius: 12px;
    background: var(--bg-alt);
    color: var(--nav-ink);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .dd-tile svg { color: var(--text-light); transition: transform 0.2s, color 0.2s; }
  .dd-tile:hover, .dd-tile.active { background: #fff; border-color: rgba(124, 58, 237, 0.25); color: var(--primary); }
  .dd-tile:hover svg { color: var(--primary); transform: translate(2px, -2px); }
  .dd-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding: 11px 12px;
    border-radius: 12px;
    color: var(--primary);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .dd-all:hover { background: rgba(124, 58, 237, 0.07); }

  /* ===== Actions ===== */
  .nav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

  .lang { position: relative; }
  .lang-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--nav-line);
    background: rgba(255, 255, 255, 0.7);
    color: var(--nav-ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .lang-btn:hover, .lang:focus-within .lang-btn, .lang.open .lang-btn { border-color: rgba(124, 58, 237, 0.3); background: #fff; }
  .lang.open > .dd { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); }
  .lang.open .chev { transform: rotate(180deg); }
  .flag { display: block; width: 20px; height: 14px; flex-shrink: 0; border-radius: 3px; box-shadow: 0 0 0 1px rgba(26, 16, 53, 0.1); }
  .lang-name { display: flex; align-items: center; gap: 10px; }
  .dd-card--lang { width: 190px; padding: 6px; }
  .lang-opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--nav-ink);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }
