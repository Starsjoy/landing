    errNet: 'Ошибка соединения. Проверьте интернет и попробуйте снова.', sum: 'сум',
  },
  en: {
    s1: 'Choose a game', s2: 'Choose a pack', s3: 'Player ID', s4: 'Contact (optional)',
    currency: 'Currency', passes: 'Passes & subscriptions', popular: 'Popular',
    idPh: 'e.g. 51221257198', idWhere: 'Where is my ID?', check: 'Check', checking: 'Checking…',
    found: 'Account found', notVerified: 'This game does not show nicknames, double-check the ID', needId: 'Enter your ID',
    idHelp: {
      'pubg-mobile': 'Open the game → tap your avatar top-left. The number under your nickname is your Player ID (usually 10–11 digits).',
