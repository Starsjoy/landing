    agree: 'A top-up sent to a wrong ID cannot be refunded. Check the nickname before paying.',
    payTitle: 'Payment', payLeft: 'left', amount: 'Amount to transfer', card: 'Card', copy: 'Copy', copied: '✓ Copied',
    howPay: ['Open your banking app (Click, Payme, Uzum…)', 'Transfer to this card', 'Enter the amount exactly'],
    payWait: 'Waiting for your payment. We send the top-up automatically once it arrives.',
    payNote: 'A different or split amount will not be confirmed automatically.',
