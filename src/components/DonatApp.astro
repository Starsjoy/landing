---
/**
 * Donat do'koni: 1 o'yin → 2 paket → 3 ID (nik tekshiruvi) → 4 to'lov (karta + noyob summa, 8 daqiqa) → holat.
 * Narx va mavjudlik backend'dan (vitahealth.uz/api/donat/*); SSR katalog bo'lsa paketlar HTML'da chiqadi.
 * Lokal dev'da brauzer so'rovlari /donat-api proksi orqali ketadi (astro.config → vite.server.proxy).
 */
import { DONAT_API, fmtSum, type DonatCatalog, type DonatLang } from '../lib/donat';

interface Props {
  lang: DonatLang;
  catalog: DonatCatalog | null;
  initialGame?: string;
}
const { lang, catalog, initialGame } = Astro.props;
const API_BASE = import.meta.env.DEV ? '/donat-api' : DONAT_API;

