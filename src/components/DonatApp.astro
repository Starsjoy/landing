    linkHint: 'Open the link: list the shown skin on the in-game market at the given price and the Gold lands on your account. Do not share the link.',
    open: 'Open link', problem: 'Payment received, but delivery hit a problem. We are fixing it, your money is safe.',
    expired: 'Payment time is over. If you already transferred money, send the receipt to support.',
    support: 'Contact support', again: 'Buy again', order: 'Order',
    errNet: 'Connection error. Check your internet and try again.', sum: 'UZS',
  },
}[lang];

const UNIT: Record<string, Record<DonatLang, string>> = {
  UC: { uz: 'UC', ru: 'UC', en: 'UC' },
  Diamonds: { uz: 'olmos', ru: 'алмазов', en: 'diamonds' },
  Gold: { uz: 'Gold', ru: 'Gold', en: 'Gold' },
  'Delta Coins': { uz: 'Delta Coins', ru: 'Delta Coins', en: 'Delta Coins' },
  BC: { uz: 'BC', ru: 'BC', en: 'BC' },
  Tokens: { uz: 'token', ru: 'токенов', en: 'tokens' },
  Bonds: { uz: 'Bonds', ru: 'Bonds', en: 'Bonds' },
  Robux: { uz: 'Robux', ru: 'Robux', en: 'Robux' },
};

const SUB: Record<string, Record<DonatLang, string>> = {
  'pubg-mobile': { uz: 'UC va Prime', ru: 'UC и Prime', en: 'UC & Prime' },
  'free-fire': { uz: 'Olmos', ru: 'Алмазы', en: 'Diamonds' },
  'standoff-2': { uz: 'Gold', ru: 'Gold', en: 'Gold' },
  'mobile-legends': { uz: 'Olmos', ru: 'Алмазы', en: 'Diamonds' },
  roblox: { uz: 'Robux kodi', ru: 'Код Robux', en: 'Robux code' },
  'delta-force': { uz: 'Delta Coins', ru: 'Delta Coins', en: 'Delta Coins' },
  'blood-strike': { uz: 'BC', ru: 'BC', en: 'BC' },
  'honor-of-kings': { uz: 'Token', ru: 'Токены', en: 'Tokens' },
  'arena-breakout': { uz: 'Bonds', ru: 'Bonds', en: 'Bonds' },
};

const games = catalog?.games ?? [];
const startSlug = initialGame && games.some((g) => g.slug === initialGame) ? initialGame : games[0]?.slug || initialGame || 'pubg-mobile';
const startGame = games.find((g) => g.slug === startSlug);
const enabled = Boolean(catalog?.enabled);
---

<div
  class="dn-app"
  id="dn-app"
  data-api={API_BASE}
  data-lang={lang}
  data-game={startSlug}
  data-enabled={enabled ? '1' : '0'}
>
  <script type="application/json" id="dn-i18n" set:html={JSON.stringify({ ...T, UNIT, SUB })} />
  <script type="application/json" id="dn-catalog" set:html={JSON.stringify(catalog)} />

  <!-- ============ DO'KON ============ -->
  <div class="dn-step" id="dn-shop">
    <div class="dn-sh is-done"><span class="dn-n">1</span>{T.s1}</div>
    <div class="dn-games" id="dn-games" role="tablist">
      {games.map((g) => (
        <button type="button" class={`dn-game g-${g.slug}${g.slug === startSlug ? ' is-on' : ''}`} data-slug={g.slug} role="tab" aria-selected={g.slug === startSlug}>
          <img class="dn-game-art" src={`/images/donat/${g.slug}.png`} alt={g.title} width="64" height="64" loading="eager" decoding="async" />
          <span class="dn-game-name">{g.title}</span>
          <span class="dn-game-sub">{SUB[g.slug]?.[lang] || g.unit}</span>
        </button>
      ))}
    </div>

    <div class="dn-sh" id="dn-sh2"><span class="dn-n">2</span>{T.s2}</div>
    <div id="dn-items">
      {startGame ? (
        <div class="dn-items">
          {startGame.items.map((it, i) => (
            <button type="button" class={`dn-item${i === 0 ? ' is-on' : ''}`} data-id={it.id}>
              <span class="dn-item-name">{it.name}</span>
              <span class="dn-item-price">{fmtSum(it.price)} {T.sum}</span>
            </button>
          ))}
        </div>
      ) : <div class="dn-muted">{T.loading}</div>}
    </div>

    <div id="dn-idbox" hidden={startGame ? !startGame.needs_player_id : false}>
      <div class="dn-sh" id="dn-sh3"><span class="dn-n">3</span>{T.s3}
        <button type="button" class="dn-where" id="dn-where">{T.idWhere}</button>
      </div>
      <div class="dn-help" id="dn-help" hidden></div>
      <div class="dn-idrow" id="dn-idrow">
        <div class="dn-idwrap">
          <input id="dn-player" class="dn-input" inputmode="numeric" autocomplete="off" maxlength="40" placeholder={T.idPh} />
          <button type="button" class="dn-check" id="dn-check">{T.check}</button>
        </div>
        <input id="dn-server" class="dn-input dn-zone" inputmode="numeric" autocomplete="off" maxlength="8" placeholder={T.zonePh} aria-label={T.zone} hidden />
      </div>
      <div class="dn-nick" id="dn-nick" hidden></div>
    </div>
    <div class="dn-giftnote" id="dn-giftnote" hidden={startGame ? startGame.needs_player_id : true}>🔗 <span id="dn-giftnote-t">{T.gift}</span></div>

    <details class="dn-contact">
      <summary>{T.s4}</summary>
      <input id="dn-contact" class="dn-input" maxlength="64" placeholder={T.contactPh} />
      <div class="dn-hint">{T.contactHint}</div>
    </details>

    <div class="dn-bar" id="dn-bar">
      <div class="dn-bar-info">
        <span class="dn-bar-v" id="dn-bar-v">—</span>
        <span class="dn-bar-p" id="dn-bar-p"></span>
      </div>
      <button type="button" class="dn-pay" id="dn-pay" disabled={!enabled}>{enabled ? T.pay : T.soon}</button>
    </div>
    <p class="dn-agree">🛡️ {T.agree}</p>
    <div class="dn-err" id="dn-err" hidden></div>
  </div>

  <!-- ============ TO'LOV ============ -->
  <div class="dn-step" id="dn-payment" hidden>
    <div class="dn-pay-head">
      <div>
        <div class="dn-pay-title">{T.payTitle}</div>
        <div class="dn-what" id="dn-pay-what"></div>
      </div>
      <div class="dn-timer"><b id="dn-timer">8:00</b><span>{T.payLeft}</span></div>
    </div>
    <div class="dn-progress"><span id="dn-progress"></span></div>

    <div class="dn-amount-box">
      <div class="dn-cap">{T.amount}</div>
      <div class="dn-amount-row">
        <b class="dn-amount" id="dn-amount">—</b>
        <button type="button" class="dn-copy" data-copy="amount">{T.copy}</button>
      </div>
    </div>

    <div class="dn-bank">
      <div class="dn-bank-top"><span>{T.card}</span><span class="dn-bank-brand" id="dn-card-brand"></span></div>
      <div class="dn-bank-num" id="dn-card">—</div>
      <div class="dn-bank-bottom">
        <span id="dn-card-name"></span>
        <button type="button" class="dn-copy dn-copy-w" data-copy="card">{T.copy}</button>
      </div>
    </div>

    <ol class="dn-howpay">{T.howPay.map((s) => <li>{s}</li>)}</ol>

    <div class="dn-wait"><span class="dn-dots"><i></i><i></i><i></i></span>{T.payWait}</div>
    <p class="dn-hint">{T.payNote}</p>
    <button type="button" class="dn-link-btn" id="dn-cancel">{T.cancel}</button>
  </div>

  <!-- ============ HOLAT ============ -->
  <div class="dn-step" id="dn-status" hidden>
    <ol class="dn-track" id="dn-track">
      {T.st.map((s, i) => <li data-i={i}><span class="dn-dot"></span>{s}</li>)}
    </ol>
    <div class="dn-status-ico" id="dn-status-ico"></div>
    <div class="dn-status-text" id="dn-status-text"></div>
    <div class="dn-what dn-center" id="dn-status-what"></div>
    <div class="dn-linkbox" id="dn-codebox" hidden>
      <div class="dn-cap">🎟️ {T.codeTitle}</div>
      <div class="dn-code-row"><code class="dn-code" id="dn-code"></code><button type="button" class="dn-copy" id="dn-code-copy">{T.copy}</button></div>
      <a class="dn-ghost dn-pay-full" href="https://www.roblox.com/redeem" target="_blank" rel="noopener noreferrer">{T.redeem}</a>
      <p class="dn-hint">{T.codeHint}</p>
    </div>
    <div class="dn-linkbox" id="dn-linkbox" hidden>
      <div class="dn-cap">🔗 {T.linkTitle}</div>
      <a class="dn-pay dn-pay-full" id="dn-link" href="#" target="_blank" rel="noopener noreferrer">{T.open}</a>
      <p class="dn-hint">{T.linkHint}</p>
    </div>
    <div class="dn-status-actions">
      <a class="dn-ghost" id="dn-support" href="https://t.me/StarsjoySupport" target="_blank" rel="noopener" hidden>💬 {T.support}</a>
      <button type="button" class="dn-ghost" id="dn-again">{T.again}</button>
    </div>
  </div>
</div>

<script>
  type Item = { id: string; name: string; price: number };
  type Game = { slug: string; title: string; unit: string; kind: string; needs_player_id: boolean; id_hint: string | null; available: boolean; items: Item[] };

  const root = document.getElementById('dn-app') as HTMLElement | null;
  if (root) {
    const API = root.dataset.api!;
    const lang = (root.dataset.lang || 'uz') as 'uz' | 'ru' | 'en';
    const T = JSON.parse(document.getElementById('dn-i18n')!.textContent || '{}');
    let catalog = JSON.parse(document.getElementById('dn-catalog')!.textContent || 'null');
    let enabled = root.dataset.enabled === '1';
    let slug = root.dataset.game || '';
    let itemId = '';
    let checkedFor = '';
    let checkTimer: number | undefined;
    let pollTimer: number | undefined;
    let tickTimer: number | undefined;
    let current: any = {};

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const fmt = (n: number) => Number(n || 0).toLocaleString('ru-RU').replace(/,/g, ' ');
    const game = (): Game | undefined => catalog?.games?.find((g: Game) => g.slug === slug);
    const item = (): Item | undefined => game()?.items.find((i) => i.id === itemId);
    const showErr = (msg: string) => { const e = $('dn-err'); e.textContent = msg; e.hidden = !msg; };
    const pidValue = () => (document.getElementById('dn-player') as HTMLInputElement | null)?.value.trim().replace(/\s+/g, '') || '';
    const zoneValue = () => (document.getElementById('dn-server') as HTMLInputElement | null)?.value.trim().replace(/[\s()]/g, '') || '';
    const needsZone = () => Boolean((game() as any)?.needs_server);
    const store = {
      get: () => { try { return localStorage.getItem('dn_order') || ''; } catch { return ''; } },
      set: (v: string) => { try { v ? localStorage.setItem('dn_order', v) : localStorage.removeItem('dn_order'); } catch {} },
    };

    /** "60 UC" → {qty:"60", unit:"UC"}; "110 Diamonds" → olmos; boshqalari (Prime, Pass) → null */
    function parseName(name: string) {
      const m = String(name).match(/^([\d\s.,+]+)\s+(UC|Diamonds|Gold|Delta Coins|BC|Tokens|Bonds|Robux)$/i);
      if (!m) return null;
      const u = Object.keys(T.UNIT).find((k) => k.toLowerCase() === m[2].toLowerCase()) || m[2];
      return { qty: m[1].trim(), unit: T.UNIT[u]?.[lang] || m[2] };
    }
    const L10N: Record<string, [RegExp, string, string, string][]> = { x: [
      [/^Prime \(1 Month\)$/i, 'Prime · 1 oy', 'Prime · 1 мес', 'Prime · 1 month'],
      [/^Prime Plus \(1 Month\)$/i, 'Prime Plus · 1 oy', 'Prime Plus · 1 мес', 'Prime Plus · 1 month'],
      [/^Weekly Membership$/i, "Haftalik a'zolik", 'Недельная подписка', 'Weekly membership'],
      [/^Monthly Membership$/i, "Oylik a'zolik", 'Месячная подписка', 'Monthly membership'],
      [/^Weekly Lite$/i, 'Haftalik Lite', 'Недельная Lite', 'Weekly Lite'],
      [/^Newbie Bundle$/i, "Yangi o'yinchi to'plami", 'Набор новичка', 'Newbie bundle'],
      [/^Evo Access (\d+)d$/i, 'Evo Access · $1 kun', 'Evo Access · $1 дн', 'Evo Access · $1 days'],
      [/^Level Up Package (\d+)$/i, 'Level Up · $1-daraja', 'Level Up · $1 ур.', 'Level Up · level $1'],
      [/^(\d+) \+ \d+ Diamonds \(First Top-Up Bonus\)$/i, "$1 olmos ×2 · 1-xarid bonusi", '$1 алмазов ×2 · бонус 1-й покупки', '$1 diamonds ×2 · first top-up'],
    ] };
    function trName(name: string) {
      for (const [re, uz, ru, en] of L10N.x) if (re.test(name)) return name.replace(re, lang === 'ru' ? ru : lang === 'en' ? en : uz);
      return name;
    }
    const prettyName = (name: string) => { const p = parseName(name); return p ? `${p.qty} ${p.unit}` : trName(name); };

    function renderGames() {
      $('dn-games').querySelectorAll<HTMLButtonElement>('.dn-game').forEach((b) => {
        const on = b.dataset.slug === slug;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', String(on));
      });
    }

    function itemButton(it: Item, popular: boolean) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'dn-item' + (it.id === itemId ? ' is-on' : '') + (popular ? ' is-pop' : '');
      b.dataset.id = it.id;
      const p = parseName(it.name);
      if (popular) { const s = document.createElement('span'); s.className = 'dn-badge'; s.textContent = T.popular; b.append(s); }
      const top = document.createElement('span'); top.className = 'dn-item-name';
      if (p) { const q = document.createElement('b'); q.textContent = p.qty; const u = document.createElement('small'); u.textContent = p.unit; top.append(q, ' ', u); }
      else top.textContent = trName(it.name);
      const pr = document.createElement('span'); pr.className = 'dn-item-price'; pr.textContent = `${fmt(it.price)} ${T.sum}`;
      b.append(top, pr);
      return b;
    }

    function renderItems() {
      const g = game();
      const box = $('dn-items');
      box.innerHTML = '';
      if (!g) { box.innerHTML = `<div class="dn-muted">${T.loading}</div>`; return; }
      if (!g.available || !g.items.length) { box.innerHTML = `<div class="dn-muted">${T.unavailable}</div>`; itemId = ''; renderBar(); return; }
      const cur = g.items.filter((i) => parseName(i.name));
      const other = g.items.filter((i) => !parseName(i.name));
      const popId = (cur[1] || cur[0])?.id;
      if (!g.items.some((i) => i.id === itemId)) itemId = popId || g.items[0].id; // ikkinchi valyuta paketi — odatda eng ko'p olinadigan
      const group = (title: string | null, list: Item[]) => {
        if (!list.length) return;
        if (title) { const h = document.createElement('div'); h.className = 'dn-group'; h.textContent = title; box.append(h); }
        const grid = document.createElement('div'); grid.className = 'dn-items';
        list.forEach((it) => grid.append(itemButton(it, it.id === popId)));
        box.append(grid);
        const LIMIT = 4;
        const selIdx = list.findIndex((x) => x.id === itemId);
        if (title === T.passes && list.length > LIMIT + 1 && selIdx < LIMIT) {
          const extra = Array.from(grid.children).slice(LIMIT) as HTMLElement[];
          extra.forEach((el) => (el.hidden = true));
          const more = document.createElement('button');
          more.type = 'button'; more.className = 'dn-more';
          more.textContent = T.more.replace('{n}', String(extra.length));
          more.addEventListener('click', () => {
            const open = extra[0].hidden;
            extra.forEach((el) => (el.hidden = !open));
            more.textContent = open ? T.less : T.more.replace('{n}', String(extra.length));
          });
          box.append(more);
        }
      };
      group(other.length ? T.currency : null, cur);
      group(cur.length ? T.passes : null, other);
      $('dn-idbox').hidden = !g.needs_player_id;
      $('dn-giftnote').hidden = g.needs_player_id;
      const help = T.idHelp?.[g.slug] || (g.slug === 'mobile-legends' ? T.mlbbHelp : g.needs_player_id ? T.genericHelp : '');
      ($('dn-server') as HTMLInputElement).hidden = !(g as any).needs_server;
      $('dn-idrow').classList.toggle('has-zone', Boolean((g as any).needs_server));
      $('dn-giftnote-t').textContent = (g as any).secret_kind === 'code' ? T.giftCode : T.gift;
      $('dn-where').hidden = !help;
      $('dn-help').textContent = help || '';
      $('dn-help').hidden = true;
      renderBar();
    }

    function renderBar() {
      const btn = $('dn-pay') as HTMLButtonElement;
      const it = item();
      $('dn-bar-v').textContent = it ? prettyName(it.name) : '—';
      $('dn-bar-p').textContent = it ? `${fmt(it.price)} ${T.sum}` : '';
      const g = game();
      const needId = Boolean(g?.needs_player_id) && !pidValue();
      $('dn-sh2').classList.toggle('is-done', Boolean(it));
      $('dn-sh3').classList.toggle('is-done', Boolean(checkedFor));
      if (!enabled) { btn.disabled = true; btn.textContent = T.soon; return; }
      btn.disabled = false;
      btn.dataset.next = !it ? 'pack' : needId ? 'id' : 'pay';
      btn.textContent = !it ? T.pickPack : needId ? T.enterId : T.pay;
      btn.classList.toggle('is-ready', Boolean(it) && !needId);
    }

    function setNick(text: string, kind: 'ok' | 'bad' | 'wait' | '') {
      const n = $('dn-nick');
      n.hidden = !text;
      n.className = 'dn-nick' + (kind ? ` is-${kind}` : '');
      n.textContent = text;
      $('dn-player').classList.toggle('is-ok', kind === 'ok');
      $('dn-player').classList.toggle('is-bad', kind === 'bad');
      renderBar();
    }

    async function api(path: string, body?: any) {
      const r = await fetch(API + path, body ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) } : {});
      const d = await r.json().catch(() => ({}));
      return { ok: r.ok && d.success !== false, d };
    }


    async function checkPlayer(): Promise<boolean> {
      const g = game();
      if (!g?.needs_player_id) return true;
      const pid = pidValue();
      if (!pid) { setNick(T.needId, 'bad'); ($('dn-player') as HTMLInputElement).focus(); return false; }
      const zone = needsZone() ? zoneValue() : '';
      if (needsZone() && !/^\d{1,8}$/.test(zone)) { setNick(T.needZone, 'bad'); ($('dn-server') as HTMLInputElement).focus(); return false; }
      if (checkedFor === `${slug}:${pid}:${zone}`) return true;
      const btn = $('dn-check') as HTMLButtonElement;
      btn.disabled = true; setNick(T.checking, 'wait');
      try {
        const { ok, d } = await api('/api/donat/check-player', { game: slug, player_id: pid, server_id: zone || undefined, item: item()?.name });
        if (pid !== pidValue() || zone !== (needsZone() ? zoneValue() : '')) return false;
        if (!ok) { setNick(d.error || T.errNet, 'bad'); checkedFor = ''; return false; }
        setNick(d.player_name ? `✓ ${d.player_name}` : T.notVerified, 'ok');
        checkedFor = `${slug}:${pid}:${zone}`;
        renderBar();
        return true;
      } catch { setNick(T.errNet, 'bad'); return false; }
      finally { btn.disabled = false; }
    }

    async function startOrder() {
      showErr('');
      const g = game(); const it = item();
      if (!g || !it) return;
      if (!(await checkPlayer())) return;
      const btn = $('dn-pay') as HTMLButtonElement;
      btn.disabled = true; btn.classList.add('is-busy');
      try {
        const { ok, d } = await api('/api/donat/order', {
          game: slug, item: it.id, player_id: g.needs_player_id ? pidValue() : undefined, server_id: needsZone() ? zoneValue() : undefined,
          contact: ($('dn-contact') as HTMLInputElement).value.trim(), site: location.hostname, lang,
        });
        if (!ok) { showErr(d.error || T.errNet); return; }
        store.set(d.token);
        history.replaceState(null, '', `${location.pathname}?order=${encodeURIComponent(d.token)}`);
        const nick = ($('dn-nick').textContent || '').replace(/^✓\s*/, '');
        current = { ...d, game: g.title, item: it.name, player_id: g.needs_player_id ? pidValue() : null, server_id: needsZone() ? zoneValue() : null, player_name: checkedFor && nick !== T.notVerified ? nick : null, state: 'awaiting_payment' };
        showPayment(current);
        poll(d.token);
      } catch { showErr(T.errNet); }
      finally { btn.classList.remove('is-busy'); renderBar(); }
    }

    function fillWhat(el: HTMLElement, o: any) {
      el.textContent = '';
      const b = document.createElement('b');
      b.textContent = `${o.game || ''} · ${prettyName(o.item || '')}`;
      el.append(b);
      el.append(`${o.player_id ? ` · ID ${o.player_id}${o.server_id ? ` (${o.server_id})` : ''}` : ''}${o.player_name ? ` (${o.player_name})` : ''}${o.order_id ? ` · ${T.order} #${o.order_id}` : ''}`);
    }

    function showStep(id: 'dn-shop' | 'dn-payment' | 'dn-status') {
      for (const s of ['dn-shop', 'dn-payment', 'dn-status']) $(s).hidden = s !== id;
      const top = root!.getBoundingClientRect().top + window.scrollY - 90;
      if (Math.abs(window.scrollY - top) > 40) window.scrollTo({ top, behavior: 'smooth' });
    }

    function showPayment(o: any) {
      if (o.card) {
        const digits = String(o.card.number || '').replace(/[^\d*]/g, '');
        $('dn-card').textContent = digits.replace(/(.{4})(?=.)/g, '$1 ');
        $('dn-card-name').textContent = o.card.name || '';
        $('dn-card-brand').textContent = String(o.card.brand || o.card.type || '').toUpperCase();
      }
      $('dn-amount').textContent = `${fmt(o.amount)} ${T.sum}`;
      fillWhat($('dn-pay-what'), o);
      showStep('dn-payment');
      clearInterval(tickTimer);
      const end = new Date(o.expires_at).getTime();
      const total = 8 * 60 * 1000;
      const tick = () => {
        const ms = Math.max(0, end - Date.now());
        const s = Math.round(ms / 1000);
        $('dn-timer').textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
        $('dn-progress').style.width = `${Math.min(100, (ms / total) * 100)}%`;
        root!.classList.toggle('is-late', s < 90);
        if (s <= 0) clearInterval(tickTimer);
      };
      tick(); tickTimer = window.setInterval(tick, 1000);
    }

    function showStatus(o: any) {
      clearInterval(tickTimer);
      const step = o.state === 'delivered' ? 2 : o.state === 'delivering' || o.state === 'problem' ? 1 : -1;
      $('dn-track').hidden = o.state === 'expired';
      $('dn-track').querySelectorAll('li').forEach((li) => {
        const i = Number((li as HTMLElement).dataset.i);
        li.classList.toggle('done', i < step || (o.state === 'delivered' && i <= step));
        li.classList.toggle('now', i === step && o.state !== 'delivered');
        li.classList.toggle('bad', i === step && o.state === 'problem');
      });
      const map: Record<string, [string, string]> = {
        delivering: ['🚀', T.delivering],
        delivered: ['🎉', o.link ? T.delivered : `${prettyName(o.item)} ${T.deliveredGame}`],
        problem: ['🛠️', T.problem],
        expired: ['⌛', T.expired],
      };
      const [i, t] = map[o.state] || ['🚀', T.delivering];
      $('dn-status-ico').textContent = i;
      $('dn-status-text').textContent = t;
      root!.classList.toggle('is-done', o.state === 'delivered');
      fillWhat($('dn-status-what'), o);
      const isCode = o.secret_kind === 'code';
      $('dn-linkbox').hidden = !o.link || isCode;
      $('dn-codebox').hidden = !o.link || !isCode;
      if (o.link && !isCode && /^https?:\/\//i.test(o.link)) ($('dn-link') as HTMLAnchorElement).href = o.link;
      if (o.link && isCode) $('dn-code').textContent = o.link;
      $('dn-support').hidden = !(o.state === 'problem' || o.state === 'expired');
      $('dn-again').hidden = o.state === 'delivering';
      showStep('dn-status');
    }

    async function poll(token: string) {
      clearTimeout(pollTimer);
      try {
        const r = await fetch(`${API}/api/donat/order/${encodeURIComponent(token)}`, { cache: 'no-store' });
        if (r.status === 404) { store.set(''); history.replaceState(null, '', location.pathname); return; }
        const o = await r.json();
        if (o.success) {
          current = { ...current, ...o, card: o.card || current.card };
          if (o.state === 'awaiting_payment') {
            if ($('dn-payment').hidden) showPayment(current);
          } else {
            showStatus(current);
            if (o.state === 'delivered' || o.state === 'expired') { store.set(''); return; }
          }
        }
      } catch { /* tarmoq — qayta urinamiz */ }
      pollTimer = window.setTimeout(() => poll(token), 4000);
    }

    function reset() {
      clearTimeout(pollTimer); clearInterval(tickTimer); store.set(''); current = {};
      root!.classList.remove('is-done', 'is-late');
      history.replaceState(null, '', location.pathname);
      showStep('dn-shop');
    }

    // ---------- hodisalar ----------
    $('dn-games').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.dn-game');
      if (!b || b.dataset.slug === slug) return;
      slug = b.dataset.slug!; itemId = ''; checkedFor = ''; setNick('', ''); showErr('');
      ($('dn-player') as HTMLInputElement).value = '';
      ($('dn-server') as HTMLInputElement).value = '';
      renderGames(); renderItems();
    });
    $('dn-items').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.dn-item');
      if (!b) return;
      itemId = b.dataset.id!;
      $('dn-items').querySelectorAll('.dn-item').forEach((x) => x.classList.toggle('is-on', x === b));
      renderBar();
    });
    $('dn-where').addEventListener('click', () => { $('dn-help').hidden = !$('dn-help').hidden; });
    $('dn-check').addEventListener('click', () => { checkedFor = ''; checkPlayer(); });
    $('dn-player').addEventListener('input', () => {
      checkedFor = ''; setNick('', '');
      clearTimeout(checkTimer);
      if (pidValue().length >= 6 && (!needsZone() || zoneValue())) checkTimer = window.setTimeout(checkPlayer, 900); // yozib bo'lgach o'zi tekshiradi
    });
    $('dn-server').addEventListener('input', () => {
      checkedFor = ''; setNick('', '');
      clearTimeout(checkTimer);
      if (pidValue().length >= 6 && zoneValue().length >= 1) checkTimer = window.setTimeout(checkPlayer, 900);
    });
    $('dn-player').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { checkedFor = ''; checkPlayer(); } });
    $('dn-pay').addEventListener('click', () => {
      const next = ($('dn-pay') as HTMLButtonElement).dataset.next;
      if (next === 'pack') { $('dn-items').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      if (next === 'id') { const inp = $('dn-player') as HTMLInputElement; inp.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => inp.focus(), 350); setNick(T.needId, 'bad'); return; }
      startOrder();
    });
    $('dn-again').addEventListener('click', reset);
    $('dn-cancel').addEventListener('click', reset);
    $('dn-code-copy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText($('dn-code').textContent || ''); $('dn-code-copy').textContent = T.copied; setTimeout(() => ($('dn-code-copy').textContent = T.copy), 1600); } catch {}
    });
    root.querySelectorAll<HTMLButtonElement>('.dn-copy').forEach((b) => b.addEventListener('click', async () => {
      const v = b.dataset.copy === 'amount' ? String(current?.amount || '') : String(current?.card?.number || '').replace(/\D/g, '');
      const label = b.textContent;
      try { await navigator.clipboard.writeText(v); b.textContent = T.copied; b.classList.add('is-ok'); setTimeout(() => { b.textContent = label; b.classList.remove('is-ok'); }, 1600); } catch {}
    }));

    // ---------- boshlash ----------
    renderItems();
    (async () => {
      try {
        const r = await fetch(`${API}/api/donat/catalog`);
        const d = await r.json();
        if (d.success) { catalog = d; enabled = Boolean(d.enabled); if (!game() && d.games[0]) slug = d.games[0].slug; renderGames(); renderItems(); }
      } catch { /* SSR katalog bilan qolamiz */ }
    })();

    const token = new URLSearchParams(location.search).get('order') || store.get();
    if (token) poll(token);
  }
</script>

