---
/**
 * Donat do'koni qobig'i — bosqichma-bosqich (A) variant: O'yin → Paket → Akkaunt → Tasdiqlash → To'lov → Holat.
 * Mantiq — src/scripts/donat/core.ts, ko'rinish — v1.ts, stil — src/styles/donat-ui.css.
 */
import '../styles/donat-ui.css';
import { DONAT_API, type DonatCatalog, type DonatLang } from '../lib/donat';

interface Props { lang: DonatLang; catalog: DonatCatalog | null; initialGame?: string }
const { lang, catalog, initialGame } = Astro.props;
const API_BASE = import.meta.env.DEV ? '/donat-api' : DONAT_API;
const loading = { uz: 'Yuklanmoqda…', ru: 'Загрузка…', en: 'Loading…' }[lang];
---

<div id="dn-root" class="dn-root" data-api={API_BASE} data-lang={lang} data-game={initialGame || ''}>
  <div style="text-align:center;padding:60px 0;color:#6B6490">{loading}</div>
</div>
<script type="application/json" id="dn-catalog" set:html={JSON.stringify(catalog)} />

<script>
  import { mountDonat, type Lang, type Renderer } from '../scripts/donat/core';
  import { v1 } from '../scripts/donat/v1';

  const root = document.getElementById('dn-root') as HTMLElement | null;
  if (root) {
    const renderers: Record<string, Renderer> = { v1 };
    mountDonat(root, {
      api: root.dataset.api!,
      lang: (root.dataset.lang || 'uz') as Lang,
      catalog: JSON.parse(document.getElementById('dn-catalog')?.textContent || 'null'),
      initialGame: root.dataset.game || undefined,
      renderers,
      variant: 'v1',
      support: 'https://t.me/StarsjoySupport',
    });
    try { localStorage.removeItem('dn_ui'); } catch {}
  }
</script>
