---
/**
 * Bosh sahifa Hero — "trust" bento, glass uslubida.
 *
 * SEO/GEO: H1 va tavsif matni avvalgidek (kalit so'zlar, AI iqtibos qiladigan
 * "Starsjoy — Telegram Mini App…" gapi) saqlangan. Bento kartochkalaridagi
 * har bir fakt saytning boshqa joylarida ham bor (Guarantees, HowItWorks,
 * schema.org) — yangi da'vo qo'shilmagan. Reyting DB'dan keladi (rating prop),
 * sharh bo'lmasa raqam ko'rsatilmaydi.
 *
 * Kartochkalar: oq glass va shaffof fonli izometrik illustratsiyalar.
 * Animatsiyalar faqat CSS (transform/opacity) — JS sikllari yo'q,
 * prefers-reduced-motion hisobga olinadi. H1 animatsiyasiz (LCP).
 */
interface Props {
  lang?: 'uz' | 'ru' | 'en';
  rating?: { ratingValue: number; reviewCount: number };
}
const { lang = 'uz', rating } = Astro.props;

const BOT_URL = 'https://telegram.me/starsjoybot';
const p = lang === 'uz' ? '' : `/${lang}`;

const T = {
  uz: {
    badge: ["O'zbekistonda · so'mda", "to'lov Uzcard va Humo orqali"],
    h1: ['Telegram Stars', 'Premium va Gifts'], hl: '10 soniyada!',
    desc: "Starsjoy — Telegram Mini App. Stars xarid qiling, Premium obuna bo'ling yoki do'stlaringizga Gifts yuboring — hammasi ilova ichida, 10 soniyada.",
    cta: 'Ilovaga kirish', more: "Xizmatlarni ko'rish",
    speedK: 'Yetkazish', speedV: '10 soniya', speedS: "To'lov tasdiqlangach — avtomatik",
    rateS: (n: number) => `${n} ta sharh`, rateEmpty: 'Haqiqiy sharhlar', rateRead: "O'qish",
    ordersV: '8 000+', ordersS: 'bajarilgan buyurtma',
    refundV: '100%', refundS: "pul qaytarish kafolati",
    payK: "To'lov", payM: ['Click', 'Payme', 'Uzum', 'Karta'],
    products: [['Stars', '/stars'], ['Premium', '/premium'], ['Gifts', '/gifts']],
    reviews: '/sharhlar',
  },
  ru: {
    badge: ['В Узбекистане · в сумах', 'оплата через Uzcard и Humo'],
    h1: ['Telegram Stars,', 'Premium и Gifts'], hl: 'за 10 секунд!',
    desc: 'Starsjoy — это Telegram Mini App. Покупайте Stars, оформляйте Premium или отправляйте Gifts друзьям — всё внутри приложения, за 10 секунд.',
    cta: 'Открыть приложение', more: 'Наши услуги',
    speedK: 'Доставка', speedV: '10 секунд', speedS: 'После подтверждения оплаты — автоматически',
    rateS: (n: number) => `Отзывы: ${n}`, rateEmpty: 'Реальные отзывы', rateRead: 'Читать',
    ordersV: '8 000+', ordersS: 'выполненных заказов',
    refundV: '100%', refundS: 'гарантия возврата',
    payK: 'Оплата', payM: ['Click', 'Payme', 'Uzum', 'Карта'],
    products: [['Stars', '/ru/stars'], ['Premium', '/ru/premium'], ['Gifts', '/ru/gifts']],
    reviews: '/ru/sharhlar',
  },
  en: {
    badge: ['In Uzbekistan · in som', 'pay with Uzcard and Humo'],
    h1: ['Telegram Stars,', 'Premium and Gifts'], hl: 'in 10 seconds!',
    desc: 'StarsJoy is a Telegram Mini App. Buy Stars, get Premium or send Gifts to friends — all inside the app, paid in Uzbek som with a local card.',
    cta: 'Open the app', more: 'Our services',
    speedK: 'Delivery', speedV: '10 seconds', speedS: 'Automatic once payment is confirmed',
    rateS: (n: number) => `${n} reviews`, rateEmpty: 'Real reviews', rateRead: 'Read',
    ordersV: '8,000+', ordersS: 'completed orders',
    refundV: '100%', refundS: 'money-back guarantee',
    payK: 'Payment', payM: ['Click', 'Payme', 'Uzum', 'Card'],
    products: [['Stars', '/en/stars'], ['Premium', '/en/premium'], ['Gifts', '/en/gifts']],
    reviews: null,
  },
}[lang];

const hasRating = !!rating && rating.reviewCount > 0;
const ratingText = hasRating ? rating!.ratingValue.toFixed(1) : '';
const TG_PATH = 'M21.4 4.6 2.9 11.8c-1.2.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.5c.2.6.4.8.9.8.4 0 .6-.2.8-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.5-1.8-1.4-1.4ZM8.9 14.4l8.6-5.4c.4-.3.8-.1.5.2l-7 6.4-.3 3.1z';
const STAR = 'm12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z';
const RateTag = T.reviews ? 'a' : 'div';
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
    <span class="blob blob-3"></span>
    <span class="grid-lines"></span>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow"><span>{T.badge[0]}</span><span class="eb-sep"> — </span><span>{T.badge[1]}</span></p>
      <h1 class="hero-title">
        {T.h1[0]}<br>
        {T.h1[1]}<br>
        <span class="hero-highlight">{T.hl}</span>
      </h1>
      <p class="hero-desc">{T.desc}</p>
      <div class="hero-buttons">
        <a href={BOT_URL} class="h-btn h-btn--primary" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={TG_PATH} fill="currentColor" /></svg>
          {T.cta}
        </a>
        <a href="#services" class="h-btn h-btn--glass">
          {T.more}
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    <div class="bento">
      <!-- Tezlik + mahsulotlar -->
      <div class="tile tile--speed">
        <div class="tile-row">
          <img class="tile-art tile-art--speed" src="/images/bento/delivery.webp" width="160" height="160" alt="" aria-hidden="true" decoding="async" />
          <span class="tile-k">{T.speedK}</span>
        </div>
        <div class="speed-v">{T.speedV}</div>
        <p class="tile-s">{T.speedS}</p>
        <div class="prod">
          {T.products.map(([label, href], i) => (
            <a href={href} class={`prod-chip prod-chip--${i}`}>
              <span class="prod-dot" aria-hidden="true"></span>{label}
            </a>
          ))}
        </div>
      </div>

      <!-- Reyting -->
      <RateTag href={T.reviews ?? undefined} class="tile tile--rate">
        <img class="tile-art tile-art--rate" src="/images/bento/rating.webp" width="160" height="160" alt="" aria-hidden="true" decoding="async" />
        {hasRating ? (
          <>
            <div class="rate-v">{ratingText}<small>/5</small></div>
            <div class="stars" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <svg width="14" height="14" viewBox="0 0 24 24"><path d={STAR} fill="currentColor" /></svg>)}
            </div>
            <p class="tile-s">{T.rateS(rating!.reviewCount)}</p>
          </>
        ) : (
          <>
            <div class="stars stars--lg" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <svg width="16" height="16" viewBox="0 0 24 24"><path d={STAR} fill="currentColor" /></svg>)}
            </div>
            <p class="tile-strong">{T.rateEmpty}</p>
            {T.reviews && <p class="tile-s">{T.rateRead} →</p>}
          </>
        )}
      </RateTag>

      <!-- Buyurtmalar -->
      <div class="tile tile--orders">
        <img class="tile-art tile-art--orders" src="/images/bento/orders.webp" width="160" height="160" alt="" aria-hidden="true" decoding="async" />
        <div class="big-v">{T.ordersV}</div>
        <p class="tile-s">{T.ordersS}</p>
      </div>

      <!-- Kafolat -->
      <div class="tile tile--refund">
        <img class="tile-art tile-art--refund" src="/images/bento/guarantee.webp" width="160" height="160" alt="" aria-hidden="true" decoding="async" />
        <div class="big-v">{T.refundV}</div>
        <p class="tile-s">{T.refundS}</p>
      </div>

      <!-- To'lov -->
      <div class="tile tile--pay">
        <div class="tile-row">
          <span class="tile-k">{T.payK}</span>
          <img class="tile-art tile-art--pay" src="/images/bento/payment.webp" width="160" height="160" alt="" aria-hidden="true" decoding="async" />
        </div>
        <ul class="pay">
          {T.payM.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --g-bg: rgba(255, 255, 255, 0.55);
    --g-line: rgba(255, 255, 255, 0.85);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 132px 0 84px;
    background: linear-gradient(180deg, #F7F4FF 0%, #FBFAFF 55%, #FFFFFF 100%);
  }

  /* ===== Fon: gradient mesh + nozik to'r ===== */
  .hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.32;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .blob-1 { width: 520px; height: 520px; top: -160px; right: -60px; background: #C4B5FD; }
  .blob-2 { width: 420px; height: 420px; top: 180px; right: 22%; background: #FBCFE8; animation-delay: -6s; animation-duration: 22s; }
  .blob-3 { width: 460px; height: 460px; bottom: -220px; left: -120px; background: #BFDBFE; animation-delay: -12s; }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(124, 58, 237, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 58, 237, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, #000 20%, transparent 75%);
  }
  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-40px, 30px, 0) scale(1.08); }
  }

  .hero-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.02fr 1fr;
    align-items: center;
    gap: 56px;
  }

  /* ===== Matn ===== */
  .hero-eyebrow {
    margin-bottom: 20px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text);
    margin-bottom: 20px;
  }
  .hero-highlight {
    background: linear-gradient(120deg, #7C3AED 0%, #C026D3 50%, #2563EB 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-desc {
    max-width: 520px;
    margin-bottom: 34px;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .h-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    padding: 0 26px;
    border-radius: 18px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.25s var(--ease), box-shadow 0.25s, background 0.25s;
  }
  .h-btn--primary {
    overflow: hidden;
    color: #fff;
    background: var(--gradient);
    box-shadow: 0 14px 32px -10px rgba(124, 58, 237, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .h-btn--primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.7s var(--ease);
  }
  .h-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 38px -10px rgba(124, 58, 237, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.3); }
  .h-btn--primary:hover::after { transform: translateX(100%); }
  .h-btn--glass {
    color: var(--text);
    background: var(--g-bg);
    border: 1px solid var(--g-line);
    box-shadow: 0 6px 20px rgba(26, 16, 53, 0.06), inset 0 1px 0 #fff;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .h-btn--glass:hover { transform: translateY(-2px); background: rgba(255, 255, 255, 0.8); }
  .h-btn:focus-visible, .tile:focus-visible, .prod-chip:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }

  /* ===== Bento ===== */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(26, 16, 53, 0.07);
    box-shadow: 0 1px 2px rgba(26, 16, 53, 0.04), 0 12px 32px -16px rgba(26, 16, 53, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--text);
    text-decoration: none;
    animation: rise 0.8s var(--ease) both;
    transition: transform 0.35s var(--ease), box-shadow 0.35s;
  }
  .tile:hover { transform: translateY(-3px); border-color: rgba(26, 16, 53, 0.12); box-shadow: 0 1px 2px rgba(26, 16, 53, 0.04), 0 18px 40px -18px rgba(26, 16, 53, 0.18); }
  .tile:nth-child(2) { animation-delay: 0.08s; }
  .tile:nth-child(3) { animation-delay: 0.16s; }
  .tile:nth-child(4) { animation-delay: 0.24s; }
  .tile:nth-child(5) { animation-delay: 0.32s; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  .tile-row { display: flex; align-items: center; gap: 10px; }
  .tile-k { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-light); }
  .tile-s { font-size: 0.85rem; line-height: 1.45; color: var(--text-muted); }
  .tile-strong { font-size: 1.05rem; font-weight: 800; }

  .tile-art {
    display: block;
    width: 80px;
    height: 80px;
    object-fit: contain;
    flex-shrink: 0;
    pointer-events: none;
    user-select: none;
  }
  .tile-art--orders, .tile-art--refund, .tile-art--rate {
    align-self: flex-end;
    margin: -8px -4px -12px 0;
  }
  .tile-art--pay { width: 72px; height: 72px; margin-left: auto; }
  .tile-art--speed {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 140px;
    height: 140px;
  }
  .tile--speed .tile-row { min-height: 32px; }
  .tile--speed .speed-v, .tile--speed > .tile-s { padding-right: 125px; }
  .tile--speed .prod { position: relative; }


  /* Tezlik (keng) */
  .tile--speed {
    grid-column: span 2;
    padding: 22px 22px 18px;
  }
  .speed-v {
    margin: 8px 0 4px;
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .prod { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .prod-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #F8F7FB;
    border: 1px solid rgba(26, 16, 53, 0.06);
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s var(--ease), border-color 0.2s;
  }
  .prod-chip:hover { transform: translateY(-2px); border-color: rgba(124, 58, 237, 0.3); }
  .prod-dot { width: 8px; height: 8px; border-radius: 50%; background: #F59E0B; }
  .prod-chip--1 .prod-dot { background: #7C3AED; }
  .prod-chip--2 .prod-dot { background: #EC4899; }

  /* Reyting */
  .tile--rate {
    justify-content: center;
  }
  .rate-v { font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1; }
  .rate-v small { font-size: 1rem; font-weight: 700; color: var(--text-light); margin-left: 2px; }
  .stars { display: flex; gap: 2px; color: #F59E0B; }
  .stars--lg { gap: 3px; }

  .big-v { margin-top: 8px; font-size: 1.9rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1; }

  /* To'lov */
  .pay { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin-top: 8px; }
  .pay li {
    padding: 6px 10px;
    border-radius: 10px;
    background: #F8F7FB;
    border: 1px solid rgba(26, 16, 53, 0.06);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .hero { padding: 116px 0 64px; }
    .hero-container { grid-template-columns: 1fr; gap: 40px; text-align: center; }
    .hero-content { display: flex; flex-direction: column; align-items: center; }
    .hero-desc { margin-left: auto; margin-right: auto; }
    .hero-buttons { justify-content: center; }
    .bento { max-width: 600px; width: 100%; margin: 0 auto; text-align: left; }
  }
  @media (max-width: 640px) {
    .hero { padding: 100px 0 48px; }
    .hero-container { padding: 0 16px; gap: 32px; }
    .hero-eyebrow { margin-bottom: 16px; font-size: 0.9rem; line-height: 1.45; }
    .hero-eyebrow > span { display: block; }
    .hero-eyebrow .eb-sep { display: none; }
    .hero-title { font-size: 2.15rem; line-height: 1.12; }
    .hero-desc { font-size: 1rem; line-height: 1.6; margin-bottom: 26px; }
    .hero-buttons { flex-direction: column; align-items: stretch; width: 100%; gap: 10px; }
    .h-btn { height: 54px; }
    .bento { gap: 10px; }
    .tile { padding: 16px; border-radius: 20px; }
    .tile--speed { padding: 18px 16px 16px; }
    .tile-art { width: 68px; height: 68px; }
    .tile-art--pay { width: 56px; height: 56px; }
    .tile-art--speed { width: 100px; height: 100px; right: 8px; top: 20px; }
    .tile--speed .speed-v, .tile--speed > .tile-s { padding-right: 85px; }
    .tile--pay .tile-row { gap: 4px; }
    .rate-v { font-size: 2rem; }
    .big-v { font-size: 1.6rem; }
    .tile-s { font-size: 0.8rem; }
    .blob { filter: blur(50px); }
    .blob-1 { width: 320px; height: 320px; }
    .blob-2 { width: 260px; height: 260px; top: 360px; right: -60px; }
    .blob-3 { width: 300px; height: 300px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob, .tile { animation: none !important; }
    .tile, .h-btn, .h-btn::after, .prod-chip { transition: none !important; }
  }
</style>
