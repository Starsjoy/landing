---
/**
 * Bosh sahifa hero — StarsJoy Mini App bosh ekrani kabi (lokal sinov: ?hero=a1..a4).
 * Tepada keng karta (Mini App'dagi Gift o'rnida — Donat), ostida Premium va Stars plitkalari.
 * a1 — Mini App'ning aynan o'zi (qorong'i) · a2 — xuddi shu, yorug' · a3 — qorong'i + narxlar · a4 — yorug' sahifa, ilova bloki qorong'i panelda.
 */
import { starsPrice, PREMIUM_PRICE, fmtS } from '../lib/prices';
import { fetchDonatCatalog } from '../lib/donat';

interface Props { variant?: string; lang?: 'uz' | 'ru' | 'en'; rating?: { ratingValue: number; reviewCount: number } }
const { variant = 'a4', lang = 'uz', rating } = Astro.props;
const T = {
  uz: { h1: "Telegram Stars, Premium va o'yinlarga donat", sub: "Uzcard yoki Humo kartadan so'mda to'lang. Stars va Premium 10 soniyada keladi.", donat: "O'yinlarga donat", games: 'PUBG UC, Free Fire, Mobile Legends va boshqalar', from: (n: string) => `${n} so'm dan`, sum: "so'm", qty: '50 ta', fast: '⚡ 10 soniyada', reviews: (n: number) => `${n} ta sharh` },
  ru: { h1: 'Telegram Stars, Premium и донат в игры', sub: 'Оплата в сумах картой Uzcard или Humo. Stars и Premium приходят за 10 секунд.', donat: 'Донат в игры', games: 'PUBG UC, Free Fire, Mobile Legends и другие', from: (n: string) => `от ${n} сум`, sum: 'сум', qty: '50 шт', fast: '⚡ За 10 секунд', reviews: (n: number) => `отзывов: ${n}` },
  en: { h1: 'Telegram Stars, Premium and game top-ups', sub: 'Pay in Uzbek som with Uzcard or Humo. Stars and Premium arrive in 10 seconds.', donat: 'Game top-ups', games: 'PUBG UC, Free Fire, Mobile Legends and more', from: (n: string) => `from ${n} som`, sum: 'som', qty: '50 Stars', fast: '⚡ In 10 seconds', reviews: (n: number) => `${n} reviews` },
}[lang];
const DONAT_HREF = lang === 'uz' ? '/donat' : `/${lang}/donat`;
const BOT = 'https://telegram.me/starsjoybot';
const catalog = await fetchDonatCatalog();
const games = (catalog?.games || []).filter((g) => g.items.length);
const ICONS = ['pubg-mobile', 'free-fire', 'mobile-legends'].filter((s) => games.some((g) => g.slug === s));
const prices = ['pubg-mobile', 'free-fire', 'mobile-legends'].map((s) => games.find((g) => g.slug === s)).filter(Boolean).map((g) => Math.min(...g!.items.map((i) => i.price)));
const dFrom = prices.length ? Math.min(...prices) : 0;
const showPrice = variant === 'a3' || variant === 'a4';
const ext = { target: '_blank', rel: 'noopener' };

// Mini App'dagi TgStar bilan bir xil shakl va ranglar
const TONES = {
  gold: { top: '#ffe45c', mid: '#ffcb2e', end: '#ffb300', line: ['#f09a00', '#f07f00'], shine: '#fff6c8' },
  premium: { top: '#7ab8ff', mid: '#7f7bff', end: '#e56fd0', line: ['#5d8dff', '#b84fd8'], shine: '#dfe9ff' },
};
const D = 'm6.02 4.99 2.21-4.42c.25-.51.86-.72 1.37-.46.2.1.36.27.46.47l2.08 4.26c.17.34.5.58.88.63l4.36.52c.59.08 1.02.62.95 1.22-.03.24-.14.47-.32.65l-3.45 3.42c-.14.13-.2.33-.18.53l.57 4.61c.09.66-.38 1.27-1.03 1.35-.25.03-.5-.02-.72-.14l-3.64-2c-.26-.14-.58-.15-.85-.01l-3.770 1.950c-.53.27-1.18.06-1.45-.48-.11-.2-.14-.43-.11-.65l.3-2.12c.15-1.04.79-1.93 1.71-2.41l4.19-2.15c.11-.06.15-.2.1-.31-.05-.09-.14-.14-.24-.12l-5.12.74c-.78.11-1.58-.11-2.19-.62l-1.71-1.4c-.49-.4-.56-1.12-.17-1.62.19-.22.45-.37.74-.41l4.38-.57c.28-.03.52-.21.65-.46z';
const star = (k: 'gold' | 'premium', size = 72) => {
  const t = TONES[k];
  const id = `ha${variant}${k}`;
  return `<svg viewBox="0 0 21 21" width="${size}" height="${size}" overflow="visible" aria-hidden="true"><defs><path id="${id}a" d="${D}"/><linearGradient id="${id}b" x1="25%" x2="74.92%" y1=".825%" y2="107.86%"><stop offset="0" stop-color="${t.top}"/><stop offset=".55" stop-color="${t.mid}"/><stop offset="1" stop-color="${t.end}"/></linearGradient><linearGradient id="${id}c" x1="50%" x2="50%" y1="0%" y2="99.8%"><stop offset="0" stop-color="${t.line[0]}"/><stop offset="1" stop-color="${t.line[1]}"/></linearGradient><clipPath id="${id}k"><use href="#${id}a"/></clipPath></defs><g fill="none" fill-rule="evenodd" transform="translate(1.33 1.61)"><use fill="${t.shine}" href="#${id}a"/><g clip-path="url(#${id}k)"><use fill="url(#${id}b)" href="#${id}a" transform="translate(.7 .7)"/></g><use stroke="url(#${id}c)" stroke-width=".8" href="#${id}a"/></g></svg>`;
};
const dust = Array.from({ length: 8 }, (_, i) => `<i class="ha-dust ha-dust--${i + 1}"></i>`).join('');
const SUPPORT = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 13a7.5 7.5 0 0 1 15 0"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19a3.5 3.5 0 0 1-3.5 2H13"/></svg>`;
const CHEV = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 5.5 16 12l-6.5 6.5"/></svg>`;
const rate = rating && rating.reviewCount ? `${rating.ratingValue.toFixed(1)} ★ · ${T.reviews(rating.reviewCount)}` : '';
---

<section class={`ha ha-${variant}`} id="hero">
  <div class="ha-wrap">
    <div class="ha-head">
      <h1>{T.h1}</h1>
      <p>{T.sub}</p>
    </div>

    <div class="ha-app">
      <a class="ha-wide" href={DONAT_HREF}>
        <span class="ha-games">
          {ICONS.map((s) => <img src={`/images/donat/${s}.png`} alt="" width="40" height="40" />)}
        </span>
        <span class="ha-wide__text">
          <b>{T.donat}</b>
          <span>{showPrice && dFrom ? `PUBG UC, Free Fire, MLBB · ${T.from(fmtS(dFrom))}` : T.games}</span>
        </span>
        <span class="ha-chev" set:html={CHEV} />
      </a>

      <div class="ha-grid">
        <a class="ha-tile ha-tile--premium" href={BOT} {...ext}>
          <span class="ha-star" set:html={star('premium') + dust} />
          <b>Premium</b>
          {showPrice && <span>{T.from(fmtS(PREMIUM_PRICE[3]))}</span>}
        </a>
        <a class="ha-tile ha-tile--stars" href={BOT} {...ext}>
          <span class="ha-star" set:html={star('gold') + dust} />
          <b>Stars</b>
          {showPrice && <span>{T.qty} · {fmtS(starsPrice(50))} {T.sum}</span>}
        </a>
      </div>

    </div>

    {showPrice && (
      <ul class="ha-trust">
        <li>{T.fast}</li>
        <li>💳 Uzcard · Humo</li>
        {rate && <li>{rate}</li>}
      </ul>
    )}
  </div>
</section>

<style is:global>
  .ha {
    --bg: #0b0f17; --surface: #18202d; --ink: #fff; --ink-2: #dbe2ee; --muted: #a3aec1; --line: rgba(255,255,255,.12);
    --blue: #3b82ff; --blue-ink: #7db0ff; --blue-soft: rgba(59,130,255,.16); --tile-base: rgba(255,255,255,.12);
    padding: 92px 16px 44px; background: var(--bg); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", Inter, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased;
  }
  .ha a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
  .ha-wrap { max-width: 480px; margin: 0 auto; }
  .ha-head h1 { margin: 0 0 10px; font-size: 1.85rem; line-height: 1.15; font-weight: 750; letter-spacing: -.03em; color: var(--ink); }
  .ha-head p { margin: 0 0 22px; font-size: 1rem; line-height: 1.5; color: var(--muted); }

  /* keng karta (Mini App'dagi Gift) */
  .ha-wide {
    display: flex; align-items: center; gap: 12px; min-height: 76px; margin-bottom: 14px; padding: 13px 14px;
    border: 1px solid rgba(59,130,255,.35); border-radius: 18px;
    background: linear-gradient(120deg, rgba(47,107,255,.26), rgba(34,166,242,.1)), var(--surface); transition: transform .15s;
  }
  .ha-wide:active, .ha-admin:active { transform: scale(.98); }
  .ha-games { flex: none; display: flex; padding-left: 2px; }
  .ha-games img { width: 40px; height: 40px; object-fit: cover; border-radius: 11px; border: 2px solid var(--surface); box-shadow: 0 6px 12px rgba(47,107,255,.35); }
  .ha-games img + img { margin-left: -16px; }
  .ha-wide__text, .ha-admin__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; font-size: 13.5px; line-height: 1.3; color: var(--ink-2); }
  .ha-wide__text b { font-size: 16px; font-weight: 650; color: var(--ink); }
  .ha-chev { flex: none; width: 18px; height: 18px; color: var(--muted); }
  .ha-chev svg, .ha-admin__ic svg { width: 100%; height: 100%; display: block; }

  /* Premium va Stars plitkalari */
  .ha-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ha-tile {
    --tile-bg: var(--surface); --glow: 255,255,255;
    position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 24px 10px 20px; border-radius: 22px; background: var(--tile-base); transition: transform .15s;
  }
  .ha-tile:active { transform: scale(.97); }
  .ha-tile::before { content: ""; position: absolute; z-index: -2; inset: 0; background: linear-gradient(150deg, rgba(var(--glow),.4), rgba(255,255,255,.07) 50%, rgba(var(--glow),.18)); }
  .ha-tile::after { content: ""; position: absolute; z-index: -1; inset: 1.5px; border-radius: 20.5px; background: var(--tile-bg); }
  .ha-tile--premium { --glow: 138,123,255; --tile-bg: linear-gradient(170deg, rgba(122,123,255,.24), rgba(229,111,208,.08)), var(--surface); }
  .ha-tile--stars { --glow: 255,190,40; --tile-bg: linear-gradient(170deg, rgba(255,190,40,.2), rgba(255,190,40,.03)), var(--surface); }
  .ha-tile b { margin-top: 12px; font-size: 19px; font-weight: 690; letter-spacing: -.02em; }
  .ha-tile > span:last-child:not(.ha-star) { font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .ha-star { position: relative; display: block; line-height: 0; }
  .ha-star svg { filter: drop-shadow(0 8px 14px rgba(var(--glow), .35)); }
  .ha-dust { position: absolute; width: 5px; height: 5px; border-radius: 50%; opacity: 0; background: radial-gradient(closest-side, #fff, rgba(var(--glow),.9) 45%, transparent); animation: ha-dust 5.5s ease-in-out infinite; }
  .ha-dust--1 { left: -8px; top: 6px; } .ha-dust--2 { right: -12px; top: 18px; animation-delay: -1.1s; }
  .ha-dust--3 { left: 2px; bottom: 2px; animation-delay: -2.2s; width: 4px; height: 4px; } .ha-dust--4 { right: -4px; bottom: 12px; animation-delay: -3.3s; }
  .ha-dust--5 { left: 50%; top: -9px; animation-delay: -4.4s; width: 4px; height: 4px; } .ha-dust--6 { left: -14px; bottom: 22px; animation-delay: -.55s; width: 4px; height: 4px; }
  .ha-dust--7 { right: -16px; top: -2px; animation-delay: -2.75s; } .ha-dust--8 { left: 30%; bottom: -8px; animation-delay: -3.85s; width: 3px; height: 3px; }
  .ha-tile--stars .ha-dust { animation-duration: 6.5s; }
  @keyframes ha-dust { 0%,100% { opacity: 0; transform: translateY(7.5px) scale(.6); } 50% { opacity: 1; transform: translateY(-7.5px) scale(1.15); } }
  @media (prefers-reduced-motion: reduce) { .ha-dust { animation: none; opacity: .6; } }

  /* support */
  .ha-admin { display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 13px 14px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); transition: transform .15s; }
  .ha-admin__ic { flex: none; width: 40px; height: 40px; padding: 10px; border-radius: 12px; background: var(--blue-soft); color: var(--blue-ink); }
  .ha-admin__text { color: var(--muted); }
  .ha-admin__text b { font-size: 15.5px; font-weight: 630; color: var(--ink); }

  .ha-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin: 18px 0 0; padding: 0; list-style: none; font-size: 13.5px; color: var(--muted); }

  /* a2 · yorug' */
  .ha-a2, .ha-a4 { --bg: #F5F6FA; --surface: #fff; --ink: #121826; --ink-2: #3E4757; --muted: #6B7385; --line: #E6E8EF; --blue-ink: #2F6BFF; --blue-soft: #EAF1FF; --tile-base: #E6E8EF; }
  .ha-a2 .ha-wide { background: linear-gradient(120deg, #E4EDFF, #F2F8FF); border-color: #CCDDFF; }
  .ha-a2 .ha-tile--premium { --tile-bg: linear-gradient(170deg, #EEEBFF, #FBF2FB); }
  .ha-a2 .ha-tile--stars { --tile-bg: linear-gradient(170deg, #FFF3D1, #FFFBF0); }
  .ha-a2 .ha-games img { border-color: #fff; box-shadow: 0 4px 10px rgba(47,107,255,.2); }

  /* a4 · yorug' sahifa, ilova bloki qorong'i panelda */
  .ha-a4 { background: linear-gradient(180deg, #F7F4FF 0%, #FFFFFF 100%); }
  .ha-a4 .ha-app {
    --surface: #18202d; --ink: #fff; --ink-2: #dbe2ee; --muted: #a3aec1; --line: rgba(255,255,255,.12); --blue-ink: #7db0ff; --blue-soft: rgba(59,130,255,.16); --tile-base: rgba(255,255,255,.12);
    padding: 14px; border-radius: 30px; background: #0b0f17; color: #fff; box-shadow: 0 24px 50px rgba(20,16,50,.22);
  }

  @media (min-width: 900px) {
    .ha { padding: 120px 24px 72px; }
    .ha-wrap { max-width: 1040px; display: grid; grid-template-columns: 1fr 440px; gap: 56px; align-items: center; }
    .ha-head h1 { font-size: 3rem; }
    .ha-head p { font-size: 1.12rem; }
    .ha-wrap { grid-template-rows: auto auto; row-gap: 0; }
    .ha-head { grid-column: 1; grid-row: 1; align-self: end; }
    .ha-app { grid-column: 2; grid-row: 1 / span 2; }
    .ha-trust { grid-column: 1; grid-row: 2; align-self: start; justify-content: flex-start; margin-top: 4px; }
  }
</style>
