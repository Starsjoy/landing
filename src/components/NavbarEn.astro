---
/**
 * Ingliz tilidagi navigatsiya.
 *
 * UZ/RU navbardan farqi: ingliz tilida hozircha faqat ayrim sahifalar bor, shuning
 * uchun menyuda faqat o'shalar. Mavjud bo'lmagan bo'limlarga (Reviews va h.k.)
 * havola bermaymiz — ingliz o'quvchini o'zbekcha sahifaga tashlash yomon tajriba
 * va hreflang'ni ham buzadi.
 */
import NavbarBase from './NavbarBase.astro';
import { EN_TO_UZ } from '../lib/i18n';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const uzPath = EN_TO_UZ[currentPath] ?? '/';
const ruPath = uzPath === '/' ? '/ru' : `/ru${uzPath}`;

const items = [
  { label: 'Home', href: '/en', icon: 'home' },
  {
    label: 'Stars', href: '/en/stars', icon: 'star',
    title: 'Telegram Stars', desc: 'Pick the pack that fits you', allLabel: 'All packs',
    children: [
      { label: '100 ⭐', href: '/en/stars/100' },
      { label: '500 ⭐', href: '/en/stars/500-pack' },
      { label: '1000 ⭐', href: '/en/stars/1000' },
      { label: '5000 ⭐', href: '/en/stars/5000' },
      { label: '10,000 ⭐', href: '/en/stars/10000' },
    ],
  },
  {
    label: 'Premium', href: '/en/premium', icon: 'crown',
    title: 'Telegram Premium', desc: 'Choose a subscription period', allLabel: 'All plans',
    children: [
      { label: '3 months', href: '/en/premium/3-months' },
      { label: '6 months', href: '/en/premium/6-months' },
      { label: '12 months', href: '/en/premium/12-months' },
    ],
  },
  { label: 'Gifts', href: '/en/gifts', icon: 'gift' },
  { label: 'How to buy', href: '/en/how-to-buy', icon: 'help' },
  { label: 'Blog', href: '/en/blog', icon: 'pen' },
  { label: 'About', href: '/en/about', icon: 'info' },
];

const langs = [
  { code: 'UZ', label: 'O‘zbekcha', href: uzPath },
  { code: 'RU', label: 'Русский', href: ruPath },
  { code: 'EN', label: 'English', href: currentPath, current: true },
];
---

<NavbarBase
  homeHref="/en"
  items={items}
  langs={langs}
  ctaLabel="Open the bot"
  menuLabel="Menu"
  closeLabel="Close menu"
  langLabel="Choose language"
/>
