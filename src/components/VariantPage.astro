---
/**
 * Shared shell for the Premium/Stars "variant" commercial pages
 * (/premium/3-oy, /stars/1000, etc). One component, 24 thin page files.
 *
 * All copy is passed in as props on purpose — this component holds no
 * hardcoded language strings, so uz/ru/en pages each write their own text
 * and FAQ set. That per-page FAQ/intro text is what keeps the 24 pages from
 * being thin duplicates of each other, not anything in here.
 */
interface FAQItem { q: string; a: string }
interface LinkItem { href: string; label: string }
interface TrustItem { num: string; title: string; text: string }
interface SiblingItem extends LinkItem { active?: boolean }
interface BreadcrumbNode { name: string; item: string }

interface Props {
  accent: 'purple' | 'gold';
  canonical: string;

  homeLabel: string;
  hubLabel: string;
  hubHref: string;
  currentLabel: string;

  eyebrow: string;
  h1: string;
  quickAnswer: string;
  heroNote?: string;

  siblingsTitle: string;
  siblings: SiblingItem[];

  priceLabel: string;
  priceValue: string;
  priceSubtext?: string;
  ctaLabel: string;
  ctaHref: string;

  forWhomTitle: string;
  forWhomText: string;

  trustItems: TrustItem[];

  faqTitle: string;
  faqSubtitle: string;
  faqs: FAQItem[];

  relatedTitle: string;
  related: LinkItem[];

  finalCtaTitle: string;
  finalCtaText: string;
  finalCtaLabel: string;

  schemaName: string;
  schemaDescription: string;
  priceAmount: string;
  priceCurrency?: string;
  breadcrumbSchema: BreadcrumbNode[];
}

const {
  accent,
  canonical,
  homeLabel, hubLabel, hubHref, currentLabel,
  eyebrow, h1, quickAnswer, heroNote,
  siblingsTitle, siblings,
  priceLabel, priceValue, priceSubtext, ctaLabel, ctaHref,
  forWhomTitle, forWhomText,
  trustItems,
  faqTitle, faqSubtitle, faqs,
  relatedTitle, related,
  finalCtaTitle, finalCtaText, finalCtaLabel,
  schemaName, schemaDescription, priceAmount, priceCurrency = "UZS",
  breadcrumbSchema,
} = Astro.props as Props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": schemaName,
  "description": schemaDescription,
  "image": "https://starsjoy.uz/og-image.png",
  "brand": { "@type": "Brand", "name": "StarsJoy" },
  "offers": {
    "@type": "Offer",
    "price": priceAmount,
    "priceCurrency": priceCurrency,
    "availability": "https://schema.org/InStock",
    "url": canonical,
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    }
  }
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbSchema.map((node, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": node.name,
    "item": node.item
  }))
})} />

<section class={`vp-hero vp-${accent}`}>
  <div class="container">
    <nav class="vp-breadcrumb">
      <a href="/">{homeLabel}</a>
      <span>/</span>
      <a href={hubHref}>{hubLabel}</a>
      <span>/</span>
      <span>{currentLabel}</span>
    </nav>

    {siblings.length > 0 && (
      <div class="vp-siblings fade-in" aria-label={siblingsTitle}>
        {siblings.map(s => (
          <a href={s.href} class={`vp-sibling-pill ${s.active ? 'active' : ''}`}>{s.label}</a>
        ))}
      </div>
    )}

    <div class="vp-hero-inner fade-in">
      <span class="vp-eyebrow">{eyebrow}</span>
      <h1 class="vp-title">{h1}</h1>
      <p class="vp-quick-answer">{quickAnswer}</p>
      {heroNote && <p class="vp-hero-note">{heroNote}</p>}

      <div class="vp-price-card">
        <div class="vp-price-info">
          <span class="vp-price-label">{priceLabel}</span>
          <span class="vp-price-value">{priceValue}</span>
          {priceSubtext && <span class="vp-price-subtext">{priceSubtext}</span>}
        </div>
        <a href={ctaHref} class="btn-primary vp-price-cta" target="_blank">&#9889; {ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

<section class="vp-forwhom">
  <div class="container">
    <div class="vp-forwhom-box fade-in">
      <h2>{forWhomTitle}</h2>
      <p>{forWhomText}</p>
    </div>
  </div>
</section>

<section class="vp-trust">
  <div class="container">
    <div class="trust-grid">
      {trustItems.map(t => (
        <div class="trust-item fade-in">
          <span class="trust-num">{t.num}</span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="vp-faq">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">{faqTitle}</h2>
      <p class="section-subtitle">{faqSubtitle}</p>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <div class="faq-item fade-in">
          <button class="faq-question">
            <span>{faq.q}</span>
            <span class="faq-toggle">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">{faq.a}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="vp-related">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Batafsil</span>
        <h2 class="section-title">{relatedTitle}</h2>
      </div>
      <ul class="related-list fade-in">
        {related.map(r => (
          <li><a href={r.href}>{r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<section class="vp-cta">
  <div class="container">
    <div class={`vp-cta-box vp-${accent}`}>
      <h2>{finalCtaTitle}</h2>
      <p>{finalCtaText}</p>
      <a href={ctaHref} class="btn-white" target="_blank">&#9889; {finalCtaLabel}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const isActive = item.classList.contains('active');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('active');
        (i.querySelector('.faq-answer') as HTMLElement).style.maxHeight = '';
      });
      if (!isActive) {
        item.classList.add('active');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });
</script>

<style>
  .vp-hero { padding: 120px 24px 60px; position: relative; overflow: hidden; }
  .vp-hero.vp-purple { background: linear-gradient(180deg, #F0EBFF 0%, #FFFFFF 100%); }
  .vp-hero.vp-gold { background: linear-gradient(180deg, #FFFBEB 0%, #FFFFFF 100%); }
  .vp-hero::before {
    content: ''; position: absolute; top: -150px; right: -150px;
    width: 500px; height: 500px; pointer-events: none;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.08), transparent 70%);
  }
  .vp-hero.vp-gold::before { background: radial-gradient(circle, rgba(255, 174, 0, 0.08), transparent 70%); }

  .vp-breadcrumb {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px;
  }
  .vp-breadcrumb a { color: var(--primary); text-decoration: none; }
  .vp-breadcrumb a:hover { text-decoration: underline; }

  .vp-siblings { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .vp-sibling-pill {
    padding: 7px 16px; border-radius: 50px; border: 1px solid var(--border);
    background: #fff; color: var(--text-muted); font-size: 0.85rem; font-weight: 600;
    text-decoration: none; transition: all 0.2s;
  }
  .vp-sibling-pill:hover { border-color: var(--primary); color: var(--primary); }
  .vp-sibling-pill.active {
    background: var(--gradient); border-color: transparent; color: #fff;
  }

  .vp-hero-inner { max-width: 720px; }
  .vp-eyebrow {
    display: inline-block; font-size: 0.85rem; font-weight: 700; color: var(--primary);
    text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;
  }
  .vp-title { font-size: 2.6rem; font-weight: 900; line-height: 1.15; margin-bottom: 16px; color: var(--text); }
  .vp-quick-answer { font-size: 1.15rem; font-weight: 600; color: var(--text); line-height: 1.6; margin-bottom: 12px; }
  .vp-hero-note { font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 28px; }

  .vp-price-card {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-md); padding: 24px 28px; margin-top: 20px;
  }
  .vp-price-info { display: flex; flex-direction: column; gap: 2px; }
  .vp-price-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; }
  .vp-price-value { font-size: 2rem; font-weight: 900; color: var(--primary); }
  .vp-price-subtext { font-size: 0.85rem; color: var(--text-muted); }

  .vp-forwhom { padding: 40px 24px; }
  .vp-forwhom-box {
    max-width: 800px; margin: 0 auto; background: var(--bg-alt); border-radius: var(--radius);
    padding: 32px 36px; border: 1px solid var(--border);
  }
  .vp-forwhom-box h2 { font-size: 1.3rem; font-weight: 800; color: var(--text); margin-bottom: 10px; }
  .vp-forwhom-box p { font-size: 1rem; color: var(--text-muted); line-height: 1.75; }

  .vp-trust { padding: 40px 24px 56px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .trust-item {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    padding: 24px 20px; text-align: center; box-shadow: var(--shadow-sm);
  }
  .trust-num {
    display: block; font-size: 1.5rem; font-weight: 900;
    background: var(--gradient); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; margin-bottom: 6px;
  }
  .trust-item h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 6px; color: var(--text); }
  .trust-item p { font-size: 0.84rem; color: var(--text-muted); line-height: 1.6; }

  .vp-faq { background: var(--bg-alt); padding: 56px 24px; }
  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-sm);
    overflow: hidden; box-shadow: var(--shadow-sm); transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item.active { border-color: rgba(124, 58, 237, 0.3); box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08); }
  .faq-question {
    width: 100%; padding: 20px 24px; background: none; border: none; color: var(--text);
    font-size: 1rem; font-weight: 600; text-align: left; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 16px; font-family: inherit;
  }
  .faq-question:hover { color: var(--primary); }
  .faq-toggle {
    width: 28px; height: 28px; min-width: 28px; border-radius: 8px;
    background: rgba(124, 58, 237, 0.06); display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; color: var(--primary); transition: transform 0.3s;
  }
  .faq-item.active .faq-toggle { transform: rotate(45deg); }
  .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .faq-answer-inner { padding: 0 24px 20px; color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; }

  .vp-related { padding: 56px 24px; }
  .related-list {
    list-style: none; padding: 0; margin: 0 auto; max-width: 720px;
    display: flex; flex-direction: column; gap: 0;
  }
  .related-list li { border-bottom: 1px solid var(--border-light); padding: 10px 0; }
  .related-list a {
    color: var(--text); text-decoration: none; font-size: 0.94rem; font-weight: 500;
    display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s;
  }
  .related-list a::before { content: '→'; color: var(--primary); font-weight: 700; }
  .related-list a:hover { color: var(--primary); }

  .vp-cta { padding: 20px 24px 60px; }
  .vp-cta-box { border-radius: 24px; padding: 52px 40px; text-align: center; color: #fff; background: var(--gradient); }
  .vp-cta-box.vp-gold { background: linear-gradient(135deg, #FFAE00, #FF7A00); }
  .vp-cta-box h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 10px; }
  .vp-cta-box p { font-size: 1.05rem; opacity: 0.92; margin-bottom: 24px; }
  .btn-white {
    display: inline-flex; align-items: center; gap: 8px; padding: 15px 32px;
    background: #fff; color: #5B21B6; border-radius: 50px; font-size: 1rem;
    font-weight: 700; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2); }
  .vp-cta-box.vp-gold .btn-white { color: #B45309; }

  @media (max-width: 640px) {
    .vp-hero { padding: 100px 16px 40px; }
    .vp-title { font-size: 1.7rem; }
    .vp-quick-answer { font-size: 1rem; }
    .vp-price-card { flex-direction: column; align-items: stretch; text-align: center; padding: 20px; }
    .vp-price-cta { width: 100%; justify-content: center; }
    .vp-forwhom-box { padding: 24px 20px; }
    .trust-grid { grid-template-columns: 1fr; gap: 12px; }
    .vp-cta-box { padding: 36px 20px; }
    .vp-cta-box h2 { font-size: 1.35rem; }
  }
</style>
